                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
                                                基于数据库物理完整性、WAL 增长速率、往返时延及运行时环境多维加权计算
                                            </MudText>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column gap-1 flex-grow-1" style="max-width: 580px; min-width: 280px;">
                                        @foreach (var rec in _healthDto.HealthRecommendations.Take(3))
                                        {
                                            <div class="d-flex align-center gap-1" style="font-size: 0.8rem; line-height: 1.4;">
                                                <span style="color: var(--mud-palette-text-secondary);">@rec</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 4 维指标栅格 -->
                            <MudGrid Spacing="3" Class="mb-4">
                                <MudItem xs="12" sm="6" md="3">
                                    <div class="pa-4 rounded glass-card h-100 d-flex flex-column justify-space-between" style="background: rgba(59, 130, 246, 0.08); border-left: 4px solid #3b82f6;">
                                        <div>
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <span class="mud-text-secondary" style="font-size: 0.8rem;">物理存储与 WAL</span>
                                                <MudChip T="string" Color="@(_healthDto.IsDatabaseHealthy ? Color.Success : Color.Error)" Size="Size.Small" Variant="Variant.Filled">
                                                    @(_healthDto.IsDatabaseHealthy ? "完整性 OK" : "完整性异常")
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.h5" Class="font-weight-bold">
                                                @_healthDto.DatabaseSizeFormatted
                                            </MudText>
                                            <div class="d-flex align-center justify-space-between mt-1" style="font-size: 0.78rem; color: #64748b;">
                                                <span>WAL 日志: <strong style="color: #3b82f6;">@_healthDto.WalSizeFormatted</strong></span>
                                                <span>碎片率: <strong style="color: @(_healthDto.FragmentationRatio > 30.0 ? "#ef4444" : (_healthDto.FragmentationRatio > 15.0 ? "#f59e0b" : "#10b981"));">@($"{_healthDto.FragmentationRatio:F1}%")</strong></span>
                                            </div>
                                            <div class="d-flex align-center justify-space-between mt-1" style="font-size: 0.75rem; color: #64748b;">
                                                <span>磁盘可用: <strong style="color: #10b981;">@_healthDto.DiskFreeSpaceFormatted</strong></span>
                                                <span>空闲页: @_healthDto.FreelistCount</span>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-1 border-t border-solid d-flex justify-space-between flex-wrap gap-1" style="border-color: rgba(59, 130, 246, 0.2); font-size: 0.72rem; color: #94a3b8;">
                                            <span>页面完整性: <strong style="color: @(_healthDto.IsDatabaseHealthy ? "#10b981" : "#ef4444");">@_healthDto.SqliteIntegrityStatus</strong></span>
                                            <span>外键约束: <strong style="color: @(_healthDto.IsForeignKeyHealthy ? "#10b981" : "#ef4444");">@_healthDto.ForeignKeyIntegrityStatus</strong></span>
                                        </div>
                                    </div>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="pa-4 rounded glass-card h-100 d-flex flex-column justify-space-between" style="background: rgba(16, 185, 129, 0.08); border-left: 4px solid #10b981;">
                                        <div>
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <span class="mud-text-secondary" style="font-size: 0.8rem;">数据库往返时延</span>
                                                <MudChip T="string" Color="@(_healthDto.DatabaseLatencyMs < 20.0 ? Color.Success : Color.Warning)" Size="Size.Small" Variant="Variant.Filled">
                                                    @(_healthDto.DatabaseLatencyMs < 20.0 ? "极速" : "正常")
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="@(_healthDto.DatabaseLatencyMs < 20.0 ? Color.Success : Color.Warning)">
                                                @($"{_healthDto.DatabaseLatencyMs:F2} ms")
                                            </MudText>
                                            <div class="mud-text-secondary mt-1" style="font-size: 0.78rem;">
                                                底层执行: SELECT 1 瞬时往返
                                            </div>
                                            <div class="mud-text-secondary mt-1" style="font-size: 0.75rem;">
                                                连接状态: <strong style="color: #10b981;">连接就绪 / 正常通信</strong>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-1 border-t border-solid d-flex justify-space-between flex-wrap gap-1" style="border-color: rgba(16, 185, 129, 0.2); font-size: 0.72rem; color: #94a3b8;">
                                            <span>驱动: EF Core / @_healthDto.DatabaseProvider</span>
                                        </div>
                                    </div>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="pa-4 rounded glass-card h-100 d-flex flex-column justify-space-between" style="background: rgba(245, 158, 11, 0.08); border-left: 4px solid #f59e0b;">
                                        <div>
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <span class="mud-text-secondary" style="font-size: 0.8rem;">实体规模总览</span>
                                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                                                    高负载就绪
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.h5" Class="font-weight-bold">
                                                @(_healthDto.TotalQuestions + _healthDto.TotalPracticeRecords) 记录
                                            </MudText>
                                            <div class="d-flex align-center justify-space-between mt-1" style="font-size: 0.78rem; color: #64748b;">
                                                <span>题库: <strong style="color: #f59e0b;">@_healthDto.TotalQuestions</strong></span>
                                                <span>用户: <strong style="color: #f59e0b;">@_healthDto.TotalUsers</strong></span>
                                            </div>
                                            <div class="d-flex align-center justify-space-between mt-1" style="font-size: 0.75rem; color: #64748b;">
                                                <span>练习记录: @_healthDto.TotalPracticeRecords</span>
                                                <span>错题库: @_healthDto.TotalErrorItems</span>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-1 border-t border-solid d-flex justify-space-between flex-wrap gap-1" style="border-color: rgba(245, 158, 11, 0.2); font-size: 0.72rem; color: #94a3b8;">
                                            <span>并发隔离: SemaphoreSlim & 线程安全</span>
                                        </div>
                                    </div>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <div class="pa-4 rounded glass-card h-100 d-flex flex-column justify-space-between" style="background: rgba(139, 92, 246, 0.08); border-left: 4px solid #8b5cf6;">
                                        <div>
                                            <div class="d-flex align-center justify-space-between mb-1">
                                                <span class="mud-text-secondary" style="font-size: 0.8rem;">运行时可靠性评分</span>
                                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">
                                                    @($"{_healthDto.ReliabilityScore:F0}分")
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Secondary">
                                                @($"{_healthDto.ReliabilityScore:F1}%")
                                            </MudText>
                                            <div class="mud-text-secondary mt-1" style="font-size: 0.78rem;">
                                                活跃遥测事件: @_telemetryEvents.Count 条
                                            </div>
                                            <div class="mud-text-secondary mt-1" style="font-size: 0.75rem;">
                                                在线备份快照: @_backupsList.Count 份
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-1 border-t border-solid d-flex justify-space-between flex-wrap gap-1" style="border-color: rgba(139, 92, 246, 0.2); font-size: 0.72rem; color: #94a3b8;">
                                            <span>自适应自愈: 随时可触发</span>
                                        </div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        }
                        else
                        {
                            <div class="pa-8 text-center">
                                <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" Class="mb-2" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">正在初始化底层架构指标与遥测缓冲...</MudText>
                            </div>
                        }

                        <!-- 自适应自愈维护计划与快捷动作 -->
                        <div class="pa-4 rounded-lg glass-card mb-4" style="background: var(--sub-card-bg); border: 1px solid var(--glass-card-border);">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Color="Color.Secondary" />
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">自适应自愈维护决策引擎</MudText>
                                    @if (_adaptiveMaintenancePlan != null)
                                    {
                                        <MudChip T="string"
                                                 Color="@(_adaptiveMaintenancePlan.UrgencyLevel == "Critical" ? Color.Error : (_adaptiveMaintenancePlan.UrgencyLevel == "High" ? Color.Warning : (_adaptiveMaintenancePlan.UrgencyLevel == "Medium" ? Color.Info : Color.Success)))"
                                                 Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                                            紧急度: @_adaptiveMaintenancePlan.UrgencyLevel
                                        </MudChip>
                                    }
                                </div>
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Assessment" OnClick="EvaluateAdaptiveMaintenanceAsync" Disabled="@_evaluatingMaintenance">
                                        @(_evaluatingMaintenance ? "评估中..." : "重新评估计划")
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Bolt" OnClick="ExecuteAdaptiveMaintenanceAsync" Disabled="@_executingMaintenance" Class="font-weight-bold">
                                        @(_executingMaintenance ? "执行中..." : "⚡ 执行自适应自愈")
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Backup" OnClick="CreateDatabaseBackupAsync" Disabled="@_isBackingUp">
                                        @(_isBackingUp ? "快照创建中..." : "💾 创建热备份快照")
                                    </MudButton>
                                </div>
                            </div>

                            @if (_adaptiveMaintenancePlan != null && _adaptiveMaintenancePlan.ActionReasons.Any())
                            {
                                <div class="d-flex flex-column gap-1 mb-2">
                                    @foreach (var reason in _adaptiveMaintenancePlan.ActionReasons)
                                    {
                                        <div class="d-flex align-center gap-1 mud-text-secondary" style="font-size: 0.82rem;">
                                            <span>• @reason</span>
                                        </div>
                                    }
                                </div>
                            }

                            @if (_adaptiveExecutionResult != null)
                            {
                                <MudAlert Severity="@(_adaptiveExecutionResult.Success ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" Class="mt-3 rounded-lg">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-center justify-space-between flex-wrap">
                                            <span class="font-weight-bold">
                                                @(_adaptiveExecutionResult.Success ? "✅ 自适应自愈重整执行成功" : "❌ 自适应重整执行中断")
                                            </span>
                                            <span style="font-size: 0.75rem; opacity: 0.9;">耗时: @_adaptiveExecutionResult.ElapsedMilliseconds ms</span>
                                        </div>
                                        <span style="font-size: 0.82rem;">@_adaptiveExecutionResult.Message</span>
                                        @if (_adaptiveExecutionResult.ExecutedActions.Any())
                                        {
                                            <div class="d-flex align-center gap-1 flex-wrap mt-1">
                                                @foreach (var act in _adaptiveExecutionResult.ExecutedActions)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Style="font-size: 0.7rem; height: 18px;">@act</MudChip>
                                                }
                                            </div>
                                        }
                                    </div>
                                </MudAlert>
                            }
                        </div>

                        <!-- 数据拓扑与孤儿记录体检自愈中心 (Data Integrity & Orphan Self-Healing) -->
                        <div class="pa-4 rounded-lg glass-card mb-4" style="background: var(--sub-card-bg); border: 1px solid var(--glass-card-border);">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Success" />
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">数据拓扑完整性体检与领域自愈驾驶舱</MudText>
                                    @if (_dataIntegrityAudit != null)
                                    {
                                        <MudChip T="string"
                                                 Color="@(_dataIntegrityAudit.IsStrictlyHealthy ? Color.Success : (_dataIntegrityAudit.IsHealthy ? Color.Info : Color.Warning))"
                                                 Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                                            @(_dataIntegrityAudit.IsStrictlyHealthy ? "系统纯净 (0 异常)" : (_dataIntegrityAudit.IsHealthy ? $"拓扑合规 (待优化 {_dataIntegrityAudit.TotalComprehensiveAnomaliesCount} 项)" : $"发现 {_dataIntegrityAudit.TotalIssuesCount} 项孤儿异常"))
                                        </MudChip>
                                    }
                                </div>
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.RocketLaunch" OnClick="HealAllInvariantsAsync" Disabled="@_isHealingAllInvariants" Class="font-weight-bold" Style="background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white;">
                                        @(_isHealingAllInvariants ? "全量编排自愈中..." : "🚀 一键全库编排自愈")
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="RunDataIntegrityAuditAsync" Disabled="@_isAuditingIntegrity">
                                        @(_isAuditingIntegrity ? "全库审计中..." : "🔍 审计数据拓扑")
                                    </MudButton>
                                    @if (_dataIntegrityAudit != null && !_dataIntegrityAudit.IsHealthy)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="PurgeOrphanRecordsAsync" Disabled="@_isPurgingOrphans" Class="font-weight-bold">
                                            @(_isPurgingOrphans ? "自愈清理中..." : "🧹 彻底自愈清理孤儿记录")
                                        </MudButton>
                                    }
                                </div>
                            </div>

                            <!-- 模块化自愈驾驶舱: 题库核心资产、学员进阶闭环、体系规范日志 -->
                            <MudGrid Spacing="2" Class="mb-3">
                                <!-- 1. 核心数据与题库资产 -->
                                <MudItem xs="12" md="4">
                                    <div class="pa-3 rounded-lg h-100" style="background: rgba(var(--mud-palette-surface-rgb), 0.45); border: 1px solid rgba(59, 130, 246, 0.2);">
                                        <div class="d-flex align-center gap-1 mb-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Primary" />
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">核心题库与数据拓扑</MudText>
                                        </div>
                                        <div class="d-flex flex-column gap-2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="DeduplicateQuestionsAsync" Disabled="@_isDeduplicatingQuestions" Class="font-weight-bold justify-start">
                                                @(_isDeduplicatingQuestions ? "去重自愈中..." : "🔄 题库去重与重定向")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.BuildCircle" OnClick="HealCorruptedQuestionsAsync" Disabled="@_isHealingCorruptedQuestions" Class="font-weight-bold justify-start">
                                                @(_isHealingCorruptedQuestions ? "自愈中..." : "🩺 试题选项与破损自愈")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="HealErrorBookInvariantsAsync" Disabled="@_isHealingErrorBook" Class="font-weight-bold justify-start">
                                                @(_isHealingErrorBook ? "自愈中..." : "🩺 错题副本不变量自愈")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.BookmarkRemove" OnClick="HealUserFavoriteInvariantsAsync" Disabled="@_isHealingFavorites" Class="font-weight-bold justify-start">
                                                @(_isHealingFavorites ? "自愈中..." : "⭐ 收藏冗余副本去重")
                                            </MudButton>
                                        </div>
                                    </div>
                                </MudItem>

                                <!-- 2. 学员成长与教学闭环 -->
                                <MudItem xs="12" md="4">
                                    <div class="pa-3 rounded-lg h-100" style="background: rgba(var(--mud-palette-surface-rgb), 0.45); border: 1px solid rgba(16, 185, 129, 0.2);">
                                        <div class="d-flex align-center gap-1 mb-2">
                                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Color="Color.Success" />
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Success">学员进阶与教学闭环</MudText>
                                        </div>
                                        <div class="d-flex flex-column gap-2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.Balance" OnClick="HealGamificationInvariantsAsync" Disabled="@_isHealingBalances" Class="font-weight-bold justify-start">
                                                @(_isHealingBalances ? "校准中..." : "⚖️ 校准资产与等级不变量")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.AssignmentTurnedIn" OnClick="HealStudyPlanInvariantsAsync" Disabled="@_isHealingStudyPlans" Class="font-weight-bold justify-start">
                                                @(_isHealingStudyPlans ? "自愈中..." : "🎯 学习计划总体不变量")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.FormatListNumbered" OnClick="HealStudyPlanTaskInvariantsAsync" Disabled="@_isHealingStudyPlanTasks" Class="font-weight-bold justify-start">
                                                @(_isHealingStudyPlanTasks ? "自愈中..." : "📋 学习计划子任务对齐")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.TaskAlt" OnClick="HealHomeworkAssignmentInvariantsAsync" Disabled="@_isHealingHomeworkAssignments" Class="font-weight-bold justify-start">
                                                @(_isHealingHomeworkAssignments ? "自愈中..." : "📝 作业分配闭环不变量")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.FamilyRestroom" OnClick="HealStudentParentBindingInvariantsAsync" Disabled="@_isHealingBindings" Class="font-weight-bold justify-start">
                                                @(_isHealingBindings ? "自愈中..." : "👨‍👩‍👧 家校监护绑定自愈")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.Insights" OnClick="HealClosedLoopInsightsAsync" Disabled="@_isHealingInsights" Class="font-weight-bold justify-start">
                                                @(_isHealingInsights ? "自愈中..." : "🧬 学情闭环演进洞察")
                                            </MudButton>
                                        </div>
                                    </div>
                                </MudItem>

                                <!-- 3. 体系规范与系统日志 -->
                                <MudItem xs="12" md="4">
                                    <div class="pa-3 rounded-lg h-100" style="background: rgba(var(--mud-palette-surface-rgb), 0.45); border: 1px solid rgba(245, 158, 11, 0.2);">
                                        <div class="d-flex align-center gap-1 mb-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Small" Color="Color.Warning" />
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Warning">体系规范与系统日志</MudText>
                                        </div>
                                        <div class="d-flex flex-column gap-2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="HealCurriculumSubjectConfigsAsync" Disabled="@_isHealingCurriculumConfigs" Class="font-weight-bold justify-start">
                                                @(_isHealingCurriculumConfigs ? "自愈中..." : "📚 课程学科考点配置")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.WorkspacePremium" OnClick="HealAchievementsAsync" Disabled="@_isHealingAchievements" Class="font-weight-bold justify-start">
                                                @(_isHealingAchievements ? "自愈中..." : "🎖️ 成就基础定义自愈")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.MilitaryTech" OnClick="HealUserAchievementsAsync" Disabled="@_isHealingUserAchievements" Class="font-weight-bold justify-start">
                                                @(_isHealingUserAchievements ? "自愈中..." : "🏆 用户成就副本去重")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.Schedule" OnClick="HealUserAchievementStateInvariantsAsync" Disabled="@_isHealingUserAchievementStates" Class="font-weight-bold justify-start">
                                                @(_isHealingUserAchievementStates ? "自愈中..." : "⏱️ 成就解锁时序纠偏")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.HistoryEdu" OnClick="HealPracticeRecordsAsync" Disabled="@_isHealingPracticeRecords" Class="font-weight-bold justify-start">
                                                @(_isHealingPracticeRecords ? "自愈中..." : "🩺 答题流水记录自愈")
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.Psychology" OnClick="HealLlmLogsAsync" Disabled="@_isHealingLlmLogs" Class="font-weight-bold justify-start">
                                                @(_isHealingLlmLogs ? "自愈中..." : "🧠 推理日志不变量自愈")
                                            </MudButton>
                                        </div>
                                    </div>
                                </MudItem>
                            </MudGrid>

