@page "/settings"
@using Northtropic.Models
@using Northtropic.Services
@inject IGamificationService GamificationService
@inject IUserSessionService UserSessionService
@inject IAiTutorService AiTutorService
@inject IQuestionImportService QuestionImportService
@inject ICurriculumConfigService CurriculumConfigService
@inject ISystemHealthService SystemHealthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>系统配置 - Northtropic</PageTitle>

<style>
    .settings-nav-item {
        border-radius: 12px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
    }
    .settings-nav-inactive {
        background: transparent;
        border: 1px solid transparent;
        opacity: 0.82;
    }
    .settings-nav-inactive:hover {
        background: rgba(255, 255, 255, 0.05);
        opacity: 1;
        transform: translateX(4px);
    }
    .settings-nav-active {
        background: rgba(59, 130, 246, 0.12) !important;
        border: 1px solid var(--mud-palette-primary) !important;
        opacity: 1;
        box-shadow: 0 4px 16px rgba(59, 130, 246, 0.15);
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 mb-10">
    <div class="glass-card pa-5 mb-5 rounded-xl">
        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
            <div class="d-flex align-center gap-3">
                <div class="d-inline-flex align-center justify-center pa-3 rounded-circle" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2)); border: 1px solid var(--glass-card-border);">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" Size="Size.Large" />
                </div>
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold gradient-text">系统全局配置与治理</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        集中管控全学段课程考点、大语言模型 API、OCR 图像试题识别、交互沉浸感及短信安全服务。
                    </MudText>
                </div>
            </div>
            @if (_currentUser?.CanAccessSystemConfig == true)
            {
                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Class="font-weight-bold shadow-md" Style="border-radius: 10px;">
                        保存所有配置
                    </MudButton>
                </div>
            }
        </div>
    </div>

    @if (_currentUser == null)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!_currentUser.CanAccessSystemConfig)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pa-6 rounded-lg glass-card my-6">
            <div class="d-flex flex-column align-center text-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h5" Class="font-weight-bold">权限不足：当前角色无【系统配置】权限</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary">
                    当前登录账号：<strong>@_currentUser.Username</strong> (角色身份: <strong>@_currentUser.RoleDisplayName</strong>)
                    <br />根据系统角色权限规范，家长/老师与学生无系统配置权限，仅允许超级管理员进行系统参数与 LLM 密钥调整。
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Logout" OnClick="LogoutAndReloginAsync">
                    安全退出当前账号，以管理员身份重新登录
                </MudButton>
            </div>
        </MudAlert>
    }
    else
    {
        <!-- 移动端横向滑动项目选择条 (屏幕较窄时优雅折叠适配) -->
        <div class="d-md-none mb-4 overflow-x-auto pb-1">
            <div class="d-flex gap-2 flex-nowrap">
                @foreach (var item in _settingNavItems)
                {
                    var isSelected = _activeSection == item.Id;
                    <MudChip T="string"
                             Color="@(isSelected ? Color.Primary : Color.Default)"
                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                             Size="Size.Medium"
                             OnClick="() => SetActiveSection(item.Id)"
                             Class="font-weight-bold cursor-pointer text-nowrap">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" Class="mr-1" />
                        @item.Title
                    </MudChip>
                }
            </div>
        </div>

        <MudGrid Spacing="4">
            <!-- 左侧：项目导航菜单 -->
            <MudItem xs="12" md="4" lg="3">
                <div class="d-flex flex-column gap-3" style="position: sticky; top: 80px;">
                    <div class="glass-card pa-3 rounded-xl shadow-lg" style="border: 1px solid var(--glass-card-border);">
                        <div class="d-flex align-center justify-space-between px-3 py-2 mb-2" style="border-bottom: 1px solid var(--glass-card-border);">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold d-flex align-center gap-2" Style="letter-spacing: 0.5px;">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Color="Color.Primary" />
                                <span>配置项目</span>
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Style="height: 20px; font-size: 0.7rem; font-weight: 700;">
                                6 个大类
                            </MudChip>
                        </div>

                        <div class="d-flex flex-column gap-1">
                            @foreach (var item in _settingNavItems)
                            {
                                var isSelected = _activeSection == item.Id;
                                <div class="@($"settings-nav-item pa-3 cursor-pointer transition-all d-flex align-center justify-space-between {(isSelected ? "settings-nav-active" : "settings-nav-inactive")}")"
                                     style="@(isSelected ? "border-left: 4px solid var(--mud-palette-primary); padding-left: 10px !important;" : "border-left: 4px solid transparent;")"
                                     @onclick="() => SetActiveSection(item.Id)">
                                    <div class="d-flex align-center gap-3" style="min-width: 0;">
                                        <MudIcon Icon="@item.Icon" Color="@(isSelected ? Color.Primary : Color.Default)" Size="Size.Medium" />
                                        <div style="min-width: 0;">
                                            <div class="font-weight-bold text-truncate" style="font-size: 0.92rem; color: @(isSelected ? "var(--mud-palette-primary)" : "var(--glass-text-primary)");">
                                                @item.Title
                                            </div>
                                            <div class="text-muted text-truncate" style="font-size: 0.75rem;">
                                                @GetNavSubtitle(item.Id)
                                            </div>
                                        </div>
                                    </div>
                                    @if (isSelected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Color="Color.Primary" Style="font-size: 0.8rem;" />
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 左侧快捷保存卡片 (桌面端常驻可见) -->
                    <div class="glass-card pa-4 rounded-xl shadow-lg d-none d-md-block" style="border: 1px solid var(--glass-card-border); background: var(--sub-card-bg);">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Class="font-weight-bold py-3 mb-2" Style="border-radius: 12px;">
                            保存所有配置
                        </MudButton>
                        <div class="text-center text-muted" style="font-size: 0.75rem;">
                            修改任意配置后点击即可生效
                        </div>
                    </div>
                </div>
            </MudItem>

            <!-- 右侧：配置内容详情 -->
            <MudItem xs="12" md="8" lg="9">
                @if (_activeSection == "grade")
                {
                    <!-- 1. 年级与学段设置 -->
                    <div class="glass-card pa-6 mb-4">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                            <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" /> 1. 学生年级与学段设置
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Class="font-weight-bold">
                                保存修改
                            </MudButton>
                        </div>

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="学生所在年级" @bind-Value="_currentUser.Grade" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                    @foreach (var grade in GradeSubjectProvider.AvailableGrades)
                                    {
                                        <MudSelectItem Value="@grade">@grade</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" Label="昵称 / 学霸代号" @bind-Value="_currentUser.Username" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                    </div>
                }
                else if (_activeSection == "curriculum")
                {
                    <!-- 2. 全学段科目与专题考点配置管理 -->
                    <div class="glass-card pa-6 mb-4">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                            <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Primary" /> 2. 全学段科目与主要专题考点配置管理
                            </MudText>
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetDefaultCurriculumAsync">
                                    恢复全学段官方标准科目与专题
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Class="font-weight-bold">
                                    保存修改
                                </MudButton>
                            </div>
                        </div>

                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                            系统已内置小学、初中、高中、大学全部学科与标准主要考点专题。您可自由切换年级增删科目、精细化调整各学科的专题知识点，修改后刷题、出题与学情图谱将实时生效。
                        </MudText>

                        <!-- 年级切换与添加科目栏 -->
                        <div class="d-flex align-center gap-4 mb-4 flex-wrap">
                            <div style="min-width: 260px;">
                                <MudSelect T="string" Label="选择要配置的年级/学段" Value="_selectedConfigGrade" ValueChanged="OnConfigGradeChanged" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                    @foreach (var g in GradeSubjectProvider.AvailableGrades)
                                    {
                                        <MudSelectItem Value="@g">@g</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <div class="d-flex align-center gap-2 flex-grow-1" style="max-width: 480px;">
                                <MudTextField T="string" @bind-Value="_newSubjectName" Placeholder="输入新科目名称 (如: 信息技术/编程)..." Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewSubjectAsync" Class="font-weight-bold text-nowrap">
                                    添加科目
                                </MudButton>
                            </div>
                        </div>

                        <!-- 当前年级的学科列表 Chips -->
                        <div class="pa-4 rounded-lg mb-4 glass-card" style="background: var(--sub-card-bg);">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2 text-primary">
                                📌 【@_selectedConfigGrade】包含的学科（点击切换选中以编辑右下侧考点专题）：
                            </MudText>
                            <div class="d-flex flex-wrap gap-2 align-center">
                                @if (_gradeConfigs == null || !_gradeConfigs.Any())
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">该年级暂无科目，请在上方添加或点击右上角重置</MudText>
                                }
                                else
                                {
                                    @foreach (var cfg in _gradeConfigs)
                                    {
                                        var isSelected = _selectedConfig?.Id == cfg.Id;
                                        <MudChip T="string"
                                                 Color="@(isSelected ? Color.Primary : Color.Default)"
                                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                                 Size="Size.Medium"
                                                 OnClick="() => SelectSubjectForEdit(cfg)"
                                                 Class="font-weight-bold cursor-pointer">
                                            @cfg.Subject
                                            <span class="ml-1 opacity-75" style="font-size: 0.75rem;">(@(GetTopicCount(cfg.TopicsJson))个专题)</span>
                                        </MudChip>
                                    }
                                }
                            </div>
                        </div>

                        <!-- 选中学科的专题考点管理面板 -->
                        @if (_selectedConfig != null)
                        {
                            <div class="pa-4 rounded-lg border border-primary border-solid glass-card" style="background: var(--card-bg);">
                                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                                            【@_selectedConfig.Grade - @_selectedConfig.Subject】专题与考点清单
                                        </MudText>
                                    </div>
                                    <div class="d-flex align-center gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveCurrentSubjectTopicsAsync" Disabled="@_isSavingCurriculum">
                                            @if (_isSavingCurriculum)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                                <span>保存中...</span>
                                            }
                                            else
                                            {
                                                <span>💾 保存专题修改</span>
                                            }
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteSubjectAsync(_selectedConfig)">
                                            删除本科目
                                        </MudButton>
                                    </div>
                                </div>

                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                                    当前科目包含 <strong>@_selectedTopicsList.Count</strong> 个知识专题考点。在输入框中填入新考点后回车或点击“新增”即可添加。
                                </MudText>

                                <!-- 新增专题 -->
                                <div class="d-flex align-center gap-2 mb-3" style="max-width: 500px;">
                                    <MudTextField T="string" @bind-Value="_newTopicName" Placeholder="输入考点专题名称 (如: 函数与导数综合)..." Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="HandleTopicKeyDown" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddTopicToCurrentSubject" Class="font-weight-bold text-nowrap">
                                        新增专题
                                    </MudButton>
                                </div>

                                <!-- 专题 Chips 列表 -->
                                <div class="d-flex flex-wrap gap-2 pa-3 rounded glass-card" style="background: var(--sub-card-bg); max-height: 280px; overflow-y: auto;">
                                    @if (!_selectedTopicsList.Any())
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">暂无专题考点，请在上方输入添加</MudText>
                                    }
                                    @foreach (var t in _selectedTopicsList)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClose="() => RemoveTopic(t)">
                                            @t
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                                    💡 提示：点击专题右侧的 ❌ 即可删除该专题。编辑完成后请点击右上角 **“💾 保存专题修改”** 即时同步全站。
                                </MudText>
                            </div>
                        }
                    </div>
                }
                else if (_activeSection == "interaction")
                {
                    <!-- 3. 交互体验与音效设置 -->
                    <div class="glass-card pa-6 mb-4">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                            <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" /> 3. 交互体验与沉浸感偏好
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Class="font-weight-bold">
                                保存修改
                            </MudButton>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-center justify-space-between pa-3 rounded glass-card" style="background: var(--sub-card-bg);">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">🔊 做题答题音效与连击播报</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">答对、升级、高连击爆发时的正向声学反馈</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_currentUser.SoundEffectsEnabled" Color="Color.Primary" />
                            </div>

                            <div class="d-flex align-center justify-space-between pa-3 rounded glass-card" style="background: var(--sub-card-bg);">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">🎉 庆祝礼花与粒子特效 (Confetti)</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">答对题目与满分交卷时触发全屏礼花特效</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_currentUser.ConfettiEnabled" Color="Color.Primary" />
                            </div>

                            <div class="d-flex align-center justify-space-between pa-3 rounded glass-card" style="background: var(--sub-card-bg);">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">🗣️ AI 导师语音朗读支持 (Web Speech)</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">支持题目朗读与 AI 导师逐句语音启发</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_currentUser.AutoVoiceGuidance" Color="Color.Primary" />
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSection == "llm")
                {
                    <!-- 4. LLM API 参数配置 -->
                    <div class="glass-card pa-6 mb-4">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                            <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Primary" /> 4. LLM 大语言模型配置 (已内置 Gemini)
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveLlmSettingsAsync" Disabled="@_isSavingLlm" Class="font-weight-bold">
                                立即保存大模型配置
                            </MudButton>
                        </div>
                        
                        <div class="pa-3 mb-4 rounded-lg glass-card" style="background: var(--sub-card-bg);">
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">
                                系统已内置 Google Gemini 地址与模型 (gemini-1.5-flash)，只需在下方填入 Gemini API Key 即可使用！
                            </MudText>
                        </div>

                        <!-- 快捷预设按钮组 -->
                        <div class="mb-4">
                            <MudText Typo="Typo.caption" Class="mb-2 d-block mud-text-secondary">一键套用常用供应商预设：</MudText>
                            <div class="d-flex flex-wrap gap-2">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FlashOn" OnClick="PresetGemini">
                                    Google Gemini (内置推荐)
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.SmartToy" OnClick="PresetOpenAi">
                                    OpenAI (gpt-4o-mini)
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="PresetZhipu">
                                    智谱 GLM (glm-4-flash)
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Psychology" OnClick="PresetDeepSeek">
                                    DeepSeek (deepseek-chat)
                                </MudButton>
                            </div>
                        </div>

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4 rounded-lg">
                            <strong>💡 全局继承机制已生效（方案 A · 教学团队/全校模式）：</strong> 此处配置的模型与密钥将自动共享继承给所有未配置独立 Key 的学生与教师。普通学员无需单独配 Key 即可直接享受真实大模型出题与智能苏格拉底辅导！
                        </MudAlert>

                        <div class="d-flex flex-column gap-4">
                            <MudTextField T="string" Label="LLM API Key (密钥)" @bind-Value="_currentUser.LlmApiKey" InputType="InputType.Password" Placeholder="AIzaSy... (仅需填写 Key)" Variant="Variant.Outlined" HelperText="密钥安全存储于 PostgreSQL 数据库中" Class="font-weight-bold" />

                            <MudGrid>
                                <MudItem xs="12" sm="7">
                                    <MudTextField T="string" Label="API Base URL (接口基地址)" @bind-Value="_currentUser.LlmBaseUrl" Placeholder="https://generativelanguage.googleapis.com/v1beta/openai/" Variant="Variant.Outlined" HelperText="Gemini 默认: https://generativelanguage.googleapis.com/v1beta/openai/" />
                                </MudItem>
                                <MudItem xs="12" sm="5">
                                    <MudTextField T="string" Label="Model Name (模型名称)" @bind-Value="_currentUser.LlmModelName" Placeholder="gemini-1.5-flash" Variant="Variant.Outlined" HelperText="Gemini 默认: gemini-1.5-flash" />
                                </MudItem>
                            </MudGrid>

                            <div class="d-flex align-center justify-space-between flex-wrap gap-2 pt-2">
