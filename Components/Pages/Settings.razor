    private Color GetLatencyColor(double latencyMs)
    {
        if (latencyMs < 0) return Color.Default;
        if (latencyMs <= 10) return Color.Success;
        if (latencyMs <= 50) return Color.Warning;
        return Color.Error;
    }

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await GamificationService.GetCurrentUserAsync();
        if (_currentUser != null)
        {
            if (string.IsNullOrWhiteSpace(_currentUser.LlmBaseUrl))
            {
                _currentUser.LlmBaseUrl = "https://generativelanguage.googleapis.com/v1beta/openai/";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.LlmModelName))
            {
                _currentUser.LlmModelName = "gemini-1.5-flash";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.OcrProvider))
            {
                _currentUser.OcrProvider = "PaddleOcr";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.BaiduOcrEndpoint))
            {
                _currentUser.BaiduOcrEndpoint = "https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic";
            }

            if (!string.IsNullOrWhiteSpace(_currentUser.Grade))
            {
                _selectedConfigGrade = _currentUser.Grade;
            }
        }

        await CurriculumConfigService.EnsureInitializedAsync();
        await LoadCurriculumForGradeAsync(_selectedConfigGrade);

        if (_currentUser?.Role == UserRole.SuperAdmin)
        {
            try
            {
                _healthDto = await SystemHealthService.GetSystemHealthAsync();
                await LoadBackupsAndTelemetryAsync();
            }
            catch
            {
                // 非阻断
            }
        }
    }

