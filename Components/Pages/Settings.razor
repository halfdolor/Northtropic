                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudNumericField T="int" Label="系统无操作超时自动退出 (分钟)" @bind-Value="_currentUser.SessionTimeoutMinutes" Min="5" Max="1440" Variant="Variant.Outlined"
                                                 HelperText="默认 30 分钟无响应自动注销登录" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Timer" />
                            </MudItem>
                        </MudGrid>

                        <!-- 阿里云短信连通性即时测试面板 -->
                        <div class="pa-4 rounded glass-card" style="background: var(--sub-card-bg); border-left: 4px solid #3b82f6;">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">
                                        🧪 阿里云短信 API 发送即时测试
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        填入接收手机号，直接向阿里云 Dysmsapi 发起真实验证码发送测试并返回耗时与回执
                                    </MudText>
                                </div>

                                <div class="d-flex align-center gap-2">
                                    <MudTextField T="string" @bind-Value="_testSmsPhone" Placeholder="输入接收手机号..." Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 170px;" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Send" OnClick="TestAliyunSmsAsync" Disabled="@_testingSms">
                                        @if (_testingSms)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                            <span>请求阿里云中...</span>
                                        }
                                        else
                                        {
                                            <span>🚀 发送测试短信</span>
                                        }
                                    </MudButton>
                                </div>
                            </div>

                            @if (_smsTestResult != null)
                            {
                                <MudAlert Severity="@(_smsTestResult.IsSuccess ? Severity.Success : Severity.Error)" Variant="Variant.Filled" Class="mt-3 rounded-lg">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@(_smsTestResult.IsSuccess ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                                @(_smsTestResult.IsSuccess ? $"✅ 阿里云短信通信正常 (响应耗时: {_smsTestResult.LatencyMs}ms)" : "❌ 阿里云短信发送失败")
                                            </MudText>
                                            <MudText Typo="Typo.caption">
                                                @_smsTestResult.Message @(_smsTestResult.SampleResponse != null ? $" | 网关原样回执: {_smsTestResult.SampleResponse}" : "")
                                            </MudText>
                                        </div>
                                    </div>
                                </MudAlert>
                            }
                        </div>
                    </div>
                }

                <!-- 右侧底部保存栏 -->
                <div class="glass-card pa-4 rounded-xl d-flex align-center justify-space-between flex-wrap gap-3 mt-4" style="border: 1px solid var(--glass-card-border);">
                    <div class="d-flex align-center gap-2 text-muted" style="font-size: 0.85rem;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Small" Color="Color.Success" />
                        <span>当前处于【@GetCurrentSectionTitle()】配置面板，修改后将即时同步至全局。</span>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Class="px-6 font-weight-bold" Style="border-radius: 10px;">
                            保存所有配置
                        </MudButton>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
#pragma warning disable CS0414, CS0169
    [SupplyParameterFromQuery(Name = "section")]
    public string? QuerySection { get; set; }

    private string _activeSection = "grade";

    private record SettingNavItem(string Id, string Title, string Icon);

    private readonly List<SettingNavItem> _settingNavItems = new()
    {
        new("grade", "学生学段与年级", Icons.Material.Filled.School),
        new("curriculum", "学科与考点管理", Icons.Material.Filled.LibraryBooks),
        new("interaction", "交互体验与音效", Icons.Material.Filled.Tune),
        new("llm", "LLM 大语言模型", Icons.Material.Filled.Psychology),
        new("ocr", "OCR 试题识别设置", Icons.Material.Filled.AddAPhoto),
        new("sms", "短信服务与安全", Icons.Material.Filled.Sms)
    };

    private void SetActiveSection(string sectionId)
    {
        _activeSection = sectionId;
    }

    private string GetCurrentSectionTitle()
    {
        return _settingNavItems.FirstOrDefault(x => x.Id == _activeSection)?.Title ?? "系统配置";
    }

    private string GetNavSubtitle(string id)
    {
        return id switch
        {
            "grade" => !string.IsNullOrEmpty(_currentUser?.Grade) ? _currentUser.Grade : "年级与代号",
            "curriculum" => "全学段科目与考点专题",
            "interaction" => _currentUser?.SoundEffectsEnabled == true ? "音效已开启" : "音效已关闭",
            "llm" => !string.IsNullOrEmpty(_currentUser?.LlmModelName) ? _currentUser.LlmModelName : "gemini-1.5-flash",
            "ocr" => string.Equals(_currentUser?.OcrProvider, "PaddleOcr", StringComparison.OrdinalIgnoreCase) ? "本地 PaddleOCR (0 Token)" : (string.Equals(_currentUser?.OcrProvider, "BaiduOcr", StringComparison.OrdinalIgnoreCase) ? "百度云 OCR" : "多模态视觉"),
            "sms" => !string.IsNullOrEmpty(_currentUser?.AliyunSmsSignName) ? _currentUser.AliyunSmsSignName : "短信验证码与超时",
            _ => ""
        };
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(QuerySection) && _settingNavItems.Any(x => x.Id.Equals(QuerySection, StringComparison.OrdinalIgnoreCase)))
        {
            _activeSection = QuerySection.ToLowerInvariant();
        }
    }

    private User? _currentUser;
    private bool _testingConnection = false;
    private TestConnectionResult? _testResult;

    private bool _testingBaiduOcr = false;
    private TestConnectionResult? _baiduTestResult;

    private bool _testingPaddleOcr = false;
    private TestConnectionResult? _paddleTestResult;

    // 学科与专题配置管理状态
    private string _selectedConfigGrade = "初中二年级";
    private List<CurriculumSubjectConfig> _gradeConfigs = new();
    private CurriculumSubjectConfig? _selectedConfig;
    private List<string> _selectedTopicsList = new();
    private string _newTopicName = string.Empty;
    private string _newSubjectName = string.Empty;
    private bool _isSavingCurriculum = false;

    // 系统架构自检状态
    private SystemHealthDto? _healthDto;
    private bool _isRunningDiagnostics = false;
    private bool _isCheckingIntegrity = false;
    private bool _isCheckingForeignKey = false;
    private bool _isVacuuming = false;
    private bool _isOptimizing = false;
    private bool _isHealingAll = false;
    private bool _isBackingUp = false;
    private bool _isPruningBackups = false;
    private bool _isExportingReport = false;
    private HashSet<string> _verifyingBackups = new();
    private Dictionary<string, BackupVerificationResultDto> _verifyResults = new();
    private List<DatabaseBackupResultDto> _backupsList = new();
    private List<SystemArchitectureEvent> _telemetryEvents = new();
    private ArchitectureTelemetrySummaryDto _telemetrySummary = new();
    private AdaptiveMaintenancePlanDto? _adaptiveMaintenancePlan;
    private AdaptiveMaintenanceExecutionResultDto? _adaptiveExecutionResult;
    private bool _evaluatingMaintenance = false;
    private bool _executingMaintenance = false;
    private string _selectedTelemetryCategory = "全部";
    private string _selectedTelemetryLevel = "全部";
    private List<TableStorageMetricDto> _tableStorageMetrics = new();
    private Dictionary<string, string> _sha256Cache = new();

    private void FilterTelemetryEvents()
    {
        _telemetryEvents = SystemHealthService.GetRecentArchitectureEvents(_selectedTelemetryCategory, _selectedTelemetryLevel, 30).ToList();
        _telemetrySummary = SystemHealthService.GetArchitectureTelemetrySummary();
    }

    private void SetTelemetryFilter(string? category, string? level)
    {
        if (category != null) _selectedTelemetryCategory = category;
        if (level != null) _selectedTelemetryLevel = level;
        FilterTelemetryEvents();
    }

    private async Task EvaluateAdaptiveMaintenanceAsync()
    {
        _evaluatingMaintenance = true;
        StateHasChanged();
        try
        {
            _adaptiveMaintenancePlan = await SystemHealthService.EvaluateAdaptiveMaintenancePlanAsync();
            Snackbar.Add($"📋 自适应维护评估完成：紧急度【{_adaptiveMaintenancePlan.UrgencyLevel}】", Severity.Info);
        }
