        _isSavingLlm = true;
        StateHasChanged();
        try
        {
            if (string.IsNullOrWhiteSpace(_currentUser.LlmBaseUrl))
            {
                _currentUser.LlmBaseUrl = "https://generativelanguage.googleapis.com/v1beta/openai/";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.LlmModelName))
            {
                _currentUser.LlmModelName = "gemini-1.5-flash";
            }

            var success = await UserSessionService.UpdateUserSettingsAsync(_currentUser);
            if (success)
            {
                Snackbar.Add($"✅ 大模型配置已成功保存！当前模型：{_currentUser.LlmModelName}", Severity.Success);
            }
            else
            {
                Snackbar.Add("❌ 保存失败，当前会话已失效或用户不存在，请重新登录超级管理员账号！", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存异常: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingLlm = false;
            StateHasChanged();
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (_currentUser != null)
        {
            if (string.IsNullOrWhiteSpace(_currentUser.LlmBaseUrl))
            {
                _currentUser.LlmBaseUrl = "https://generativelanguage.googleapis.com/v1beta/openai/";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.LlmModelName))
            {
                _currentUser.LlmModelName = "gemini-1.5-flash";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.AliyunSmsEndpoint))
            {
                _currentUser.AliyunSmsEndpoint = "dysmsapi.aliyuncs.com";
            }
            if (string.IsNullOrWhiteSpace(_currentUser.AliyunSmsTemplateParam))
            {
                _currentUser.AliyunSmsTemplateParam = "code";
            }

            var success = await UserSessionService.UpdateUserSettingsAsync(_currentUser);
            if (success)
            {
                Snackbar.Add("✅ 系统全局配置已成功保存！", Severity.Success);
            }
            else
            {
                Snackbar.Add("❌ 保存失败，当前会话可能已过期，请重新登录！", Severity.Error);
            }
        }
    }

    private async Task OnConfigGradeChanged(string newGrade)
    {
        _selectedConfigGrade = newGrade;
        await LoadCurriculumForGradeAsync(newGrade);
    }

    private async Task LoadCurriculumForGradeAsync(string grade)
    {
        _gradeConfigs = await CurriculumConfigService.GetConfigsByGradeAsync(grade);
        if (_gradeConfigs.Any())
        {
            if (_selectedConfig == null || !_gradeConfigs.Any(c => c.Id == _selectedConfig.Id))
            {
                SelectSubjectForEdit(_gradeConfigs.First());
            }
            else
            {
                var refreshed = _gradeConfigs.FirstOrDefault(c => c.Id == _selectedConfig.Id);
                SelectSubjectForEdit(refreshed ?? _gradeConfigs.First());
            }
        }
        else
        {
            _selectedConfig = null;
            _selectedTopicsList.Clear();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void SelectSubjectForEdit(CurriculumSubjectConfig config)
    {
        _selectedConfig = config;
        try
        {
            _selectedTopicsList = System.Text.Json.JsonSerializer.Deserialize<List<string>>(config.TopicsJson) ?? new List<string>();
        }
        catch
        {
            _selectedTopicsList = new List<string> { "全部" };
        }
        if (!_selectedTopicsList.Contains("全部"))
        {
            _selectedTopicsList.Insert(0, "全部");
        }
    }

    private int GetTopicCount(string topicsJson)
    {
        try
        {
            var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(topicsJson);
            return list?.Count(t => t != "全部") ?? 0;
        }
        catch
        {
            return 0;
        }
    }

    private void AddTopicToCurrentSubject()
    {
        if (string.IsNullOrWhiteSpace(_newTopicName)) return;
        var clean = _newTopicName.Trim();
        if (!_selectedTopicsList.Contains(clean))
        {
            _selectedTopicsList.Add(clean);
            _newTopicName = string.Empty;
            Snackbar.Add($"已添加考点【{clean}】，请点击【💾 保存专题修改】！", Severity.Info);
        }
        else
        {
            Snackbar.Add("该专题考点已存在！", Severity.Warning);
        }
    }

    private void HandleTopicKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTopicToCurrentSubject();
        }
    }

    private void RemoveTopic(string topic)
    {
        if (topic == "全部") return;
        _selectedTopicsList.Remove(topic);
        Snackbar.Add($"已移除专题【{topic}】，请点击【💾 保存专题修改】！", Severity.Info);
    }

    private async Task SaveCurrentSubjectTopicsAsync()
    {
        if (_selectedConfig == null) return;
        _isSavingCurriculum = true;
        try
        {
            var res = await CurriculumConfigService.SaveSubjectTopicsAsync(_selectedConfig.Id, _selectedTopicsList, _currentUser?.Id);
            if (res.Success)
            {
                Snackbar.Add(res.Message, Severity.Success);
                await LoadCurriculumForGradeAsync(_selectedConfigGrade);
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
        finally
        {
            _isSavingCurriculum = false;
        }
    }

    private async Task AddNewSubjectAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSubjectName))
        {
            Snackbar.Add("请输入要添加的学科名称！", Severity.Warning);
            return;
        }

        var res = await CurriculumConfigService.AddSubjectConfigAsync(
            _selectedConfigGrade,
            _newSubjectName.Trim(),
            new List<string> { "全部", "基础概念", "核心考点", "综合提升" },
            _currentUser?.Id
        );

        if (res.Success)
        {
            Snackbar.Add(res.Message, Severity.Success);
            _newSubjectName = string.Empty;
            await LoadCurriculumForGradeAsync(_selectedConfigGrade);
        }
        else
        {
            Snackbar.Add(res.Message, Severity.Warning);
        }
    }

    private async Task DeleteSubjectAsync(CurriculumSubjectConfig config)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "🗑️ 删除学科确认",
            (MarkupString)$"确定要在【{config.Grade}】中永久删除【{config.Subject}】学科及其配置的专题考点吗？",
            yesText: "确认删除", cancelText: "取消");

        if (confirmed == true)
        {
            var res = await CurriculumConfigService.DeleteSubjectConfigAsync(config.Id, _currentUser?.Id);
            if (res.Success)
            {
                Snackbar.Add(res.Message, Severity.Success);
                await LoadCurriculumForGradeAsync(_selectedConfigGrade);
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
    }

    private async Task ResetDefaultCurriculumAsync()
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "⚠️ 恢复官方标准科目与专题确认",
            (MarkupString)"确定要将全学段（小学、初中、高中、大学）的科目及主要考点专题全部重置为系统官方标准题纲体系吗？<br/><span style='color:red;'>注意：此操作将清除所有自定义增加的科目与专题！</span>",
            yesText: "确认重置为官方默认", cancelText: "取消");

        if (confirmed == true)
        {
            var res = await CurriculumConfigService.ResetToDefaultCurriculumAsync(_currentUser?.Id);
            if (res.Success)
            {
                Snackbar.Add(res.Message, Severity.Success);
                await LoadCurriculumForGradeAsync(_selectedConfigGrade);
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
    }
}
