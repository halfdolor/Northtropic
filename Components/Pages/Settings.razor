    private async Task CalculateSha256Async(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;
        try
        {
            var hash = await SystemHealthService.CalculateBackupSha256Async(fileName);
            if (!string.IsNullOrEmpty(hash))
            {
                _sha256Cache[fileName] = hash;
                StateHasChanged();
                Snackbar.Add($"🛡️ SHA-256 完整性哈希已计算: {hash}", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"计算 SHA-256 失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteBackupSnapshotAsync(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;
        bool? confirmed = await DialogService.ShowMessageBox(
            "确认删除备份快照",
            $"确定要物理删除该备份快照文件 [{fileName}] 吗？此操作不可恢复。",
            yesText: "确认删除", cancelText: "取消");

        if (confirmed == true)
        {
            var ok = await SystemHealthService.DeleteBackupAsync(fileName);
            if (ok)
            {
                _sha256Cache.Remove(fileName);
                Snackbar.Add($"🗑️ 备份快照 [{fileName}] 已安全删除。", Severity.Success);
                await LoadBackupsAndTelemetryAsync();
            }
            else
            {
                Snackbar.Add($"删除备份快照 [{fileName}] 失败。", Severity.Error);
            }
        }
    }

    private async Task PruneOldBackupsAsync()
    {
        _isPruningBackups = true;
        StateHasChanged();
        try
        {
            var report = await SystemHealthService.PruneBackupsAsync(keepCount: 7, maxAgeDays: 30);
            if (report.PrunedCount > 0)
            {
                double mb = report.ReclaimedBytes / 1024.0 / 1024.0;
                Snackbar.Add($"🧹 成功淘汰 {report.PrunedCount} 个历史快照，回收物理磁盘存储 {mb:F2} MB！", Severity.Success);
            }
            else
            {
                Snackbar.Add("🧹 历史快照均在保留策略窗口内（保留最新7份），无需清理。", Severity.Info);
            }
            await LoadBackupsAndTelemetryAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"淘汰历史快照异常: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isPruningBackups = false;
            StateHasChanged();
        }
    }

    private async Task DownloadBackupSnapshotAsync(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName) || _currentUser == null) return;
        try
        {
            var ticket = await UserSessionService.GenerateDownloadTicketAsync(_currentUser.Id, "backup_download", fileName);
            NavigationManager.NavigateTo($"/api/system/backups/download?filename={Uri.EscapeDataString(fileName)}&ticket={Uri.EscapeDataString(ticket)}", forceLoad: true);
            Snackbar.Add($"🛡️ 正在安全下载备份快照: {fileName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"生成安全下载凭证失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task VerifyBackupSnapshotAsync(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;
        _verifyingBackups.Add(fileName);
        StateHasChanged();
        try
        {
            var res = await SystemHealthService.VerifyBackupSnapshotAsync(fileName);
            _verifyResults[fileName] = res;
            if (res.IsHealthy)
            {
                Snackbar.Add($"✅ 快照物理深度校验通过: {fileName} (表数量: {res.TableCount}, 耗时: {res.VerificationDurationMs}ms)", Severity.Success);
            }
            else
            {
                Snackbar.Add($"⚠️ 快照校验异常: {res.ErrorMessage}", Severity.Warning);
            }
            await LoadBackupsAndTelemetryAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"快照校验执行失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _verifyingBackups.Remove(fileName);
            StateHasChanged();
        }
    }

