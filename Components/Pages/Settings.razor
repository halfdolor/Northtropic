                                              Placeholder="例如：LTAI5t7xxxxxxxxxxxxxxxx" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Key" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="阿里云 AccessKey Secret *" @bind-Value="_currentUser.AliyunAccessKeySecret" Variant="Variant.Outlined"
                                              InputType="@(_showAliyunSecret ? InputType.Text : InputType.Password)"
                                              Placeholder="例如：wxxxxxxxxxxxxxxxxxxxxxx" Adornment="Adornment.End"
                                              AdornmentIcon="@(_showAliyunSecret ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="() => _showAliyunSecret = !_showAliyunSecret" />
