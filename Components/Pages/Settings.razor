    private async Task RunFullHealthCheckAndHealingAsync()
    {
        _isHealingAll = true;
        StateHasChanged();
        try
        {
            Snackbar.Add("🚀 正在启动全维体检与一键自愈流水线...", Severity.Info);
            var optRes = await SystemHealthService.OptimizeDatabaseAsync();
            var fkStatus = await SystemHealthService.RunDatabaseForeignKeyCheckAsync();
            var integrityStatus = await SystemHealthService.RunDatabaseIntegrityCheckAsync();
            _dataIntegrityAudit = await SystemHealthService.AuditDataIntegrityAsync();
            int purgedCount = 0;
            int healedInvariantsCount = 0;
            if (!_dataIntegrityAudit.IsHealthy)
            {
                var purgeRes = await SystemHealthService.PurgeOrphanedRecordsAsync();
                purgedCount = purgeRes.TotalPurgedCount;
                var healRes = await SystemHealthService.HealAllInvariantsAsync();
                healedInvariantsCount = healRes.TotalHealedCount;
                _dataIntegrityAudit = await SystemHealthService.AuditDataIntegrityAsync();
            }
            _healthDto = await SystemHealthService.GetSystemHealthAsync();

            bool isFkHealthy = fkStatus.Equals("ok", StringComparison.OrdinalIgnoreCase);
            bool isIntegrityHealthy = integrityStatus.Equals("ok", StringComparison.OrdinalIgnoreCase);

            string reportHtml = $"<b>🚀 全维体检与自愈优化执行报告：</b><br/><br/>" +
                                $"• <b>物理 B-Tree 完整性：</b><span style='color: {(isIntegrityHealthy ? "#10b981" : "#ef4444")}; font-weight: bold;'>{integrityStatus}</span><br/>" +
                                $"• <b>外键关系完整性：</b><span style='color: {(isFkHealthy ? "#10b981" : "#ef4444")}; font-weight: bold;'>{fkStatus}</span><br/>" +
                                $"• <b>数据拓扑与领域自愈：</b><span style='color: #10b981; font-weight: bold;'>清理 {purgedCount} 条孤儿记录 | 自愈 {healedInvariantsCount} 项领域不变量 (当前 {_dataIntegrityAudit.TotalIssuesCount} 异常)</span><br/>" +
                                $"• <b>查询计划统计分析 (ANALYZE)：</b><span style='color: #10b981; font-weight: bold;'>{optRes.AnalyzeStatus}</span><br/>" +
                                $"• <b>查询计划自愈 (OPTIMIZE)：</b><span style='color: #10b981; font-weight: bold;'>{optRes.OptimizeStatus}</span><br/>" +
                                $"• <b>WAL 日志截断归档：</b><span style='color: #10b981; font-weight: bold;'>{optRes.CheckpointStatus}</span><br/>" +
                                $"• <b>瞬时收敛释放空间：</b>{optRes.BytesReclaimed} 字节<br/>" +
                                $"• <b>综合架构健康评分：</b><span style='color: #10b981; font-weight: bold;'>{_healthDto.HealthScore} 分 ({_healthDto.HealthRating})</span><br/>" +
                                $"• <b>自愈后微秒级时延：</b><span style='color: #10b981; font-weight: bold;'>{_healthDto.DatabaseLatencyMs:F2} ms</span>";

            await DialogService.ShowMessageBox(
                "🚀 全维体检与自愈优化完成",
                (MarkupString)reportHtml,
                yesText: "确定");
            Snackbar.Add("🎉 全维体检与自愈优化完成！系统处于极佳生产态势。", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"全维自愈异常: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isHealingAll = false;
            StateHasChanged();
        }
    }

