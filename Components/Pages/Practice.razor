    private async Task SubmitWholePaperAsync()
    {
        if (_paperSubmitted || _submittingPaper) return;

        RecordDwellTimeForCurrentQuestion();

        // 优先将当前题目的作答同步保存
        string currentAns = GetFinalUserAnswer();
        if (!string.IsNullOrWhiteSpace(currentAns))
        {
            _paperUserAnswers[_currentIndex] = currentAns;
        }

        // 智能检测是否存在未作答题目
        var unansweredIndexes = new List<int>();
        for (int i = 1; i <= _questions.Count; i++)
        {
            if (!_paperUserAnswers.ContainsKey(i) || string.IsNullOrWhiteSpace(_paperUserAnswers[i]) || _paperUserAnswers[i] == "(未作答)")
            {
                unansweredIndexes.Add(i);
            }
        }

        if (unansweredIndexes.Count > 0)
        {
            string listStr = string.Join("、", unansweredIndexes.Take(6).Select(idx => $"第 {idx} 题")) + (unansweredIndexes.Count > 6 ? $" 等共 {unansweredIndexes.Count} 题" : "");
            bool? confirm = await DialogService.ShowMessageBox(
                title: "⚠️ 试卷存在未作答题目",
                markupMessage: new MarkupString($"检测到您还有 <strong>{unansweredIndexes.Count}</strong> 道题目尚未作答：<br/><br/><span style='color: #ef4444; font-weight: bold;'>{listStr}</span><br/><br/>建议您检查并补齐答题。您可以点击【去补答第一道题】跳转，或点击【直接强制交卷】。"),
                yesText: "直接强制交卷",
                noText: "去补答首道题",
                cancelText: "留在当前题"
            );

            if (confirm == null)
            {
                return;
            }
            else if (confirm == false)
            {
                await JumpToQuestionAsync(unansweredIndexes[0]);
                return;
            }
        }

        _submittingPaper = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            StopTimers();
            _paperSubmitted = true;
            _paperEvalResults.Clear();

            var submissions = new List<(Question Question, string UserAnswer, int TimeTakenSeconds)>();
            for (int i = 0; i < _questions.Count; i++)
            {
                int idx = i + 1;
                var q = _questions[i];
                string userAns = _paperUserAnswers.TryGetValue(idx, out var ans) ? ans : "(未作答)";
                int timeTaken = _perQuestionTimeSpent.TryGetValue(idx, out var t) && t > 0 ? t : 15;
                submissions.Add((q, userAns, timeTaken));
            }

            // 架构与性能优化：使用统一原子批处理提交整卷，杜绝数十次分散写库开销
            var batchResult = await PracticeService.SubmitBatchPaperAsync(submissions, _currentCombo, _currentUser?.Id);

            foreach (var kvp in batchResult.ItemResults)
            {
                _paperEvalResults[kvp.Key] = kvp.Value;
            }

            int correctCount = batchResult.CorrectCount;
            _sessionCorrectCount = correctCount;
            _sessionEarnedExp = batchResult.TotalEarnedExp;
            _sessionEarnedCoins = batchResult.TotalEarnedCoins;
            _sessionMaxCombo = batchResult.MaxComboAchieved;
            _sessionAgileCount = batchResult.AgileMasteryCount;
            _sessionSteadyCount = batchResult.SteadyMasteryCount;
            _sessionCarelessCount = batchResult.CarelessCount;
            _sessionStrugglingCount = batchResult.StrugglingCount;
            _sessionPaceAdvice = batchResult.CognitivePaceAdvice;
            _currentCombo = batchResult.ItemResults.Count > 0 ? batchResult.ItemResults.Values.Last().Reward.CurrentCombo : 0;

            if (_paperEvalResults.TryGetValue(_currentIndex, out var currentPaperRes))
            {
                _lastResult = currentPaperRes;
                _submitted = true;
            }

            Snackbar.Add($"📑 试卷全卷提交完毕！共 {_questions.Count} 题，答对 {correctCount} 题", Severity.Success);

            if (!string.IsNullOrWhiteSpace(AssignmentId) && Guid.TryParse(AssignmentId, out var aId))
            {
                int score = _questions.Count > 0 ? (int)Math.Round((double)correctCount / _questions.Count * 100) : 0;
                try
                {
                    await PracticeService.CompleteHomeworkAssignmentAsync(aId, correctCount, _questions.Count, score, studentUserId: _currentUser?.Id);
                }
                catch { }
                Snackbar.Add($"🎉 专属作业已圆满完成！得分 {score} 分，已自动同步至家长学情大盘！", Severity.Success);
            }

            await OpenVictoryDialogAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"整卷提交处理异常: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submittingPaper = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetFinalUserAnswer()
    {
        var q = CurrentQuestion;
        if (q == null) return string.Empty;

        var options = q.Options;

        if (q.Type == QuestionType.SingleChoice)
        {
            if (string.IsNullOrEmpty(_selectedOption)) return string.Empty;
            int idx = options.FindIndex(o => o == _selectedOption);
            return Northtropic.Helpers.QuestionShuffleHelper.ExtractChoicePrefix(_selectedOption, idx >= 0 ? idx : 0);
        }
        if (q.Type == QuestionType.MultipleChoice)
        {
            var keys = _multiSelectedOptions.Select(o =>
            {
                int idx = options.FindIndex(opt => opt == o);
                return Northtropic.Helpers.QuestionShuffleHelper.ExtractChoicePrefix(o, idx >= 0 ? idx : 0);
            }).OrderBy(k => k);
            return string.Join(",", keys);
        }
        return _textAnswer;
    }

    private async Task PreviousQuestionAsync()
    {
        if (_evalMode.Contains("整卷统一") && !_paperSubmitted)
        {
            RecordDwellTimeForCurrentQuestion();
            string currentAns = GetFinalUserAnswer();
            if (!string.IsNullOrWhiteSpace(currentAns))
            {
                _paperUserAnswers[_currentIndex] = currentAns;
            }
        }

        if (_currentIndex > 1)
        {
            _currentIndex--;
            await ResetCurrentQuestionStateAsync();
            if (_evalMode.Contains("整卷统一"))
            {
                if (_paperUserAnswers.TryGetValue(_currentIndex, out var savedAns))
                {
                    RestoreAnswer(savedAns);
                }
                if (_paperSubmitted && _paperEvalResults.TryGetValue(_currentIndex, out var evalRes))
                {
                    _lastResult = evalRes;
                    _submitted = true;
                }
            }
        }
    }

    private async Task NextQuestionAsync()
    {
        if (_evalMode.Contains("整卷统一") && !_paperSubmitted)
        {
            RecordDwellTimeForCurrentQuestion();
            string currentAns = GetFinalUserAnswer();
            if (!string.IsNullOrWhiteSpace(currentAns))
            {
