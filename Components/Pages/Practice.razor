                break;
            case "mock":
                _questionCount = 15;
                _evalMode = "整卷统一交卷 (答完汇总)";
                _perQuestionTimeLimit = 0;
                _totalPaperTimeLimitMinutes = 45;
                Snackbar.Add("⏱️ 已应用【中考模考】模式：15题整卷，限时45分钟", Severity.Info);
                break;
            case "socratic":
                _questionCount = 5;
                _evalMode = "即时判定 (做一题审一题)";
                _useSocraticMode = true;
                Snackbar.Add("🧠 已应用【苏格拉底启发】模式：开启AI互动追问", Severity.Info);
                break;
            case "error":
                _questionSourceMode = "我的错题专练突破";
                _questionCount = 5;
                _evalMode = "即时判定 (做一题审一题)";
                Snackbar.Add("🎯 已应用【错题专练】模式：靶向歼灭历史薄弱考点", Severity.Info);
                break;
        }
    }

    // 标记待复查题号集合
    private HashSet<int> _flaggedQuestions = new HashSet<int>();

    private void ToggleFlagCurrent()
    {
        if (_flaggedQuestions.Contains(_currentIndex))
        {
            _flaggedQuestions.Remove(_currentIndex);
            Snackbar.Add($"已取消第 {_currentIndex} 题复查标记", Severity.Normal);
        }
        else
        {
            _flaggedQuestions.Add(_currentIndex);
            Snackbar.Add($"📌 已将第 {_currentIndex} 题标记为待复查！可在答题卡查看", Severity.Warning);
        }
    }

    // 即时错因自省脚手架 (UX 专家级认知脚手架)
    private string? _selectedInstantErrorReason;
    private readonly List<string> _quickErrorReasons = new() { "审题粗心", "概念模糊", "公式记错", "逻辑计算错误", "完全不会" };

    private async Task SetInstantErrorReasonAsync(string reason)
    {
        _selectedInstantErrorReason = reason;
        if (_currentUser != null && CurrentQuestion != null)
        {
            var errorItem = await ErrorBookService.GetErrorItemByQuestionAsync(_currentUser.Id, CurrentQuestion.Id);
            if (errorItem != null)
            {
                await ErrorBookService.UpdateErrorReasonAsync(errorItem.Id, reason, _currentUser.Id);
                Snackbar.Add($"已将该题错因标记为【{reason}】，错题本已自动同步分类！", Severity.Success);
            }
            else
            {
                Snackbar.Add($"已记录错因速记：【{reason}】", Severity.Info);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CurriculumConfigService.OnCurriculumChanged += HandleCurriculumChanged;
        _currentUser = await GamificationService.GetCurrentUserAsync();
        _subjects = GradeSubjectProvider.GetSubjectsByGrade(_currentUser.Grade);
        if (_subjects.Count > 0) _selectedSubject = _subjects[0];

        if (!string.IsNullOrWhiteSpace(Subject))
        {
            if (!_subjects.Contains(Subject))
            {
                _subjects.Add(Subject);
            }
            _selectedSubject = Subject;
        }

        // 绑定该学科对应的真实知识点列表
        RefreshCategoriesForSubject(_selectedSubject);

        if (!string.IsNullOrWhiteSpace(Category))
        {
            if (!_categories.Contains(Category))
            {
                _categories.Add(Category);
            }
            _selectedCategory = Category;
        }

        if (Count.HasValue && Count.Value > 0)
        {
            _questionCount = Count.Value;
        }

        // 先结束整页全局骨架 Loading，瞬间呈现渲染 UI 框架
        _loading = false;

        // 如果是专属作业
        if (!string.IsNullOrWhiteSpace(AssignmentId) && Guid.TryParse(AssignmentId, out var parsedAId))
        {
            _activeAssignment = await PracticeService.GetHomeworkAssignmentByIdAsync(parsedAId);
            if (_activeAssignment != null)
            {
                if (_activeAssignment.QuestionCount > 0) _questionCount = _activeAssignment.QuestionCount;
                if (!string.IsNullOrWhiteSpace(_activeAssignment.Subject)) _selectedSubject = _activeAssignment.Subject;
                if (!string.IsNullOrWhiteSpace(_activeAssignment.Category)) _selectedCategory = _activeAssignment.Category;
            }
            _evalMode = "整卷统一交卷 (答完汇总)";
            Snackbar.Add($"📋 已载入专属作业任务【{_selectedSubject} - {_selectedCategory}】({_questionCount} 题)，正在智能组卷...", Severity.Info);
            await Task.Yield();
            await GenerateAiQuestionAsync();
            return;
        }

        // 如果传入了指定的题目 ID 集合 (如错题靶向突击)
        if (!string.IsNullOrWhiteSpace(QuestionIds))
        {
            var qIds = QuestionIds.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(idStr => Guid.TryParse(idStr, out var g) ? g : Guid.Empty)
                .Where(g => g != Guid.Empty)
                .ToList();

            if (qIds.Count > 0)
            {
                await Task.Yield();
                var customQuestions = await PracticeService.GetQuestionsByIdsAsync(qIds);
                if (customQuestions.Count > 0)
                {
                    _questions.Clear();
                    _questions.AddRange(customQuestions);
                    _currentIndex = 1;
                    if (!string.IsNullOrWhiteSpace(customQuestions[0].Subject))
                    {
                        _selectedSubject = customQuestions[0].Subject;
                    }
                    _questionCount = customQuestions.Count;
                    _questionSourceMode = "我的错题专练突破";
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"🎯 成功载入 {customQuestions.Count} 道错题靶向强化试题！", Severity.Success);
                    StateHasChanged();
                    return;
                }
                else
                {
                    Snackbar.Add("💡 您指定的试题已完成攻克或已归档，系统已为您无缝准备今日专项巩固练习！", Severity.Info);
                    await GenerateAiQuestionAsync();
                    return;
                }
            }
        }

        // 如果带有 sprint 冲关模式、spaced_review 艾宾浩斯复苏模式、mock 全真模考或指定了考点分类参数，自动触发专项出题
        if (!string.IsNullOrWhiteSpace(Mode) && (Mode.Equals("sprint", StringComparison.OrdinalIgnoreCase) || Mode.Equals("spaced_review", StringComparison.OrdinalIgnoreCase)))
        {
            if (Mode.Equals("spaced_review", StringComparison.OrdinalIgnoreCase))
            {
                _questionSourceMode = "AI 智能组卷生成";
                Snackbar.Add($"🧠 已开启艾宾浩斯记忆唤醒专练：【{_selectedSubject} - {_selectedCategory}】", Severity.Info);
            }
            else
            {
                _questionSourceMode = "我的错题专练突破";
            }

            await Task.Yield();
            await GenerateAiQuestionAsync();
        }
        else if (!string.IsNullOrWhiteSpace(Mode) && Mode.Equals("mock", StringComparison.OrdinalIgnoreCase))
        {
            ApplyPreset("mock");
            Snackbar.Add($"📝 已开启全真模拟考场：【{_selectedSubject}】({_questionCount} 题，限时 {_totalPaperTimeLimitMinutes} 分钟，整卷统评)", Severity.Info);
            await Task.Yield();
            await GenerateAiQuestionAsync();
        }
        else if (!string.IsNullOrWhiteSpace(Mode) && (Mode.Equals("favorites", StringComparison.OrdinalIgnoreCase) || Mode.Equals("favorite", StringComparison.OrdinalIgnoreCase)))
        {
            _questionSourceMode = "我的重点收藏题库";
            Snackbar.Add("⭐ 已开启典藏好题专练！正在从收藏夹提取题目...", Severity.Success);
            await Task.Yield();
            await GenerateAiQuestionAsync();
        }
        else if (!string.IsNullOrWhiteSpace(Category))
        {
            await Task.Yield();
            await GenerateAiQuestionAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
