                Snackbar.Add("⏰ 已应用【艾宾浩斯抗遗忘】：优先抽取已达记忆临界点的待复习错题", Severity.Info);
                break;
            case "quick":
                _questionCount = 5;
                _evalMode = "即时判定 (做一题审一题)";
