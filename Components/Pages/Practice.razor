    private List<Question> GetCurrentSessionWrongQuestions()
    {
        var wrongQuestions = new List<Question>();
        for (int i = 0; i < _questions.Count; i++)
        {
            int idx = i + 1;
            if (_evalMode.Contains("整卷统一"))
            {
                if (_paperEvalResults.TryGetValue(idx, out var eval) && !eval.IsCorrect)
                {
                    wrongQuestions.Add(_questions[i]);
                }
            }
            else
            {
                if (_instantEvalResults.TryGetValue(idx, out var eval) && !eval.IsCorrect)
                {
                    wrongQuestions.Add(_questions[i]);
                }
            }
        }
        return wrongQuestions;
    }

    private int GetSessionWrongCount()
    {
        var list = GetCurrentSessionWrongQuestions();
        if (list.Count > 0) return list.Count;
        return Math.Max(0, _questions.Count - _sessionCorrectCount);
    }

    private string GetQuestionMatrixTooltip(int qNum)
    {
        if (qNum < 1 || qNum > _questions.Count) return $"第 {qNum} 题";
        var question = _questions[qNum - 1];
        var typeStr = question.TypeDisplayName;
        var stem = (question.Stem ?? string.Empty).Trim();
        if (stem.Length > 40)
        {
            stem = stem.Substring(0, 40) + "...";
        }
        var statusStr = _evalMode.Contains("整卷统一")
            ? (_paperUserAnswers.ContainsKey(qNum) ? $"[已作答: {_paperUserAnswers[qNum]}]" : "[未作答]")
            : (qNum < _currentIndex || (qNum == _currentIndex && _submitted) ? "[已完成]" : (qNum == _currentIndex ? "[正在作答]" : "[待作答]"));
        
        var flagStr = _flaggedQuestions.Contains(qNum) ? " 📌 待复查" : "";
        return $"第 {qNum} 题 · {typeStr} {statusStr}{flagStr} | {stem}";
    }

    private async Task RetryCurrentSessionErrorsAsync()
    {
        var wrongQuestions = GetCurrentSessionWrongQuestions();
        if (wrongQuestions.Count == 0)
        {
            Snackbar.Add("本轮没有错题，太棒了！", Severity.Success);
            return;
        }

        _victoryDialogVisible = false;
        _questions.Clear();
        _questions.AddRange(wrongQuestions.Select(q => Northtropic.Helpers.QuestionShuffleHelper.ShuffleQuestionOptions(q)));
        _currentIndex = 1;
        _paperSubmitted = false;
        _paperUserAnswers.Clear();
        _paperEvalResults.Clear();
        _instantEvalResults.Clear();
        _flaggedQuestions.Clear();
        _sessionCorrectCount = 0;
        _sessionEarnedExp = 0;
        _sessionEarnedCoins = 0;
        _sessionMaxCombo = 0;
        _sessionAgileCount = 0;
        _sessionSteadyCount = 0;
        _sessionCarelessCount = 0;
        _sessionStrugglingCount = 0;
        _sessionPaceAdvice = string.Empty;
        await ResetCurrentQuestionStateAsync();
        StartTimers();
        Snackbar.Add($"⚡ 立即开启本轮错题靶向重练特训！共 {wrongQuestions.Count} 道错题，加油攻克！", Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGlobalShortcut(string key)
    {
        if (key == "Help")
        {
            _showShortcutHelpDialog = !_showShortcutHelpDialog;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (key == "Zen")
        {
            ToggleZenMode();
            return;
        }

        if (key == "Esc")
        {
            if (_showShortcutHelpDialog)
            {
                _showShortcutHelpDialog = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
            if (_scratchpadOpen)
            {
                _scratchpadOpen = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
            if (_zenMode)
            {
                _zenMode = false;
                Snackbar.Add("已退出沉浸专注模式", Severity.Normal);
                await InvokeAsync(StateHasChanged);
                return;
            }
            return;
        }

        // 防误触保护：若当前正处于弹窗交互中（AI导师对话、战报结算、快捷键帮助），阻断背景答题与翻页快捷键
        if (_aiDialogVisible || _victoryDialogVisible || _showShortcutHelpDialog)
        {
            return;
        }

        // 快捷键收藏/取消收藏
        if (key == "Star")
        {
            await ToggleFavoriteCurrentAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        // 快捷键标记待复查 (P)
        if (key == "Pin")
        {
            ToggleFlagCurrent();
            await InvokeAsync(StateHasChanged);
            return;
        }

        // 快捷键草稿纸演算板展开/收起 (S)
        if (key == "Scratchpad")
        {
            await ToggleScratchpad();
            await InvokeAsync(StateHasChanged);
            return;
        }

        // 快捷键调起 AI 导师深度启发辅导 (H)
        if (key == "Ai" || key == "Tutor")
        {
            if (!_aiDialogVisible)
            {
                await OpenAiTutorModal();
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        if (_questions.Count == 0 || _evaluatingAnswer || _submittingPaper) return;

        var q = CurrentQuestion;
        if (q != null && !_submitted && !_paperSubmitted)
        {
            var options = q.Options;

            // 判断题快捷键 T (正确/对) / F (错误/错)
            if (key == "T" || key == "F")
            {
                bool targetVal = key == "T";
                var matchedOpt = options.FirstOrDefault(o => Northtropic.Services.PracticeService.TryNormalizeJudgement(o, out var j) && j == targetVal);
                if (matchedOpt != null)
                {
                    if (q.Type == QuestionType.SingleChoice)
                    {
                        SelectOption(matchedOpt);
                    }
                    else if (q.Type == QuestionType.MultipleChoice)
                    {
                        ToggleMultiOption(matchedOpt, !_multiSelectedOptions.Contains(matchedOpt));
                    }
                    await InvokeAsync(StateHasChanged);
                    return;
                }
                else if (q.Type == QuestionType.FillInBlank)
                {
                    _textAnswer = targetVal ? "正确" : "错误";
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }

            if (q.Type == QuestionType.SingleChoice)
            {
                int optIdx = key switch { "A" => 0, "1" => 0, "B" => 1, "2" => 1, "C" => 2, "3" => 2, "D" => 3, "4" => 3, "E" => 4, "5" => 4, _ => -1 };
                if (optIdx >= 0 && optIdx < options.Count)
                {
                    SelectOption(options[optIdx]);
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            else if (q.Type == QuestionType.MultipleChoice)
            {
                int optIdx = key switch { "A" => 0, "1" => 0, "B" => 1, "2" => 1, "C" => 2, "3" => 2, "D" => 3, "4" => 3, "E" => 4, "5" => 4, _ => -1 };
                if (optIdx >= 0 && optIdx < options.Count)
                {
                    var opt = options[optIdx];
                    bool isChecked = _multiSelectedOptions.Contains(opt);
                    ToggleMultiOption(opt, !isChecked);
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
        }

        if (key == "Enter" || key == "CtrlEnter")
        {
            if (!_submitted && !_paperSubmitted)
            {
                if (_evalMode.Contains("整卷统一"))
                {
                    if (_currentIndex < _questions.Count)
                    {
                        await NextQuestionAsync();
                    }
                    else
                    {
                        await SubmitWholePaperAsync();
                    }
                }
                else
                {
                    await SubmitAnswerAsync();
                }
            }
            else
            {
                await NextQuestionAsync();
            }
        }
        else if (key == "Next")
        {
            if (_submitted || _evalMode.Contains("整卷统一") || _paperSubmitted)
            {
                await NextQuestionAsync();
            }
        }
        else if (key == "Prev")
        {
            await PreviousQuestionAsync();
        }
    }

