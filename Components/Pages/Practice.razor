            "集合逻辑" => new[] { "∈", "∉", "⊆", "∪", "∩", "∅", "{", "}", "\\emptyset" },
            "希腊字母" => new[] { "α", "β", "γ", "θ", "λ", "ρ", "Ω", "μ", "Δ", "ω", "η", "ν", "ε" },
            "理化符号" => new[] { "m/s", "m/s²", "g/cm³", "kW·h", "℃", "→", "⇌", "↑", "↓", "H₂O", "CO₂", "NH₃", "Na₂O₂", "Fe³⁺", "SO₄²⁻", "CO₃²⁻", "NH₄⁺", "MnO₄⁻", "Ag⁺", "Cl⁻", "OH⁻" },
            _ => _quickMathSymbols
        };
    }

    private async Task HandleGlobalPracticeKeyDown(KeyboardEventArgs e)
    {
        var q = CurrentQuestion;
        if (q == null) return;

        // 如果是单选题
        if (q.Type == QuestionType.SingleChoice && !_submitted)
        {
            var options = q.Options;
            int targetIndex = -1;
            var keyLower = e.Key?.ToLowerInvariant();
            if (keyLower == "a" || keyLower == "1") targetIndex = 0;
            else if (keyLower == "b" || keyLower == "2") targetIndex = 1;
            else if (keyLower == "c" || keyLower == "3") targetIndex = 2;
            else if (keyLower == "d" || keyLower == "4") targetIndex = 3;
            else if (keyLower == "e" || keyLower == "5") targetIndex = 4;
            else if (keyLower == "t")
            {
                targetIndex = options.FindIndex(o => o.Contains("正确") || o.Contains("对") || o.StartsWith("A", StringComparison.OrdinalIgnoreCase) || o.StartsWith("T", StringComparison.OrdinalIgnoreCase));
                if (targetIndex < 0 && options.Count >= 1) targetIndex = 0;
            }
            else if (keyLower == "f")
            {
                targetIndex = options.FindIndex(o => o.Contains("错误") || o.Contains("错") || o.StartsWith("B", StringComparison.OrdinalIgnoreCase) || o.StartsWith("F", StringComparison.OrdinalIgnoreCase));
                if (targetIndex < 0 && options.Count >= 2) targetIndex = 1;
            }

            if (targetIndex >= 0 && targetIndex < options.Count)
            {
                SelectOption(options[targetIndex]);
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        // 如果是不定项多选题
        else if (q.Type == QuestionType.MultipleChoice && !_submitted)
        {
            var options = q.Options;
            int targetIndex = -1;
            var keyLower = e.Key?.ToLowerInvariant();
            if (keyLower == "a" || keyLower == "1") targetIndex = 0;
            else if (keyLower == "b" || keyLower == "2") targetIndex = 1;
            else if (keyLower == "c" || keyLower == "3") targetIndex = 2;
            else if (keyLower == "d" || keyLower == "4") targetIndex = 3;
            else if (keyLower == "e" || keyLower == "5") targetIndex = 4;

            if (targetIndex >= 0 && targetIndex < options.Count)
            {
                var opt = options[targetIndex];
                bool isChecked = _multiSelectedOptions.Contains(opt);
                ToggleMultiOption(opt, !isChecked);
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        // 提交或下一题快捷键 (Enter / Space)
        if (e.Key == "Enter" || e.Key == " ")
        {
            // 如果已经提交，且不是整卷模式，按 Enter/Space 自动切入下一题
            if (_submitted && !_evalMode.Contains("整卷统一"))
            {
                if (_currentIndex < _questions.Count)
                {
                    await NextQuestionAsync();
                }
                return;
            }

            // 如果尚未提交，且已选择答案，按 Enter/Space 自动提交
            if (!_submitted && !_paperSubmitted && !_evaluatingAnswer)
            {
                bool hasAnswer = false;
                if (q.Type == QuestionType.SingleChoice)
                {
                    hasAnswer = !string.IsNullOrEmpty(_selectedOption);
                }
                else if (q.Type == QuestionType.MultipleChoice)
                {
                    hasAnswer = _multiSelectedOptions.Count > 0;
                }

                if (hasAnswer)
                {
                    if (_evalMode.Contains("整卷统一"))
                    {
                        if (_currentIndex < _questions.Count)
                        {
                            await NextQuestionAsync();
                        }
                        else
                        {
                            await SubmitWholePaperAsync();
                        }
                    }
                    else
                    {
                        await SubmitAnswerAsync();
                    }
                }
            }
        }
        // 左右方向键导航
        else if (e.Key == "ArrowRight" && (_submitted || _evalMode.Contains("整卷统一")))
        {
            if (_currentIndex < _questions.Count)
            {
                await NextQuestionAsync();
            }
        }
        else if (e.Key == "ArrowLeft" && (_submitted || _evalMode.Contains("整卷统一")))
        {
            if (_currentIndex > 1)
            {
                await PreviousQuestionAsync();
            }
        }
    }

    private async Task InsertSymbol(string symbol)
    {
        if (_submitted || _paperSubmitted) return;
        _textAnswer = (_textAnswer ?? "") + symbol;
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () =>
        {
            await Task.Delay(30);
            try { await JSRuntime.InvokeVoidAsync("renderAllMath"); } catch { }
        });
    }

    private async Task OnTextAnswerChanged(string val)
    {
        _textAnswer = val;
        await InvokeAsync(StateHasChanged);
        if (!string.IsNullOrWhiteSpace(val) && (val.Contains("$") || val.Contains("\\") || val.Contains("^") || val.Contains("_") || val.Contains("{") || val.Contains("√") || val.Contains("π")))
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(50);
                try { await JSRuntime.InvokeVoidAsync("renderAllMath"); } catch { }
            });
        }
    }

    private async Task OnTextInputKeyDown(KeyboardEventArgs e)
    {
        bool isCtrlOrMetaEnter = (e.CtrlKey || e.MetaKey) && e.Key == "Enter";
        bool isSingleEnter = CurrentQuestion?.Type == QuestionType.FillInBlank && e.Key == "Enter" && !e.CtrlKey && !e.ShiftKey && !e.AltKey && !e.MetaKey;

        if (isCtrlOrMetaEnter || isSingleEnter)
        {
            if (!_submitted && !_paperSubmitted && !_evaluatingAnswer && !_submittingPaper)
            {
                if (_evalMode.Contains("整卷统一"))
                {
                    if (_currentIndex < _questions.Count)
                    {
                        await NextQuestionAsync();
                    }
                    else
                    {
                        await SubmitWholePaperAsync();
                    }
                }
                else
                {
                    await SubmitAnswerAsync();
                }
            }
            else if (_submitted && !_evalMode.Contains("整卷统一") && !_paperSubmitted && !_submittingPaper)
            {
                if (_currentIndex < _questions.Count)
                {
                    await NextQuestionAsync();
                }
            }
        }
    }


    private async Task QuickAskAiAsync(string prompt)
    {
        _userPrompt = prompt;
        await AskAiAsync();
    }

    private void StartTimers()
    {
        StopTimers();
        _paperSubmitted = false;
        _paperUserAnswers.Clear();
        _paperEvalResults.Clear();

        if (_perQuestionTimeLimit > 0)
        {
            _perQuestionTimeLeft = _perQuestionTimeLimit;
        }

        if (_totalPaperTimeLimitMinutes > 0)
        {
            _totalPaperTimeLeft = _totalPaperTimeLimitMinutes * 60;
        }

        if (_perQuestionTimeLimit > 0 || _totalPaperTimeLimitMinutes > 0)
        {
            _countdownTimer = new System.Threading.Timer(OnTimerTick, null, 1000, 1000);
        }
    }

    private async void OnTimerTick(object? state)
    {
        bool stateChanged = false;

        if (_totalPaperTimeLeft > 0 && !_paperSubmitted)
        {
            _totalPaperTimeLeft--;
            stateChanged = true;
            if (_totalPaperTimeLeft <= 0)
            {
                StopTimers();
                await InvokeAsync(SubmitWholePaperAsync);
                return;
            }
        }

        if (_perQuestionTimeLimit > 0 && !_paperSubmitted && !IsCurrentQuestionSubmitted())
        {
            _perQuestionTimeLeft--;
            stateChanged = true;
            if (_perQuestionTimeLeft <= 0)
            {
                await InvokeAsync(async () =>
                {
                    if (_evalMode.Contains("即时判定"))
                    {
                        await SubmitCurrentAnswerAsync(isTimeout: true);
                    }
                    else
                    {
                        _paperUserAnswers[_currentIndex] = "(超时未作答)";
                        Snackbar.Add($"⏱️ 题目 {_currentIndex} 作答超时！已记为超时未作答", Severity.Warning);
                        await NextQuestionAsync();
                    }
                });
            }
        }

        if (stateChanged)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsCurrentQuestionSubmitted()
    {
        if (_evalMode.Contains("即时判定")) return _submitted;
        return _paperUserAnswers.ContainsKey(_currentIndex);
    }

    private string FormatTotalTimeLeft(int seconds)
    {
        int hr = seconds / 3600;
        int min = (seconds % 3600) / 60;
        int sec = seconds % 60;
        if (hr > 0)
        {
            return $"{hr:D2}:{min:D2}:{sec:D2}";
        }
        return $"{min:D2}:{sec:D2}";
    }

    private async Task ToggleSoundEffectsLocalAsync()
    {
        if (_currentUser == null) return;
        bool newStatus = !_currentUser.SoundEffectsEnabled;
        _currentUser.SoundEffectsEnabled = newStatus;
        await UserSessionService.UpdateSoundEffectsEnabledAsync(_currentUser.Id, newStatus);
        if (newStatus)
        {
            Snackbar.Add("🔊 答题音效反馈已开启！", Severity.Success);
        }
        else
        {
            Snackbar.Add("🔇 已切换至图书馆静音专注模式！", Severity.Info);
        }
        await InvokeAsync(StateHasChanged);
    }

