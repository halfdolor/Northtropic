            await JSRuntime.InvokeVoidAsync("renderAllMath");
        }
        catch { }
    }

    private void RestoreAnswer(string savedAns)
    {
        var q = CurrentQuestion;
        if (q == null) return;
        List<string> options = new();
        try
        {
            if (!string.IsNullOrWhiteSpace(q.OptionsJson))
            {
                options = System.Text.Json.JsonSerializer.Deserialize<List<string>>(q.OptionsJson) ?? new();
            }
        }
        catch { }

        if (q.Type == QuestionType.SingleChoice)
        {
            for (int i = 0; i < options.Count; i++)
            {
                var opt = options[i];
                string prefix = Northtropic.Helpers.QuestionShuffleHelper.ExtractChoicePrefix(opt, i);
                if (string.Equals(prefix, savedAns, StringComparison.OrdinalIgnoreCase) || opt.StartsWith(savedAns) || opt == savedAns)
                {
                    _selectedOption = opt;
                    break;
                }
            }
        }
        else if (q.Type == QuestionType.MultipleChoice)
        {
            var keys = savedAns.Split(new[] { ',', '，', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            _multiSelectedOptions.Clear();
            for (int i = 0; i < options.Count; i++)
            {
                var opt = options[i];
                string prefix = Northtropic.Helpers.QuestionShuffleHelper.ExtractChoicePrefix(opt, i);
                if (keys.Any(k => string.Equals(prefix, k, StringComparison.OrdinalIgnoreCase) || opt.StartsWith(k)))
                {
                    _multiSelectedOptions.Add(opt);
                }
            }
        }
        else
        {
            _textAnswer = savedAns;
        }
    }

