    private async Task OpenVictoryDialogAsync()
    {
        _victoryDialogVisible = true;

        // 若非整卷提交模式，动态依据作答用时与正确情况补齐四象限认知分布统计
        if ((_sessionAgileCount + _sessionSteadyCount + _sessionCarelessCount + _sessionStrugglingCount == 0) && _questions.Count > 0)
        {
            var durations = _perQuestionTimeSpent.Values.Where(v => v > 0).ToList();
            double avg = durations.Count > 0 ? durations.Average() : 15.0;
            double threshold = Math.Max(10.0, avg * 0.75);
            var currentWrongQuestions = GetCurrentSessionWrongQuestions();
            for (int i = 1; i <= _questions.Count; i++)
            {
                int time = _perQuestionTimeSpent.TryGetValue(i, out var t) && t > 0 ? t : 15;
                bool isCorrect = _paperEvalResults.TryGetValue(i, out var r) ? r.IsCorrect : (currentWrongQuestions.All(wq => wq.Id != _questions[i-1].Id));
                bool isFast = time <= threshold;
                if (isCorrect)
                {
                    if (isFast) _sessionAgileCount++;
                    else _sessionSteadyCount++;
                }
                else
                {
                    if (isFast) _sessionCarelessCount++;
                    else _sessionStrugglingCount++;
                }
            }

            if (_sessionCarelessCount > 0 && _sessionCarelessCount >= _sessionStrugglingCount)
            {
                _sessionPaceAdvice = "💡 检测到部分题目答题过快导致粗心失分，建议审题时放慢节奏，仔细圈画题干关键限制词！";
            }
            else if (_sessionStrugglingCount > 0 && _sessionStrugglingCount > _sessionCarelessCount)
            {
                _sessionPaceAdvice = "💡 检测到部分题目思考耗时较长仍未攻克，属于典型知识盲区，建议查阅试题详解并一键加入错题本！";
            }
            else if (_sessionAgileCount > 0 && _sessionCarelessCount == 0 && _sessionStrugglingCount == 0)
            {
                _sessionPaceAdvice = "🌟 敏捷度与准确度双双拉满！知识点掌握炉火纯青，保持极佳答题状态！";
            }
            else if (_sessionSteadyCount > 0 && _sessionCarelessCount == 0)
            {
                _sessionPaceAdvice = "🛡️ 沉稳缜密，思路清晰严谨，每一步推导都扎实有效，保持节奏！";
            }
            else
            {
                _sessionPaceAdvice = "🎯 保持专注作答节奏，循序渐进突破薄弱板块，继续加油！";
            }
        }

        if (!string.IsNullOrWhiteSpace(AssignmentId) && Guid.TryParse(AssignmentId, out var aId) && !_paperSubmitted)
        {
            int score = _questions.Count > 0 ? (int)Math.Round((double)_sessionCorrectCount / _questions.Count * 100) : 0;
            try
            {
                await PracticeService.CompleteHomeworkAssignmentAsync(aId, _sessionCorrectCount, _questions.Count, score, studentUserId: _currentUser?.Id);
            }
            catch { }
            Snackbar.Add($"🎉 专属作业已圆满完成！得分 {score} 分，已自动同步至家长学情大盘！", Severity.Success);
        }

        try
        {
            if (_currentUser?.SoundEffectsEnabled != false)
            {
                await JSRuntime.InvokeVoidAsync("playRewardAudio", "levelup");
            }
            if (_currentUser?.ConfettiEnabled != false)
            {
                await JSRuntime.InvokeVoidAsync("triggerConfetti");
            }
        }
        catch { }
    }

