    private void RefreshCategoriesForSubject(string subject)
    {
        _categories = GradeSubjectProvider.GetCategoriesBySubject(subject);
        _selectedCategory = _categories.Count > 0 ? _categories[0] : "全部";
    }

    private void OnSubjectChanged(string newSub)
    {
        _selectedSubject = newSub;
        RefreshCategoriesForSubject(newSub);
    }

    private void OnCategoryChanged(string newCat)
    {
        _selectedCategory = newCat;
    }

    private void ResetPracticeCategoryFilter()
    {
        _selectedCategory = "全部";
        Snackbar.Add("已重置考点分类为【全部】", Severity.Info);
    }

    private int _perQuestionTimeLimit = 0;
    private int _totalPaperTimeLimitMinutes = 0;
    private string _evalMode = "即时判定 (做一题审一题)";

    private int _perQuestionTimeLeft = 0;
    private int _totalPaperTimeLeft = 0;
    private System.Threading.Timer? _countdownTimer;
    private bool _paperSubmitted = false;
    private Dictionary<int, string> _paperUserAnswers = new Dictionary<int, string>();
    private Dictionary<int, AnswerCheckResult> _paperEvalResults = new Dictionary<int, AnswerCheckResult>();
    private Dictionary<int, AnswerCheckResult> _instantEvalResults = new Dictionary<int, AnswerCheckResult>();

    private string _questionSourceMode = "AI 智能组卷生成";
    private int _questionCount = 5;

    private async Task GenerateAiQuestionAsync()
    {
        if (_currentUser == null) return;

        // 防误触保护：若当前整卷或单题已有作答未交卷，二次确认避免手误丢失进度
        if (_questions.Count > 0 && !_paperSubmitted && (_paperUserAnswers.Any() || _submitted))
        {
            bool? confirm = await DialogService.ShowMessageBox(
                title: "⚠️ 正在练习中",
                message: "检测到您当前已有正在作答的练习进度，重新组卷将重置当前练习，确定重新组卷出题吗？",
                yesText: "确定重新出题",
                cancelText: "继续作答当前题"
            );
            if (confirm != true) return;
        }

        _generatingAiQuestion = true;
        _instantEvalResults.Clear();
        _paperEvalResults.Clear();
        _paperUserAnswers.Clear();
        await InvokeAsync(StateHasChanged);
        
        try
        {
            if (_questionSourceMode.Contains("自适应"))
            {
                var adaptiveQuestions = await PracticeService.GetAdaptiveQuestionsAsync(_currentUser.Id, _currentUser.Grade, _selectedSubject, _selectedCategory, _questionCount);
                if (adaptiveQuestions.Count > 0)
                {
                    _questions.Clear();
                    _questions.AddRange(adaptiveQuestions);
                    _currentIndex = 1;
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"🎯 智能自适应组卷成功！已根据您在【{_selectedSubject}】的学情动态匹配 {adaptiveQuestions.Count} 道最近发展区梯级试题！", Severity.Success);
                    return;
                }
            }
            else if (_questionSourceMode.Contains("艾宾浩斯"))
            {
                var dueErrorItems = await ErrorBookService.GetEbbinghausReviewQueueAsync(_currentUser.Id, _selectedSubject, _questionCount);
                var dueQuestions = dueErrorItems.Where(e => e.Question != null).Select(e => e.Question!).ToList();
                if (dueQuestions.Count > 0)
                {
                    _questions.Clear();
                    _questions.AddRange(dueQuestions);
                    _currentIndex = 1;
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"⏰ 艾宾浩斯抗遗忘强化卷已生成！载入 {dueQuestions.Count} 道已达临界遗忘点的核心错题！", Severity.Success);
                    return;
                }
                else
                {
                    Snackbar.Add($"👏 记忆健康！当前【{_selectedSubject}】暂无到达遗忘临界期的待复习错题，已为您自动切换为智能出题！", Severity.Info);
                }
            }
            else if (_questionSourceMode.Contains("收藏"))
            {
                var favQuestions = await PracticeService.GetFavoriteQuestionsAsync(_currentUser.Id);
                if (favQuestions.Count > 0)
                {
                    _questions.Clear();
                    _questions.AddRange(favQuestions.Take(_questionCount));
                    _currentIndex = 1;
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"⭐ 成功从重点收藏夹载入 {_questions.Count} 道重点试题，开启温故知新！", Severity.Success);
                    return;
                }
                else
                {
                    Snackbar.Add("您的重点收藏夹中暂无题目，已自动切换为智能组卷！在刷题时点击题干右上角 ⭐ 即可将经典好题加入收藏夹。", Severity.Info);
                }
            }
            else if (_questionSourceMode.Contains("错题专练"))
            {
                var errorQuestions = await PracticeService.GetSprintQuestionsFromErrorsAsync(_currentUser.Id, _selectedSubject, _questionCount);
                if (errorQuestions.Count > 0)
                {
                    _questions.Clear();
                    _questions.AddRange(errorQuestions);
                    _currentIndex = 1;
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"🎯 成功载入 {errorQuestions.Count} 道【{_selectedSubject}】高频历史错题，开启专项攻坚！", Severity.Success);
                    return;
                }
                else
                {
                    Snackbar.Add($"太棒了！当前【{_selectedSubject}】暂无未消化的错题，为您自动切换为智能出题！", Severity.Info);
                }
            }
            else if (_questionSourceMode.Contains("题库随机") || _questionSourceMode.Contains("混合"))
            {
                var dbQuestions = await PracticeService.GetRandomQuestionsAsync(_currentUser.Id, _currentUser.Grade, _selectedSubject, _selectedCategory, _questionCount);
                if (dbQuestions.Count >= _questionCount)
                {
                    _questions.Clear();
                    _questions.AddRange(dbQuestions);
                    _currentIndex = 1;
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"📚 成功从题库抽取 {dbQuestions.Count} 道【{_selectedSubject} - {_selectedCategory}】试题！(未消耗 Token)", Severity.Success);
                    return;
                }
                else if (_questionSourceMode.Contains("混合") && dbQuestions.Count > 0)
                {
                    int needMore = _questionCount - dbQuestions.Count;
                    var aiMore = await AiQuestionGeneratorService.GenerateBatchQuestionsAsync(_currentUser.Grade, _selectedSubject, _selectedCategory, needMore);
                    _questions.Clear();
                    _questions.AddRange(dbQuestions);
                    _questions.AddRange(aiMore);
                    _currentIndex = 1;
                    await ResetCurrentQuestionStateAsync();
                    StartTimers();
                    Snackbar.Add($"🔀 已从本地库拉取 {dbQuestions.Count} 道题，并由 AI 智能补齐了 {aiMore.Count} 道题！", Severity.Success);
                    return;
                }
                else if (_questionSourceMode.Contains("题库随机") && dbQuestions.Count == 0)
                {
                    Snackbar.Add($"提示：当前【{_selectedSubject} - {_selectedCategory}】题库中暂无本地存题，正在为您智能生成...", Severity.Info);
                }
            }

            var questions = await AiQuestionGeneratorService.GenerateBatchQuestionsAsync(_currentUser.Grade, _selectedSubject, _selectedCategory, _questionCount);
            _questions.Clear();
            _questions.AddRange(questions);
            _currentIndex = 1;
            await ResetCurrentQuestionStateAsync();
            StartTimers();
            Snackbar.Add($"🤖 成功为您生成 {_questions.Count} 道【{_currentUser.Grade} - {_selectedSubject}】涵盖单选/不定项/填空/简答的试卷！", Severity.Success);
        }
        catch (LlmConfigException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"出题失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generatingAiQuestion = false;
            await InvokeAsync(StateHasChanged);
        }
    }

