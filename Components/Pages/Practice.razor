        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _showShortcutHelpDialog = false">我知道了</MudButton>
    </DialogActions>
</MudDialog>

