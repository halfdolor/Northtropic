@page "/practice"
@using Northtropic.Models
@using Northtropic.Services
@using Microsoft.EntityFrameworkCore
@inject IPracticeService PracticeService
@inject IAiTutorService AiTutorService
@inject IAiQuestionGeneratorService AiQuestionGeneratorService
@inject IGamificationService GamificationService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IQuestionImportService QuestionImportService
@inject IStudentEvolutionService StudentEvolutionService
@inject IErrorBookService ErrorBookService
@inject IUserSessionService UserSessionService
@inject ICurriculumConfigService CurriculumConfigService
@implements IDisposable

<PageTitle>刷题中心 - Northtropic</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 mb-10">
    <!-- 顶部增益 Buff 状态栏 & 用户称号 -->
    @if (!_zenMode && _currentUser != null && ((_currentUser.ExpBoostUntil.HasValue && _currentUser.ExpBoostUntil.Value > DateTime.Now) || (_currentUser.GoldBoostUntil.HasValue && _currentUser.GoldBoostUntil.Value > DateTime.Now) || _currentUser.ComboShieldCount > 0 || !string.IsNullOrEmpty(_currentUser.ActiveTitle)))
    {
        <div class="d-flex align-center flex-wrap gap-2 mb-3 no-print">
            @if (!string.IsNullOrEmpty(_currentUser.ActiveTitle))
            {
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.MilitaryTech" Class="font-weight-bold">
                    称号: @_currentUser.ActiveTitle
                </MudChip>
            }
            @if (_currentUser.ExpBoostUntil.HasValue && _currentUser.ExpBoostUntil.Value > DateTime.Now)
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Bolt" Class="font-weight-bold">
                    ⚡ 2倍经验药水 生效中 (剩余 @Math.Max(1, (int)(_currentUser.ExpBoostUntil.Value - DateTime.Now).TotalMinutes) 分钟)
                </MudChip>
            }
            @if (_currentUser.GoldBoostUntil.HasValue && _currentUser.GoldBoostUntil.Value > DateTime.Now)
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.MonetizationOn" Class="font-weight-bold">
                    💰 金币暴击符 生效中 (剩余 @Math.Max(1, (int)(_currentUser.GoldBoostUntil.Value - DateTime.Now).TotalMinutes) 分钟)
                </MudChip>
            }
            @if (_currentUser.ComboShieldCount > 0)
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Shield" Class="font-weight-bold">
                    🛡️ 连击保护符 x@_currentUser.ComboShieldCount
                </MudChip>
            }
        </div>
    }

    @if (_zenMode)
    {
        <!-- 沉浸专注模式 HUD 顶栏 -->
        <div class="glass-card pa-3 mb-4 d-flex align-center justify-space-between flex-wrap gap-2 zen-hud no-print" style="border: 1.5px solid rgba(59, 130, 246, 0.4); background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(12px); border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
            <div class="d-flex align-center gap-3 flex-wrap">
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CenterFocusStrong" Style="font-weight: 700;">
                    🧘 沉浸专注模式
                </MudChip>
                @if (_questions.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #60a5fa;">
                        第 @_currentIndex / @_questions.Count 题
                    </MudText>
                }
                @if (_perQuestionTimeLimit > 0)
                {
                    <MudChip T="string" Color="@(_perQuestionTimeLeft <= 10 ? Color.Error : Color.Info)" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Timer">
                        本题限时: @_perQuestionTimeLeft s
                    </MudChip>
                }
                @if (_totalPaperTimeLimitMinutes > 0)
                {
                    <MudChip T="string" Color="@(_totalPaperTimeLeft <= 300 ? Color.Error : Color.Warning)" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.HourglassTop">
                        整卷限时: @FormatTotalTimeLeft(_totalPaperTimeLeft)
                    </MudChip>
                }
                @if (_currentCombo > 1)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.LocalFireDepartment">
                        @_currentCombo 连胜
                    </MudChip>
                }
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudTooltip Text="快捷键速查指南 (?)">
                    <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Color="Color.Default" Size="Size.Small" OnClick="() => _showShortcutHelpDialog = true" />
                </MudTooltip>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FullscreenExit" OnClick="ToggleZenMode" Style="font-weight: 700;">
                    退出沉浸 (Esc)
                </MudButton>
            </div>
        </div>
    }
    else
    {
        <!-- 顶部刷题头部面板 (年级专属学科与知识点二级联动选择) -->
        <!-- 顶部刷题指挥中心 (两层架构：核心刷题栏 + 折叠式高级模考定制面板) -->
        <div class="glass-card pa-4 mb-4 no-print">
        <!-- Tier 1: 核心操作导航栏 (极简、专注、高频) -->
        <div class="d-flex flex-wrap align-center justify-space-between gap-4">
            <div class="d-flex align-center flex-wrap gap-3">
                <MudSelect T="string" Value="@_selectedSubject" ValueChanged="OnSubjectChanged" Label="目标学科" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 130px;">
                    @foreach (var sub in _subjects)
                    {
                        <MudSelectItem Value="@sub">@sub</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" Value="@_selectedCategory" ValueChanged="OnCategoryChanged" Label="对应考点" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 150px;">
                    @foreach (var cat in _categories)
                    {
                        <MudSelectItem Value="@cat">@cat</MudSelectItem>
                    }
                </MudSelect>

                <!-- 题量快捷选择组 -->
                <div class="d-flex align-center gap-1">
                    <MudNumericField T="int" @bind-Value="_questionCount" Label="题量" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="50" Style="width: 80px;" />
                    <MudButtonGroup OverrideStyles="false" Size="Size.Small" Variant="Variant.Outlined">
                        <MudButton Size="Size.Small" Class="@(_questionCount == 5 ? "mud-theme-primary" : "")" OnClick="@(() => _questionCount = 5)">5</MudButton>
                        <MudButton Size="Size.Small" Class="@(_questionCount == 10 ? "mud-theme-primary" : "")" OnClick="@(() => _questionCount = 10)">10</MudButton>
                        <MudButton Size="Size.Small" Class="@(_questionCount == 20 ? "mud-theme-primary" : "")" OnClick="@(() => _questionCount = 20)">20</MudButton>
                    </MudButtonGroup>
                </div>

                <!-- 核心出题主按钮 -->
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="GenerateAiQuestionAsync" Disabled="@_generatingAiQuestion" Class="font-weight-bold py-2 px-5" Style="border-radius: 8px;">
                    @if (_generatingAiQuestion) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> <span>出题中...</span> } else { <span>开启 @_questionCount 道题练习</span> }
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="LoadDemoSampleQuestionsAsync" Disabled="@_generatingAiQuestion" Class="font-weight-bold py-2">
                    🎲 精品样题
                </MudButton>

                <!-- 高级模考设置开关与状态标签 -->
                <MudButton Variant="@(_advancedSettingsOpen ? Variant.Filled : Variant.Outlined)" Color="Color.Default" StartIcon="@Icons.Material.Filled.Tune" OnClick="ToggleAdvancedSettings" Class="py-2" Style="border-radius: 8px;">
                    模考定制 @(_advancedSettingsOpen ? "▲" : "▼")
                </MudButton>

                @if (_useSocraticMode)
                {
                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Icon="@Icons.Material.Filled.Psychology" Variant="Variant.Filled">苏格拉底·开</MudChip>
                }
                @if (_perQuestionTimeLimit > 0)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Timer" Variant="Variant.Outlined">单题 @_perQuestionTimeLimit s</MudChip>
                }
                @if (_totalPaperTimeLimitMinutes > 0)
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.HourglassTop" Variant="Variant.Outlined">全卷 @_totalPaperTimeLimitMinutes 分</MudChip>
                }
                @if (_evalMode.Contains("整卷"))
                {
                    <MudChip T="string" Color="Color.Tertiary" Size="Size.Small" Icon="@Icons.Material.Filled.AssignmentTurnedIn" Variant="Variant.Outlined">整卷汇总</MudChip>
                }

                @if (_questions.Count > 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintExamPaperAsync" Class="font-weight-bold">
                        🖨️ 打印试卷
                    </MudButton>
                    <MudButton Variant="@(_scratchpadOpen ? Variant.Filled : Variant.Outlined)" Color="Color.Info" StartIcon="@Icons.Material.Filled.Draw" OnClick="ToggleScratchpad" Class="font-weight-bold">
                        📝 草稿纸 @(_scratchpadOpen ? "【收起】" : "【展开】")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.CenterFocusStrong" OnClick="ToggleZenMode" Class="font-weight-bold">
                        🧘 沉浸专注 (Z)
                    </MudButton>
                }
            </div>

            <!-- 倒计时芯片 & Combo 挂件 & 每日 100 题进度挂件 -->
            <div class="d-flex align-center flex-wrap gap-2">
                @if (_currentUser != null)
                {
                    <MudChip T="string" Color="@(_currentUser.TodayAnsweredCount >= 100 ? Color.Error : Color.Primary)" Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" Class="font-weight-bold">
                        今日: @_currentUser.TodayAnsweredCount / 100 题 @(_currentUser.TodayAnsweredCount >= 100 ? "(付费)" : "(免费)")
                    </MudChip>
                    <MudTooltip Text="@(_currentUser.SoundEffectsEnabled ? "🔊 答题音效开启中 (点击切换静音模式)" : "🔇 静音专注模式中 (点击开启音效)")">
                        <MudIconButton Icon="@(_currentUser.SoundEffectsEnabled ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)"
                                       Color="@(_currentUser.SoundEffectsEnabled ? Color.Primary : Color.Default)"
                                       OnClick="ToggleSoundEffectsLocalAsync"
                                       Size="Size.Small" />
                    </MudTooltip>
                }

                @if (_perQuestionTimeLimit > 0 && _questions.Count > 0 && !_paperSubmitted && !IsCurrentQuestionSubmitted())
                {
                    <MudChip T="string" Color="@(_perQuestionTimeLeft <= 5 ? Color.Error : Color.Warning)" Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Class="font-weight-bold">
                        单题剩余: @_perQuestionTimeLeft 秒
                    </MudChip>
                }

                @if (_totalPaperTimeLimitMinutes > 0 && _questions.Count > 0 && !_paperSubmitted)
                {
                    <MudChip T="string" Color="@(_totalPaperTimeLeft <= 60 ? Color.Error : Color.Info)" Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" Class="font-weight-bold">
                        全卷剩余: @FormatTotalTimeLeft(_totalPaperTimeLeft)
                    </MudChip>
                }

                @if (_currentCombo > 1)
                {
                    <div class="combo-badge">
                        🔥 @_currentCombo Combo! (@GetComboMultiplierText())
                    </div>
                }

                @if (_questions.Count > 0)
                {
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mud-text-secondary ml-2">
                        题目 @_currentIndex / @_questions.Count
                    </MudText>
                }
            </div>
        </div>

        <!-- Tier 2: 折叠式高级模考定制面板 -->
        <MudCollapse Expanded="@_advancedSettingsOpen">
            <MudDivider Class="my-3" />
            <div class="pa-3 rounded-lg" style="background: rgba(255, 255, 255, 0.03); border: 1px dashed rgba(255, 255, 255, 0.15);">
                <!-- 预设场景一键切换 -->
                <div class="d-flex align-center flex-wrap gap-2 mb-3">
                    <span class="text-caption font-weight-bold mr-1" style="color: var(--mud-palette-text-secondary);">⚡ 快捷预设场景：</span>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Adjust" OnClick="@(() => ApplyPreset("adaptive"))">智能自适应 (动态梯度)</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Alarm" OnClick="@(() => ApplyPreset("ebbinghaus"))">艾宾浩斯抗遗忘</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.FlashOn" OnClick="@(() => ApplyPreset("quick"))">快速精练 (5题·即审)</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Timer" OnClick="@(() => ApplyPreset("mock"))">中考全真模拟 (15题·45分限时)</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Psychology" OnClick="@(() => ApplyPreset("socratic"))">苏格拉底深思 (启发追问)</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.GpsFixed" OnClick="@(() => ApplyPreset("error"))">错题靶向歼灭 (错题集)</MudButton>
                </div>

                <!-- 详细参数调优网格 -->
                <div class="d-flex align-center flex-wrap gap-4">
                    <MudSelect T="string" @bind-Value="_questionSourceMode" Label="出题来源模式" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 210px;">
                        <MudSelectItem Value="@("🎯 智能自适应推题 (动态梯度)")">🎯 智能自适应推题 (动态梯度)</MudSelectItem>
                        <MudSelectItem Value="@("⏰ 艾宾浩斯抗遗忘强化")">⏰ 艾宾浩斯抗遗忘强化</MudSelectItem>
                        <MudSelectItem Value="@("AI 智能组卷生成")">🤖 AI 智能组卷生成</MudSelectItem>
                        <MudSelectItem Value="@("现有题库随机抽题")">📚 现有题库随机抽题</MudSelectItem>
                        <MudSelectItem Value="@("智能混合模式 (优先题库，不足 AI 补齐)")">🔀 智能混合模式 (题库+AI补齐)</MudSelectItem>
                        <MudSelectItem Value="@("我的错题专练突破")">🎯 我的错题专练突破</MudSelectItem>
                        <MudSelectItem Value="@("我的重点收藏题库")">⭐ 我的重点收藏题库</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string" @bind-Value="_evalMode" Label="交卷结算机制" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 190px;">
                        <MudSelectItem Value="@("即时判定 (做一题审一题)")">⚡ 即时判定 (做一题审一题)</MudSelectItem>
                        <MudSelectItem Value="@("整卷统一交卷 (答完汇总)")">📝 整卷统一交卷 (模拟考场)</MudSelectItem>
                    </MudSelect>

                    <MudNumericField T="int" @bind-Value="_perQuestionTimeLimit" Label="单题限时" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="0" Max="3600" Step="15" Adornment="Adornment.End" AdornmentText="秒"
                                     HelperText="0 为不限制单题作答时间"
                                     Style="min-width: 135px; max-width: 155px;" />

                    <MudNumericField T="int" @bind-Value="_totalPaperTimeLimitMinutes" Label="全卷限时" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="0" Max="300" Step="5" Adornment="Adornment.End" AdornmentText="分"
                                     HelperText="0 为不限制全卷时间"
                                     Style="min-width: 135px; max-width: 155px;" />

                    <div class="d-flex align-center gap-2 pl-2">
                        <MudSwitch T="bool" Value="@_useSocraticMode" ValueChanged="ToggleSocraticMode" Color="Color.Secondary" Label="🧠 苏格拉底式启发引导" />
                        <MudTooltip Text="开启后，AI 将像苏格拉底一样用递进追问启发解题思维，绝不提前剧透答案。">
                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" />
                        </MudTooltip>
                    </div>
                </div>
            </div>
        </MudCollapse>
    </div>
    }

    @if (_generatingAiQuestion)
    {
        <div class="glass-card pa-4 mb-4 text-center no-print" style="border: 1px solid var(--mud-palette-secondary);">
            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="font-weight-bold">
                🤖 AI 智慧导师正在深入【@_selectedSubject · @_selectedCategory】知识库与中考真题库智能组卷...
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                基于启发式题型分布算法，实时编排 @_questionCount 道针对性梯度试题
            </MudText>
        </div>
    }

    <!-- 草稿纸演算板 (Scratchpad Drawer) -->
    @if (_scratchpadOpen)
    {
        <div class="glass-card pa-4 mb-6 no-print" style="border: 2px solid #00e5ff;">
            <div class="scratchpad-toolbar rounded-t-lg mb-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Draw" Color="Color.Info" />
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">智能随题草稿演算纸</MudText>
                </div>
                
                <!-- 调色板与画笔模式 -->
                <div class="d-flex align-center gap-2 flex-wrap">
                    <div class="d-flex align-center gap-1">
                        <button class="color-dot-btn @(_scratchColor == "#00e5ff" && !_isEraser ? "active" : "")" style="background: #00e5ff;" title="荧光青" @onclick="@(() => SetScratchColor("#00e5ff"))"></button>
                        <button class="color-dot-btn @(_scratchColor == "#f59e0b" && !_isEraser ? "active" : "")" style="background: #f59e0b;" title="明黄" @onclick="@(() => SetScratchColor("#f59e0b"))"></button>
                        <button class="color-dot-btn @(_scratchColor == "#f43f5e" && !_isEraser ? "active" : "")" style="background: #f43f5e;" title="珊瑚红" @onclick="@(() => SetScratchColor("#f43f5e"))"></button>
                        <button class="color-dot-btn @(_scratchColor == "#10b981" && !_isEraser ? "active" : "")" style="background: #10b981;" title="荧光绿" @onclick="@(() => SetScratchColor("#10b981"))"></button>
                        <button class="color-dot-btn @(_scratchColor == "#ffffff" && !_isEraser ? "active" : "")" style="background: #ffffff;" title="纯白" @onclick="@(() => SetScratchColor("#ffffff"))"></button>
                    </div>

                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />

                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                        <MudButton Variant="@(_scratchLineWidth == 2 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => SetScratchLineWidth(2))">细笔</MudButton>
                        <MudButton Variant="@(_scratchLineWidth == 4 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => SetScratchLineWidth(4))">中笔</MudButton>
                        <MudButton Variant="@(_scratchLineWidth == 8 ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => SetScratchLineWidth(8))">粗笔</MudButton>
                    </MudButtonGroup>

                    <MudButton Variant="@(_isHighlighter ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Highlight" OnClick="ToggleHighlighter">
                        荧光高亮 @(_isHighlighter ? "开" : "")
                    </MudButton>

                    <MudButton Variant="@(_isEraser ? Variant.Filled : Variant.Outlined)" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="ToggleEraser">
                        橡皮擦
                    </MudButton>

                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />

                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Undo" OnClick="UndoScratchpadAsync">
                        撤销
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadScratchpadAsync">
                        存图
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearScratchpadAsync">
                        清空
                    </MudButton>
                </div>
            </div>
            <div class="scratchpad-container">
                <canvas id="practiceScratchpad" class="scratchpad-canvas"></canvas>
            </div>
        </div>
    }

    @if (_activeAssignment != null)
    {
        <div class="pa-4 glass-card mb-4 no-print" style="border-left: 5px solid #ec4899; background: linear-gradient(135deg, rgba(236, 72, 153, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%); border-radius: 12px; box-shadow: 0 4px 18px rgba(0,0,0,0.15);">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Secondary" Size="Size.Medium" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="color: #f472b6;">
                        📋 专属作业任务：《@_activeAssignment.Title》
                    </MudText>
                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">@_activeAssignment.Subject · @_activeAssignment.Category</MudChip>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">共 @_activeAssignment.QuestionCount 题</MudChip>
                </div>
                @if (_activeAssignment.Deadline.HasValue)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Timer">
                        截止时间: @_activeAssignment.Deadline.Value.ToString("yyyy-MM-dd HH:mm")
                    </MudChip>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_activeAssignment.ParentNote))
            {
                <div class="d-flex align-center gap-2 mt-2 pa-2 rounded" style="background: rgba(255, 255, 255, 0.05); border: 1px dashed rgba(244, 114, 182, 0.3);">
                    <MudText Typo="Typo.body2" Style="color: #fbcfe8;">
                        💌 <strong>@(_activeAssignment.CreatorUser?.Username ?? "家长") 专属寄语：</strong> @_activeAssignment.ParentNote
                    </MudText>
                </div>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_generatingAiQuestion && _questions.Count == 0)
    {
        <div class="glass-card pa-12 text-center my-6">
            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large" Class="mb-4" Style="width: 54px; height: 54px;" />
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">
                AI 导师正在精心命题中...
            </MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                正在为您生成【<strong style="color: var(--mud-palette-info);">@(_currentUser?.Grade ?? "年级")</strong> - <strong style="color: var(--mud-palette-secondary);">@_selectedSubject</strong> - <strong style="color: var(--mud-palette-success);">@_selectedCategory</strong>】专属习题
            </MudText>
            <MudText Typo="Typo.caption" Class="mt-2 d-block mud-text-secondary">
                💡 大模型实时思考推理中，预计需要 3 - 8 秒，请稍侯...
            </MudText>
        </div>
    }
    else if (_questions.Count == 0)
    {
        <div class="glass-card pa-8 text-center my-6">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" Color="Color.Primary" Class="mb-3" Style="width: 56px; height: 56px;" />
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">
                准备好了吗？开启你的专属刷题挑战！
            </MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
                当前学科：【<strong style="color: var(--mud-palette-info);">@_selectedSubject</strong>】 · 考点分类：【<strong style="color: var(--mud-palette-secondary);">@_selectedCategory</strong>】 · 计划题量：<strong>@_questionCount 题</strong>
            </MudText>
            <div class="d-flex align-center justify-center gap-3 flex-wrap mb-6">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="GenerateAiQuestionAsync" Class="px-8 font-weight-bold" Style="border-radius: 12px;">
                    立即组卷开启练习
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="LoadDemoSampleQuestionsAsync" Class="px-6 font-weight-bold" Style="border-radius: 12px;">
                    🎲 体验 5 题精品全题型样卷
                </MudButton>
                @if (_selectedCategory != "全部")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetPracticeCategoryFilter" Class="px-6 font-weight-bold" Style="border-radius: 12px;">
                        🔄 重置分类为全部
                    </MudButton>
                }
            </div>

            <!-- 3 大极速预设快捷卡片 -->
            <MudGrid Spacing="3" Class="text-left mt-2">
                <MudItem xs="12" sm="4">
                    <div class="pa-4 glass-card cursor-pointer" style="border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 12px; height: 100%; transition: all 0.2s ease-in-out;" @onclick="StartQuickWarmupAsync">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">⚡ 5 题极速热身卷</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            快速抽取 5 道核心基础题，即做即判，快速唤醒做题手感与思维状态！
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="font-weight-bold pa-0">立即开启 →</MudButton>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <div class="pa-4 glass-card cursor-pointer" style="border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 12px; height: 100%; transition: all 0.2s ease-in-out;" @onclick="StartAdaptiveTargetPracticeAsync">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Secondary" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">🎯 核心考点突破卷</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            基于当前年级学科知识树，智能聚焦核心重难点，专治审题粗心与概念模糊。
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" Class="font-weight-bold pa-0">精准攻坚 →</MudButton>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <div class="pa-4 glass-card cursor-pointer" style="border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; height: 100%; transition: all 0.2s ease-in-out;" @onclick='() => NavigationManager.NavigateTo("/error-book")'>
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Color="Color.Error" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">🔥 错题同考点演练</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            一键直通错题净化副本，针对历史错误题目开展靶向变式，击碎顽固遗忘。
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="font-weight-bold pa-0">前往错题本 →</MudButton>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    }
    else
    {
        <!-- 全卷答题卡矩阵导航 (Question Matrix Navigator) -->
        @if (_questions.Count > 1)
        {
            <div class="glass-card pa-3 mb-4 d-flex align-center justify-space-between flex-wrap gap-2 no-print">
                <div class="d-flex align-center gap-2 flex-shrink-0">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">全卷答题卡：</MudText>
                    @if (_flaggedQuestions.Count > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 700; font-size: 0.75rem;">
                            📌 待复查: @_flaggedQuestions.Count 题
                        </MudChip>
                    }
                </div>
                <div class="d-flex align-center gap-2 overflow-x-auto py-1 px-1 flex-grow-1" style="max-width: 100%; scrollbar-width: thin; -webkit-overflow-scrolling: touch; touch-action: pan-x;">
                    @for (int idx = 1; idx <= _questions.Count; idx++)
                    {
                        int qNum = idx;
                        bool isCurrent = _currentIndex == qNum;
                        bool isFlagged = _flaggedQuestions.Contains(qNum);
                        bool hasAnswered = _evalMode.Contains("整卷统一") 
                            ? _paperUserAnswers.ContainsKey(qNum) 
                            : (qNum < _currentIndex || (qNum == _currentIndex && _submitted));
                        
                        Color chipColor = Color.Default;
                        Variant chipVariant = Variant.Outlined;

                        if (_evalMode.Contains("整卷统一") && _paperSubmitted && _paperEvalResults.ContainsKey(qNum))
                        {
                            chipColor = _paperEvalResults[qNum].IsCorrect ? Color.Success : Color.Error;
                            chipVariant = Variant.Filled;
                        }
                        else if (isCurrent)
                        {
                            chipColor = Color.Primary;
                            chipVariant = Variant.Filled;
                        }
                        else if (_evalMode.Contains("即时判定"))
                        {
                            if (qNum < _currentIndex || (qNum == _currentIndex && _submitted))
                            {
                                chipColor = Color.Success;
                                chipVariant = Variant.Filled;
                            }
                            else if (isFlagged)
                            {
                                chipColor = Color.Warning;
                                chipVariant = Variant.Filled;
                            }
                        }
                        else if (_evalMode.Contains("整卷统一"))
                        {
                            if (isFlagged)
                            {
                                chipColor = Color.Warning;
                                chipVariant = Variant.Filled;
                            }
                            else if (hasAnswered)
                            {
                                chipColor = Color.Info;
                                chipVariant = Variant.Filled;
                            }
                        }

                        string customStyle = $"min-width: 36px; height: 32px; font-weight: 700; border-radius: 8px; transition: all 0.15s ease-in-out;";
                        if (isCurrent)
                        {
                            customStyle += " box-shadow: 0 0 10px var(--mud-palette-primary); outline: 2px solid #ffffff; transform: scale(1.05);";
                        }

                        <MudTooltip Text="@GetQuestionMatrixTooltip(qNum)" Placement="Placement.Top" Arrow="true">
                            <MudBadge Visible="@isFlagged" Icon="@Icons.Material.Filled.PushPin" Color="Color.Warning" Overlap="true" Class="mx-1 flex-shrink-0">
                                <MudButton Size="Size.Small"
                                           Variant="@chipVariant"
                                           Color="@chipColor"
                                           Class="px-2"
                                           Style="@customStyle"
                                           OnClick="() => JumpToQuestionAsync(qNum)">
                                    @qNum
                                </MudButton>
                            </MudBadge>
                        </MudTooltip>
                    }
                </div>
                <div class="d-flex align-center gap-3 flex-wrap">
                    @if (_flaggedQuestions.Count > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                            📌 已标记待复查: @_flaggedQuestions.Count 题
                        </MudChip>
                    }
                    @{
                        int answeredCount = _evalMode.Contains("整卷统一") ? _paperUserAnswers.Count : (_submitted ? _currentIndex : Math.Max(0, _currentIndex - 1));
                        int progressPercent = _questions.Count > 0 ? (answeredCount * 100 / _questions.Count) : 0;
                    }
                    <div class="d-flex align-center gap-2">
                        <MudProgressLinear Value="@progressPercent" Color="Color.Primary" Rounded="true" Style="width: 80px; height: 6px;" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-weight: 700;">
                            已答 @answeredCount/@_questions.Count (@progressPercent%)
                        </MudText>
                    </div>
                    <MudTooltip Text="查看全局沉浸刷题快捷键指南 (或按 ? 键)">
                        <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Color="Color.Default" Size="Size.Small" OnClick="() => _showShortcutHelpDialog = true" />
                    </MudTooltip>
                    <MudTooltip Text="@(_zenMode ? "退出沉浸专注 (Esc / Z)" : "进入沉浸专注做题模式 (Z)")">
                        <MudButton Variant="@(_zenMode ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                                   OnClick="ToggleZenMode"
                                   Style="border-radius: 8px; font-weight: 700;">
                            @(_zenMode ? "专注中" : "沉浸专注")
                        </MudButton>
                    </MudTooltip>
                </div>
            </div>
        }

        var q = CurrentQuestion;

        <!-- 题目 Card (使用唯一 @key 强制每题重新创建 DOM，杜绝 KaTeX 缓存脏节点；支持全键盘极速答题) -->
        <div class="glass-card pa-6 mb-6 position-relative practice-math-container" @key="@($"qcard-{q.Id}-{_currentIndex}")" tabindex="0" @onkeydown="HandleGlobalPracticeKeyDown" style="outline: none;">
            <!-- 题目难度与标签 & 收藏/标记按钮 -->
            <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
                <div class="d-flex align-center gap-2">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@q.Subject</MudChip>
                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@q.Category</MudChip>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">@q.TypeDisplayName</MudChip>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudTooltip Text="@(_flaggedQuestions.Contains(_currentIndex) ? "取消标记本题" : "📌 标记此题 (待复查)")">
                        <MudIconButton Icon="@(_flaggedQuestions.Contains(_currentIndex) ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                       Color="@(_flaggedQuestions.Contains(_currentIndex) ? Color.Warning : Color.Default)"
                                       Size="Size.Medium"
                                       OnClick="ToggleFlagCurrent" />
                    </MudTooltip>
                    <MudTooltip Text="@(_isFavorited ? "取消收藏" : "加入收藏夹 (快捷收藏)")">
                        <MudIconButton Icon="@(_isFavorited ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                       Color="@(_isFavorited ? Color.Warning : Color.Default)"
                                       Class="@(_isFavorited ? "star-btn-fav" : "")"
                                       Size="Size.Medium"
                                       OnClick="ToggleFavoriteCurrentAsync" />
                    </MudTooltip>
                    <MudTooltip Text="@GetDifficultyDescriptor(q.Difficulty)">
                        <MudChip T="string" Color="@GetDifficultyColor(q.Difficulty)" Size="Size.Small" Variant="Variant.Filled">
                            @GetDifficultyBadgeText(q.Difficulty)
                        </MudChip>
                    </MudTooltip>
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-weight-bold">
                        答对加/答错扣金币 ｜ +@q.BaseExpReward EXP
                    </MudText>
                </div>
            </div>

            <!-- 题干 (使用独立 key 确保题干文本每次切题均精准重新渲染，支持响应式公式平滑滚动) -->
            <div class="mb-6 practice-math-container" @key="@($"stem-{q.Id}-{_currentIndex}")">
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="line-height: 1.6;">
                    @q.Stem
                </MudText>
            </div>

            <!-- 答题区域 (根据题型渲染) -->
            <div class="d-flex flex-column gap-3 mb-6">
                @if (q.Type == QuestionType.SingleChoice || q.Type == QuestionType.MultipleChoice)
                {
                    <div class="d-flex align-center gap-2 mb-1 no-print" style="background: rgba(var(--mud-palette-primary-rgb), 0.06); padding: 5px 12px; border-radius: 8px; border: 1px dashed rgba(var(--mud-palette-primary-rgb), 0.3);">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">
                            ⚡ 极速答题快捷键：直接按键盘 <kbd class="shortcut-badge">A</kbd> <kbd class="shortcut-badge">B</kbd> <kbd class="shortcut-badge">C</kbd> <kbd class="shortcut-badge">D</kbd> @(q.Options.Count == 2 ? "或 [T]/[F]" : "") 选答案，按 <kbd class="shortcut-badge">Enter</kbd> 提交/下一题
                        </MudText>
                    </div>
                }
                @if (q.Type == QuestionType.SingleChoice)
                {
                    var options = q.Options;
                    @for (int oi = 0; oi < options.Count; oi++)
                    {
                        var opt = options[oi];
                        string shortcutLetter = oi switch { 0 => "A", 1 => "B", 2 => "C", 3 => "D", 4 => "E", _ => "" };
                        if (options.Count == 2)
                        {
                            if (opt.Contains("正确") || opt.Contains("对")) shortcutLetter = "A / T";
                            else if (opt.Contains("错误") || opt.Contains("错")) shortcutLetter = "B / F";
                        }
                        bool isSelected = _selectedOption == opt;
                        string btnClass = "option-btn";
                        if (_submitted)
                        {
                            if (opt.StartsWith(q.CorrectAnswer) || opt == q.CorrectAnswer) btnClass += " correct";
                            else if (isSelected && !_lastResult!.IsCorrect) btnClass += " wrong";
                        }
                        else if (isSelected)
                        {
                            btnClass += " selected";
                        }

                        <button class="@btnClass" @onclick="() => SelectOption(opt)" disabled="@_submitted" aria-label="@($"选项 {shortcutLetter}: {opt}")" aria-pressed="@(isSelected ? "true" : "false")" role="button">
                            @if (!string.IsNullOrEmpty(shortcutLetter))
                            {
                                <kbd class="shortcut-badge">@shortcutLetter</kbd>
                            }
                            @opt
                        </button>
                    }
                }
                else if (q.Type == QuestionType.MultipleChoice)
                {
                    var options = q.Options;
                    <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Info" Style="font-weight: 700;">💡 本题为【不定项选择题】，支持勾选多个选项组合答题：</MudText>
                    @for (int oi = 0; oi < options.Count; oi++)
                    {
                        var opt = options[oi];
                        string shortcutLetter = oi switch { 0 => "A", 1 => "B", 2 => "C", 3 => "D", 4 => "E", _ => "" };
                        bool isChecked = _multiSelectedOptions.Contains(opt);
                        var correctKeys = (q.CorrectAnswer ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        bool isCorrectOpt = correctKeys.Any(k => opt.StartsWith(k) || opt == k);

                        string cardStyle = "padding: 10px 14px; border-radius: 10px; transition: all 0.2s;";
                        if (_submitted)
                        {
                            if (isCorrectOpt && isChecked)
                            {
                                cardStyle += " background: rgba(34, 197, 94, 0.15); border: 1.5px solid #22c55e;";
                            }
                            else if (isCorrectOpt && !isChecked)
                            {
                                cardStyle += " background: rgba(245, 158, 11, 0.15); border: 1.5px dashed #f59e0b;";
                            }
                            else if (!isCorrectOpt && isChecked)
                            {
                                cardStyle += " background: rgba(239, 68, 68, 0.15); border: 1.5px solid #ef4444;";
                            }
                            else
                            {
                                cardStyle += " background: var(--sub-card-bg); opacity: 0.7;";
                            }
                        }
                        else if (isChecked)
                        {
                            cardStyle += " background: rgba(59, 130, 246, 0.15); border: 1.5px solid var(--mud-palette-primary);";
                        }
                        else
                        {
                            cardStyle += " background: var(--sub-card-bg); border: 1px solid var(--glass-card-border);";
                        }

                        <div class="d-flex align-center justify-space-between glass-card mb-2 cursor-pointer" style="@cardStyle" @onclick="() => { if (!_submitted) ToggleMultiOption(opt, !isChecked); }" role="checkbox" aria-checked="@(isChecked ? "true" : "false")" aria-label="@($"多选选项 {shortcutLetter}: {opt}")">
                            <MudCheckBox T="bool" Value="@isChecked" ValueChanged="val => ToggleMultiOption(opt, val)" Disabled="@_submitted" Color="Color.Primary" Dense="true" Class="ma-0 pa-0">
                                @if (!string.IsNullOrEmpty(shortcutLetter))
                                {
                                    <kbd class="shortcut-badge mr-2">@shortcutLetter</kbd>
                                }
                                <span style="font-weight: 500;">@opt</span>
                            </MudCheckBox>

                            @if (_submitted)
                            {
                                @if (isCorrectOpt && isChecked)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">正确选中</MudChip>
                                }
                                else if (isCorrectOpt && !isChecked)
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Warning">正确项 (漏选)</MudChip>
                                }
                                else if (!isCorrectOpt && isChecked)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Close">错误多选</MudChip>
                                }
                            }
                        </div>
                    }
                }
                else if (q.Type == QuestionType.ShortAnswer || q.Type == QuestionType.EssayAnalysis || q.Type == QuestionType.FillInBlank)
                {
                    string typeLabel = q.Type == QuestionType.ShortAnswer ? "简答题" : (q.Type == QuestionType.EssayAnalysis ? "问答解析综合大题" : "填空题");
                    Color typeColor = q.Type == QuestionType.ShortAnswer ? Color.Warning : (q.Type == QuestionType.EssayAnalysis ? Color.Secondary : Color.Success);
                    string tipText = q.Type == QuestionType.ShortAnswer ? "请简明列出解题关键步骤与核心得分点：" : (q.Type == QuestionType.EssayAnalysis ? "请写出完整演算过程或综合分析步骤：" : "请精准填入关键短语或数值：");

                    <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                        <MudText Typo="Typo.caption" Color="typeColor" Style="font-weight: 700;">
                            💡 本题为【@typeLabel】，@tipText
                        </MudText>
                        <div class="mode-toggle-group">
                            <button type="button" class="mode-toggle-btn @(_subjectiveInputMode == "keyboard" ? "active" : "")"
                                    @onclick="@(() => SetSubjectiveInputModeAsync("keyboard"))">
                                <MudIcon Icon="@Icons.Material.Filled.Keyboard" Size="Size.Small" Class="mr-1" />
                                键盘输入
                            </button>
                            <button type="button" class="mode-toggle-btn @(_subjectiveInputMode == "handwriting" ? "active-hw" : "")"
                                    @onclick="@(() => SetSubjectiveInputModeAsync("handwriting"))">
                                <MudIcon Icon="@Icons.Material.Filled.Draw" Size="Size.Small" Class="mr-1" />
                                手写作答
                            </button>
                            <button type="button" class="mode-toggle-btn @(_isRecordingSubjectiveVoice ? "active-voice" : "")"
                                    @onclick="ToggleSubjectiveVoiceRecordingAsync" disabled="@_submitted">
                                <MudIcon Icon="@(_isRecordingSubjectiveVoice ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" Size="Size.Small" Class="mr-1" />
                                @(_isRecordingSubjectiveVoice ? "正在录音..." : "语音输入")
                            </button>
                        </div>
                    </div>

                    @if (_subjectiveInputMode == "handwriting")
                    {
                        <!-- 手写作答画板 (类似草稿演算纸，支持笔迹书写、橡皮擦与 AI 笔迹识别) -->
                        <div class="glass-card pa-3 mb-3" style="background: rgba(15, 23, 42, 0.5); border: 1.5px dashed rgba(168, 85, 247, 0.4); border-radius: 12px;">
                            <!-- 手写工具栏 -->
                            <div class="d-flex align-center justify-space-between mb-2 flex-wrap gap-2 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <span style="font-size: 0.8rem; font-weight: 700; color: #c084fc;">🎨 画笔:</span>
                                    <button class="color-dot-btn @(_hwColor == "#00e5ff" && !_hwEraser ? "active" : "")" style="background: #00e5ff;" @onclick="@(() => SetHwColor("#00e5ff"))" title="荧光青"></button>
                                    <button class="color-dot-btn @(_hwColor == "#f59e0b" && !_hwEraser ? "active" : "")" style="background: #f59e0b;" @onclick="@(() => SetHwColor("#f59e0b"))" title="明黄"></button>
                                    <button class="color-dot-btn @(_hwColor == "#f43f5e" && !_hwEraser ? "active" : "")" style="background: #f43f5e;" @onclick="@(() => SetHwColor("#f43f5e"))" title="珊瑚红"></button>
                                    <button class="color-dot-btn @(_hwColor == "#10b981" && !_hwEraser ? "active" : "")" style="background: #10b981;" @onclick="@(() => SetHwColor("#10b981"))" title="荧光绿"></button>
                                    <button class="color-dot-btn @(_hwColor == "#ffffff" && !_hwEraser ? "active" : "")" style="background: #ffffff;" @onclick="@(() => SetHwColor("#ffffff"))" title="纯白"></button>

                                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />

                                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                        <MudButton Variant="@(_hwLineWidth == 2 && !_hwEraser ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => SetHwLineWidth(2))" Size="Size.Small">细</MudButton>
                                        <MudButton Variant="@(_hwLineWidth == 4 && !_hwEraser ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => SetHwLineWidth(4))" Size="Size.Small">中</MudButton>
                                        <MudButton Variant="@(_hwLineWidth == 7 && !_hwEraser ? Variant.Filled : Variant.Outlined)" Color="Color.Default" OnClick="@(() => SetHwLineWidth(7))" Size="Size.Small">粗</MudButton>
                                    </MudButtonGroup>

                                    <MudButton Variant="@(_hwHighlighter ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Highlight" OnClick="ToggleHwHighlighter">
                                        荧光 @(_hwHighlighter ? "开" : "")
                                    </MudButton>

                                    <MudButton Variant="@(_hwEraser ? Variant.Filled : Variant.Outlined)" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="ToggleHwEraser">
                                        橡皮擦
                                    </MudButton>
                                </div>

                                <div class="d-flex align-center gap-2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Undo" OnClick="UndoHwAsync" Disabled="@_submitted">撤销</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearHwAsync" Disabled="@_submitted">清空</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="RecognizeHandwritingOcrAsync" Disabled="@(_submitted || _isRecognizingOcr)" Style="font-weight: 700;">
                                        @if (_isRecognizingOcr)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width: 14px; height: 14px;" />
                                            <span>正在识别...</span>
                                        }
                                        else
                                        {
                                            <span>识别为文字</span>
                                        }
                                    </MudButton>
                                </div>
                            </div>

                            <!-- 手写作答 Canvas 画布 (带网格参考线) -->
                            <div style="position: relative; width: 100%; height: 260px; background: #0b1120; border-radius: 8px; overflow: hidden; background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 0); background-size: 24px 24px; cursor: crosshair;">
                                <canvas id="handwritingCanvas" style="width: 100%; height: 100%; display: block;"></canvas>
                                <div style="position: absolute; bottom: 8px; right: 12px; font-size: 0.72rem; color: rgba(255,255,255,0.4); pointer-events: none;">
                                    ✍️ 支持手写笔/鼠标草稿作答 · 随时点击右上角【🤖 识别为文字】
                                </div>
                            </div>

                            <!-- 常用理科符号快捷插入工具栏 (分类与响应式折叠) -->
                            <div class="d-flex align-center justify-space-between flex-wrap gap-1 mt-2 mb-1">
                                <div class="d-flex align-center gap-1 flex-wrap">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary mr-1">快捷符号：</MudText>
                                    @foreach (var cat in _symbolCategories)
                                    {
                                        <button type="button" 
                                                class="mud-button-root mud-chip-root @(_selectedSymbolCategory == cat ? "mud-chip-filled mud-chip-color-primary" : "mud-chip-outlined mud-chip-default") mud-chip-size-small" 
                                                style="height: 22px; padding: 0 8px; font-size: 0.72rem; cursor: pointer; border-radius: 12px;"
                                                @onclick="() => _selectedSymbolCategory = cat">
                                            @cat
                                        </button>
                                    }
                                </div>
                                <button type="button" class="mud-button-root mud-button mud-button-text mud-button-text-default mud-button-size-small" 
                                        style="font-size: 0.72rem; padding: 0 4px; min-height: 20px; cursor: pointer;"
                                        @onclick="() => _symbolPanelExpanded = !_symbolPanelExpanded">
                                    @(_symbolPanelExpanded ? "收起 ▲" : "展开 ▼")
                                </button>
                            </div>

                            @if (_symbolPanelExpanded)
                            {
                                <div class="d-flex align-center gap-1 flex-wrap mb-2 pa-1 rounded" style="background: rgba(148, 163, 184, 0.08); max-height: 110px; overflow-y: auto; border: 1px solid rgba(148, 163, 184, 0.2);">
                                    @foreach (var sym in GetSymbolsForCategory(_selectedSymbolCategory))
                                    {
                                        <button type="button" class="mud-button-root mud-chip-root mud-chip-default mud-chip-size-small mud-chip-outlined" 
                                                style="min-width: 26px; padding: 1px 6px; font-weight: 700; cursor: pointer; border-radius: 4px; font-family: monospace; font-size: 0.85rem;"
                                                @onclick="() => InsertSymbol(sym)"
                                                disabled="@(_submitted || _paperSubmitted)">
                                            @sym
                                        </button>
                                    }
                                </div>
                            }

                            <!-- 同步转写与微调作答输入框 -->
                            <div class="mt-2">
                                <MudTextField T="string" @bind-Value="_textAnswer" Label="作答文字内容 (由手写识别或微调输入)" Variant="Variant.Outlined" Lines="2" Disabled="@_submitted" HelperText="💡 在手写板书写后，可点击【🤖 识别为文字】转换填入，或按 Ctrl+Enter 直接提交作答" OnKeyDown="OnTextInputKeyDown" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- 常用理科符号快捷插入工具栏 (分类与响应式折叠) -->
                        <div class="d-flex align-center justify-space-between flex-wrap gap-1 mb-2">
                            <div class="d-flex align-center gap-1 flex-wrap">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mr-1">快捷符号：</MudText>
                                @foreach (var cat in _symbolCategories)
                                {
                                    <button type="button" 
                                            class="mud-button-root mud-chip-root @(_selectedSymbolCategory == cat ? "mud-chip-filled mud-chip-color-primary" : "mud-chip-outlined mud-chip-default") mud-chip-size-small" 
                                            style="height: 22px; padding: 0 8px; font-size: 0.72rem; cursor: pointer; border-radius: 12px;"
                                            @onclick="() => _selectedSymbolCategory = cat">
                                        @cat
                                    </button>
                                }
                            </div>
                            <button type="button" class="mud-button-root mud-button mud-button-text mud-button-text-default mud-button-size-small" 
                                    style="font-size: 0.72rem; padding: 0 4px; min-height: 20px; cursor: pointer;"
                                    @onclick="() => _symbolPanelExpanded = !_symbolPanelExpanded">
                                @(_symbolPanelExpanded ? "收起 ▲" : "展开 ▼")
                            </button>
                        </div>

                        @if (_symbolPanelExpanded)
                        {
                            <div class="d-flex align-center gap-1 flex-wrap mb-2 pa-1 rounded" style="background: rgba(148, 163, 184, 0.08); max-height: 110px; overflow-y: auto; border: 1px solid rgba(148, 163, 184, 0.2);">
                                @foreach (var sym in GetSymbolsForCategory(_selectedSymbolCategory))
                                {
                                    <button type="button" class="mud-button-root mud-chip-root mud-chip-default mud-chip-size-small mud-chip-outlined" 
                                            style="min-width: 26px; padding: 1px 6px; font-weight: 700; cursor: pointer; border-radius: 4px; font-family: monospace; font-size: 0.85rem;"
                                            @onclick="() => InsertSymbol(sym)"
                                            disabled="@(_submitted || _paperSubmitted)">
                                        @sym
                                    </button>
                                }
                            </div>
                        }

                        <!-- 键盘打字输入区 -->
                        int lines = q.Type == QuestionType.EssayAnalysis ? 7 : (q.Type == QuestionType.ShortAnswer ? 4 : 1);
                        string label = q.Type == QuestionType.EssayAnalysis ? "请在此处作答综合解析大题..." : (q.Type == QuestionType.ShortAnswer ? "请在此处简答要点..." : "请在此处输入填空答案...");
                        bool isMultiBlank = q.Type == QuestionType.FillInBlank && (q.Stem.Contains("①") || q.Stem.Contains("②") || q.Stem.Contains("(1)") || q.Stem.Contains("(2)") || q.Stem.Contains("（1）") || q.Stem.Contains("（2）") || q.CorrectAnswer.Contains(";") || q.CorrectAnswer.Contains("；") || q.CorrectAnswer.Contains("、"));
                        string helperText = isMultiBlank 
                            ? "💡 提示：本题包含多个填空，支持使用分号 (；)、顿号 (、) 或空格分隔各空答案；按 Enter 键交卷" 
                            : "💡 提示：支持输入 KaTeX 公式、区间/点坐标 (逗号/分号)、科学记数法及化学式；按 Enter 键快速交卷";

                        <MudTextField T="string" Value="@_textAnswer" ValueChanged="OnTextAnswerChanged" Label="@label" Variant="Variant.Outlined" Lines="@lines" Disabled="@_submitted" Class="mb-2" Immediate="true" HelperText="@helperText" OnKeyDown="OnTextInputKeyDown" />

                        @if (isMultiBlank)
                        {
                            <div class="d-flex align-center gap-1 mt-1 mb-2 px-2 py-1 rounded" style="background: rgba(16, 185, 129, 0.1); border: 1px dashed rgba(16, 185, 129, 0.4);">
                                <MudIcon Icon="@Icons.Material.Filled.TipsAndUpdates" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 600;">
                                    多空答题贴士：支持以 <b>分号 (；)</b>、<b>顿号 (、)</b> 或 <b>空格</b> 分隔各空（例如：<code>光合作用；蒸腾作用</code>），系统智能判分并支持合理顺序。
                                </MudText>
                            </div>
                        }

                        <!-- KaTeX 理科公式实时渲染预览框 -->
                        @if (!string.IsNullOrWhiteSpace(_textAnswer) && (_textAnswer.Contains("$") || _textAnswer.Contains("\\") || _textAnswer.Contains("^") || _textAnswer.Contains("_") || _textAnswer.Contains("{") || _textAnswer.Contains("√") || _textAnswer.Contains("π")))
                        {
                            <div class="pa-3 my-2 rounded-lg glass-card katex-preview-box" style="border: 1px dashed var(--mud-palette-primary); background: rgba(59, 130, 246, 0.06);">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <div class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.caption" Class="font-weight-bold" Color="Color.Primary">理科公式实时渲染预览 (KaTeX)：</MudText>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Style="height: 16px; font-size: 0.65rem;">实时解析</MudChip>
                                </div>
                                <div class="math-preview-content px-2 py-1" style="font-size: 1.05rem; line-height: 1.6; color: var(--glass-text-primary);">
                                    @_textAnswer
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- 提交与导航操作区 -->
            @if (_evaluatingAnswer || _submittingPaper)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4 pa-4 rounded-lg">
                    <div class="d-flex align-center gap-3">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                                🤖 AI 导师正在智能阅卷批改中，请稍候...
                            </MudText>
                            <MudText Typo="Typo.caption">
                                正在为您核验答案得分、分析要点切入并计算连击奖励与经验金币...
                            </MudText>
                        </div>
                    </div>
                </MudAlert>
            }

            <div class="d-flex align-center justify-space-between pt-4" style="border-top: 1px solid var(--glass-card-border);">
                <div class="d-flex align-center gap-2">
                    @if (_currentIndex > 1)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="PreviousQuestionAsync" Disabled="@(_evaluatingAnswer || _submittingPaper)">
                            上一题
                        </MudButton>
                    }
                    @if (_submitted)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Psychology" OnClick="OpenAiTutorModal">
                            AI 导师深度解析与提问
                        </MudButton>
                    }
                </div>

                <div class="d-flex gap-2 align-center">
                    @if (_evalMode.Contains("整卷统一") && !_paperSubmitted)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Flag" OnClick="SubmitWholePaperAsync" Disabled="@(_submittingPaper || _evaluatingAnswer)" Class="font-weight-bold">
                            @if (_submittingPaper)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>🤖 全卷阅卷汇总中...</span>
                            }
                            else
                            {
                                <span>提交整卷 (@_paperUserAnswers.Count/@_questions.Count)</span>
                            }
                        </MudButton>
                    }

                    @if (!_submitted)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="SubmitAnswerAsync" Disabled="@(_evaluatingAnswer || _submittingPaper)" Class="px-8 font-weight-bold" Style="border-radius: 12px;">
                            @if (_evaluatingAnswer || _submittingPaper)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>🤖 AI 智能阅卷中...</span>
                            }
                            else
                            {
                                <span>@(_evalMode.Contains("即时判定") ? "提交答案" : (_currentIndex < _questions.Count ? "保存并下一题 ➔" : "提交整卷"))</span>
                            }
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" OnClick="NextQuestionAsync" EndIcon="@Icons.Material.Filled.ArrowForward" Class="px-8 font-weight-bold" Style="border-radius: 12px;">
                            @(_currentIndex < _questions.Count ? "下一题 ➔" : "重新组卷出题 ➔")
                        </MudButton>
                    }
                </div>
            </div>

            <!-- 底部快捷键提示条 (提高刷题效率) -->
            <div class="d-flex align-center justify-center gap-4 mt-4 pt-3 mud-text-secondary flex-wrap" style="border-top: 1px dashed var(--glass-card-border); font-size: 0.8rem;">
                <span>⌨️ 快捷键：</span>
                <span><kbd class="shortcut-badge">A</kbd>-<kbd class="shortcut-badge">E</kbd> / <kbd class="shortcut-badge">1-5</kbd> 选择</span>
                <span><kbd class="shortcut-badge">T</kbd>/<kbd class="shortcut-badge">F</kbd> 判断</span>
                <span><kbd class="shortcut-badge">M</kbd> 收藏</span>
                <span><kbd class="shortcut-badge">Enter</kbd> 提交作答</span>
                <span><kbd class="shortcut-badge">Ctrl+Enter</kbd> 文本直接交卷</span>
                <span><kbd class="shortcut-badge">Space</kbd> / <kbd class="shortcut-badge">→</kbd> 下一题</span>
                <span><kbd class="shortcut-badge">←</kbd> 上一题</span>
                <span><kbd class="shortcut-badge">?</kbd> 帮助</span>
            </div>
        </div>

        <!-- 提交后的即时正向反馈结算卡片 -->
        <!-- 提交后的即时正向反馈结算卡片 (UX 专家级交互微反馈与心理学正向赋能) -->
        @if (_submitted && _lastResult != null)
        {
            <div class="glass-card pa-6 mb-6" style="@(_lastResult.IsCorrect ? "border-color: rgba(34, 197, 94, 0.4); background: rgba(34, 197, 94, 0.1);" : "border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1);")">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@(_lastResult.IsCorrect ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(_lastResult.IsCorrect ? Color.Success : Color.Error)" Size="Size.Large" />
                        <div>
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Color="@(_lastResult.IsCorrect ? Color.Success : Color.Error)">
                                    @(_lastResult.IsCorrect ? "回答正确！正向经验爆表！" : "再接再厉！已被归集入错题净化副本。")
                                </MudText>
                                @if (_lastResult.IsCorrect && _lastResult.Reward.CurrentCombo > 1)
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.LocalFireDepartment" Class="font-weight-bold">
                                        @_lastResult.Reward.CurrentCombo 连击达成！
                                    </MudChip>
                                }
                                @if (_lastResult.Reward.ExpBoostActive)
                                {
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Bolt">
                                        双倍经验加成中
                                    </MudChip>
                                }
                                @if (_lastResult.Reward.GoldBoostActive)
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.MonetizationOn">
                                        双倍金币加成中
                                    </MudChip>
                                }
                                 @if (_lastResult.IsEquivalentMatch)
                                 {
                                     <MudTooltip Text="@(!string.IsNullOrWhiteSpace(_lastResult.EquivalentMatchReason) ? _lastResult.EquivalentMatchReason : "经智能数理判题引擎校验，作答与标准答案完全等价！")" Placement="Placement.Top">
                                         <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Verified" Class="font-weight-bold" Style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(5, 150, 105, 0.3)); border: 1px solid #10b981;">
                                             🎯 智能等价：@(!string.IsNullOrWhiteSpace(_lastResult.EquivalentMatchReason) ? _lastResult.EquivalentMatchReason : "多形式精准匹配")
                                         </MudChip>
                                     </MudTooltip>
                                 }
                                 @if (!string.IsNullOrEmpty(_lastResult.CognitiveBadgeText))
                                 {
                                     <MudChip T="string" Color="@(_lastResult.CognitiveClassification == "AgileMastery" ? Color.Success : (_lastResult.CognitiveClassification == "SteadyMastery" ? Color.Info : (_lastResult.CognitiveClassification == "Careless" ? Color.Warning : Color.Error)))" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">
                                         @_lastResult.CognitiveBadgeText
                                     </MudChip>
                                 }
                            </div>
                            @if (_lastResult.IsCorrect)
                            {
                                <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="font-weight-bold mt-1">
                                    获得 +@_lastResult.Reward.EarnedExp EXP 和 +@_lastResult.Reward.EarnedCoins 金币！
                                    @if (_lastResult.Reward.LeveledUp)
                                    {
                                        <span>🎉 恭喜你升级到了 Lv.@_lastResult.Reward.NewLevel ！</span>
                                    }
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
                                    🧠 艾宾浩斯抗遗忘记忆曲线已启动！该题已进入净化记忆队列，攻克后可获丰厚净化经验。
                                </MudText>
                            }
                        </div>
                    </div>

                    <div class="d-flex align-center gap-2 flex-wrap">
                        @if (_lastResult.SubjectiveGrading != null)
                        {
                            <MudChip T="string" Color="@(_lastResult.SubjectiveGrading.Score >= 80 ? Color.Success : (_lastResult.SubjectiveGrading.Score >= 60 ? Color.Warning : Color.Error))" Variant="Variant.Filled" Style="font-weight: 800; font-size: 1.1rem;">
                                🤖 AI 评分: @_lastResult.SubjectiveGrading.Score 分
                            </MudChip>
                        }
                    </div>
                </div>

                @if (_lastResult.SubjectiveGrading != null)
                {
                    <div class="pa-4 my-3 glass-card" style="background: var(--sub-card-bg); border-left: 4px solid #3b82f6;">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1" Color="Color.Info">🤖 AI 深度批改意见与切入点：</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@_lastResult.SubjectiveGrading.Feedback</MudText>

                        @if (_lastResult.SubjectiveGrading.RubricBreakdown?.Count > 0)
                        {
                            <div class="d-flex align-center gap-2 flex-wrap mb-2">
                                @foreach (var r in _lastResult.SubjectiveGrading.RubricBreakdown)
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">@r</MudChip>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_lastResult.SubjectiveGrading.EncouragementAdvice))
                        {
                            <div class="d-flex align-center gap-2 py-1 px-3 mb-2 rounded" style="background: rgba(59, 130, 246, 0.08); border: 1px dashed rgba(59, 130, 246, 0.3);">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiObjects" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--mud-palette-primary);">
                                    💡 进阶建议：@_lastResult.SubjectiveGrading.EncouragementAdvice
                                </MudText>
                            </div>
                        }

                        @if (_lastResult.SubjectiveGrading.MissingPoints.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block font-weight-bold mb-1">⚠️ 缺少的关键要点：</MudText>
                            <ul style="padding-left: 20px; font-size: 0.85rem;" class="mud-text-secondary">
                                @foreach (var p in _lastResult.SubjectiveGrading.MissingPoints)
                                {
                                    <li>@p</li>
                                }
                            </ul>
                        }
                    </div>
                }

                @if (_lastResult.IsEquivalentMatch)
                {
                    <div class="pa-3 my-3 rounded-lg" style="background: rgba(16, 185, 129, 0.08); border-left: 4px solid #10b981; border: 1px dashed rgba(16, 185, 129, 0.3);">
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Success">
                                🎯 智能等价表达认可
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="mud-text-primary">
                            @(!string.IsNullOrWhiteSpace(_lastResult.EquivalentMatchReason) 
                                ? _lastResult.EquivalentMatchReason 
                                : "系统智能代数/符号比对引擎已确认：您的作答表述与标准答案本质等价，已判定为正确并授予全额经验！")
                        </MudText>
                    </div>
                }

                <MudText Typo="Typo.body2" Class="mt-2">
                    <strong>标准答案：</strong> @_lastResult.StandardAnswer
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                    <strong>官方解析：</strong> @_lastResult.Analysis
                </MudText>

                @if (!_lastResult.IsCorrect)
                {
                    <div class="pa-3 my-3 rounded-lg" style="background: rgba(239, 68, 68, 0.08); border-left: 4px solid #ef4444; border: 1px dashed rgba(239, 68, 68, 0.3);">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #f87171;">
                                    💡 错因速记自省归纳 (错题本同步分类)：
                                </MudText>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_selectedInstantErrorReason))
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                    ✓ 已标记为：@_selectedInstantErrorReason
                                </MudChip>
                            }
                        </div>
                        <div class="d-flex align-center gap-2 flex-wrap">
                            @foreach (var rReason in _quickErrorReasons)
                            {
                                <button type="button" 
                                        class="mud-button-root mud-chip-root @(_selectedInstantErrorReason == rReason ? "mud-chip-filled mud-chip-color-error font-weight-bold" : "mud-chip-outlined mud-chip-default") mud-chip-size-small" 
                                        style="cursor: pointer; border-radius: 12px; font-size: 0.78rem; padding: 4px 10px;"
                                        @onclick="() => SetInstantErrorReasonAsync(rReason)">
                                    @rReason
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- 结算快捷行动栏 (提升学习与消化即时性) -->
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-4 pt-3" style="border-top: 1px dashed var(--glass-card-border);">
                    <div class="d-flex align-center gap-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Psychology" OnClick="OpenAiTutorModal">
                            💡 召唤 AI 导师深度启发
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="@(_isFavorited ? Color.Warning : Color.Default)" Size="Size.Small" StartIcon="@(_isFavorited ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" OnClick="ToggleFavoriteCurrentAsync">
                            @(_isFavorited ? "已收藏本题" : "收藏本题")
                        </MudButton>
                    </div>
                    @if (_currentIndex < _questions.Count)
                    {
                        <MudButton Variant="Variant.Filled" Color="@(_lastResult.IsCorrect ? Color.Success : Color.Primary)" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="NextQuestionAsync">
                            下一题 ➔
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.EmojiEvents" OnClick="OpenVictoryDialogAsync">
                            查看学情战报 🏆
                        </MudButton>
                    }
                </div>
            </div>
        }
    }
</MudContainer>

<!-- AI 导师深度解析与对话 Modal 弹窗 (含苏格拉底模式、前置知识图谱溯源与 Web Speech 语音导师) -->
<MudDialog @bind-Visible="_aiDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    @(_useSocraticMode ? "🧠 AI 导师 - 苏格拉底式启发引导" : "🤖 AI 导师 - 标准深度剖析")
                </MudText>
            </div>
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Outlined" Color="@(_useSocraticMode ? Color.Secondary : Color.Default)" Size="Size.Small" OnClick="ToggleModalSocraticModeAsync" Style="font-size: 0.8rem; font-weight: 700;">
                    @(_useSocraticMode ? "切换为标准直击解析" : "切换为苏格拉底引导")
                </MudButton>
                <MudTooltip Text="🔊 语音朗读 AI 回复">
                    <MudIconButton Icon="@Icons.Material.Filled.VolumeUp" Color="Color.Primary" Size="Size.Small" OnClick="SpeakCurrentAiContentAsync" />
                </MudTooltip>
                <MudTooltip Text="🛑 停止朗读">
                    <MudIconButton Icon="@Icons.Material.Filled.VolumeOff" Color="Color.Default" Size="Size.Small" OnClick="StopSpeakingAsync" />
                </MudTooltip>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_aiLoading)
        {
            <div class="d-flex flex-column align-center my-8 gap-3">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">AI 导师正在深入剖析你的思路与考点...</MudText>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4" style="max-height: 60vh; overflow-y: auto;">
                <!-- 前置知识图谱溯源预警 Banner -->
                @if (_prerequisiteWarnings.Count > 0)
                {
                    <div class="pa-4 glass-card" style="background: rgba(245, 158, 11, 0.12); border-left: 4px solid #f59e0b; border-color: rgba(245, 158, 11, 0.3);">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Warning" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Warning">
                                🔗 前置知识图谱溯源警报 (前置概念薄弱)
                            </MudText>
                        </div>
                        @foreach (var warn in _prerequisiteWarnings)
                        {
                            <MudText Typo="Typo.body2" Class="mb-1">
                                @warn.ActionAdvice
                            </MudText>
                        }
                    </div>
                }

                @if (_useSocraticMode && _socraticResult != null)
                {
                    <!-- 苏格拉底模式卡片 -->
                    <div class="pa-4 glass-card" style="background: var(--sub-card-bg); border-left: 4px solid #ec4899;">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #ec4899;">
                            @_socraticResult.ThinkingHint
                        </MudText>
                    </div>

                    <div class="pa-4 glass-card" style="background: rgba(236, 72, 153, 0.08); border: 1px dashed rgba(236, 72, 153, 0.3);">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Color="Color.Secondary">
                            🤔 请结合以下 2-3 个循序渐进的问题自查思考：
                        </MudText>
                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < _socraticResult.ProgressiveQuestions.Count; i++)
                            {
                                var qText = _socraticResult.ProgressiveQuestions[i];
                                <div class="d-flex align-start gap-2">
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Style="font-weight: 800; min-width: 24px;">#@(i + 1)</MudChip>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="line-height: 1.6;">@qText</MudText>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="pa-3 rounded glass-card">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @_socraticResult.ReflectionPrompt
                        </MudText>
                    </div>
                }
                else if (_aiResult != null)
                {
                    <!-- 标准直接解析卡片 -->
                    <div class="pa-4 glass-card" style="background: var(--sub-card-bg); border-left: 4px solid #8b5cf6;">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1" Color="Color.Secondary">
                            @_aiResult.Summary
                        </MudText>
                    </div>

                    @if (!string.IsNullOrEmpty(_aiResult.WhyWrongAnalysis))
                    {
                        <div class="pa-4 glass-card" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3);">
                            <MudText Typo="Typo.body2" Style="white-space: pre-line;" Color="Color.Error">
                                @_aiResult.WhyWrongAnalysis
                            </MudText>
                        </div>
                    }

                    <div class="pa-4 glass-card">
                        <MudText Typo="Typo.body2" Style="white-space: pre-line;">
                            @_aiResult.StepByStepReasoning
                        </MudText>
                    </div>
                }

                <!-- 交互式向 AI 追问 (支持 Web Speech 🎤 按住/点击说话与 🔊 朗读) -->
                <div class="mt-4 pt-4" style="border-top: 1px solid var(--glass-card-border);">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">向 AI 追问 (支持语音/文字)：</MudText>
                        <MudChip T="string" Color="@(_isRecordingVoice ? Color.Error : Color.Info)" Size="Size.Small" OnClick="ToggleVoiceRecordingAsync" Style="cursor: pointer; font-weight: 700;">
                            @(_isRecordingVoice ? "🎤 正在聆听录音中... (点击结束)" : "🎤 点击/按住语音输入")
                        </MudChip>
                    </div>

                    <!-- 快捷追问建议气泡 -->
                    <div class="d-flex align-center gap-2 flex-wrap mb-2">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Style="cursor: pointer; font-size: 0.75rem;" OnClick='() => QuickAskAiAsync("请给我这道题的详细解题思路和突破口提示")'>
                            💡 解题思路提示
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Style="cursor: pointer; font-size: 0.75rem;" OnClick='() => QuickAskAiAsync("请总结本题考察的核心考点与常见易错陷阱")'>
                            📌 核心考点与易错坑
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Style="cursor: pointer; font-size: 0.75rem;" OnClick='() => QuickAskAiAsync("请列出解这道题需要用到的公式、定理与判定依据")'>
                            📐 相关公式与定理
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Style="cursor: pointer; font-size: 0.75rem;" OnClick='() => QuickAskAiAsync("请给我一道举一反三的类似例题并讲解")'>
                            🔍 举一反三类比题
                        </MudChip>
                    </div>

                    <div class="d-flex gap-2">
                        <MudTextField T="string" @bind-Value="_userPrompt" Placeholder="例如：第一步推导中的公式是怎么代入的？" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="AskAiAsync" Disabled="@_askingAi">
                            @if (_askingAi) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> } else { <span>发送</span> }
                        </MudButton>
                    </div>
                    @if (!string.IsNullOrEmpty(_aiAnswer))
                    {
                        <div class="mt-3 pa-3 glass-card" style="background: rgba(30, 41, 59, 0.9);">
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="font-weight-bold">🤖 AI 导师追问解答：</MudText>
                                <MudTooltip Text="朗读追问解答">
                                    <MudIconButton Icon="@Icons.Material.Filled.VolumeUp" Color="Color.Info" Size="Size.Small" OnClick="() => SpeakAiTextAsync(_aiAnswer)" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.body2" Style="white-space: pre-line;">@_aiAnswer</MudText>
                        </div>
                    }
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _aiDialogVisible = false" Color="Color.Primary">关闭</MudButton>
    </DialogActions>
</MudDialog>

<!-- 🎉 本轮闯关结算荣誉成绩单 (Session Victory Report Modal) -->
<MudDialog @bind-Visible="_victoryDialogVisible" Options="_victoryDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">🎉 闯关完成！本轮学情战报</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-2">
            <!-- 评级大横幅 -->
            <div class="victory-card-header">
                <div class="victory-rank-badge mb-1">
                    @GetSessionRankBadge()
                </div>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
                    @GetSessionTitleText()
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                    【@(_currentUser?.Grade ?? "年级")】@_selectedSubject - @_selectedCategory
                </MudText>
            </div>

            <!-- 数据明细网格 -->
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <div class="pa-3 rounded-lg text-center glass-card">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">本次正确率</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="@(_sessionCorrectCount == _questions.Count && _questions.Count > 0 ? Color.Success : Color.Primary)">
                            @(_questions.Count > 0 ? (int)((double)_sessionCorrectCount / _questions.Count * 100) : 0)%
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_sessionCorrectCount / @_questions.Count 题</MudText>
                    </div>
                </MudItem>

                <MudItem xs="6" sm="3">
                    <div class="pa-3 rounded-lg text-center glass-card">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">获得经验</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">
                            +@_sessionEarnedExp
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">EXP 经验值</MudText>
                    </div>
                </MudItem>

                <MudItem xs="6" sm="3">
                    <div class="pa-3 rounded-lg text-center glass-card">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">获得金币</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Secondary">
                            +@_sessionEarnedCoins
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Coins 虚拟币</MudText>
                    </div>
                </MudItem>

                <MudItem xs="6" sm="3">
                    <div class="pa-3 rounded-lg text-center glass-card">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">最高连击</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">
                            🔥 @_sessionMaxCombo
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Max Combo</MudText>
                    </div>
                </MudItem>
            </MudGrid>

            <!-- 认知科学作答归因四象限分析 -->
            @if (_sessionAgileCount + _sessionSteadyCount + _sessionCarelessCount + _sessionStrugglingCount > 0)
            {
                <div class="pa-3 rounded-lg glass-card" style="background: rgba(var(--mud-palette-surface-rgb), 0.4); border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.2);">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">
                            🧠 认知负荷与作答节奏归因 (四象限分布)
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                            科学诊断
                        </MudChip>
                    </div>
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3">
                            <div class="pa-2 text-center rounded" style="background: rgba(34, 197, 94, 0.1); border: 1px solid #22c55e;">
                                <MudText Typo="Typo.caption" Style="color: #22c55e; font-weight: 700;">⚡ 敏捷秒杀</MudText>
                                <MudText Typo="Typo.h6" Style="color: #22c55e; font-weight: 800;">@_sessionAgileCount 题</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem;">耗时短且全对</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="pa-2 text-center rounded" style="background: rgba(59, 130, 246, 0.1); border: 1px solid #3b82f6;">
                                <MudText Typo="Typo.caption" Style="color: #3b82f6; font-weight: 700;">🧘 稳健深思</MudText>
                                <MudText Typo="Typo.h6" Style="color: #3b82f6; font-weight: 800;">@_sessionSteadyCount 题</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem;">从容思考答对</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="pa-2 text-center rounded" style="background: rgba(245, 158, 11, 0.1); border: 1px solid #f59e0b;">
                                <MudText Typo="Typo.caption" Style="color: #f59e0b; font-weight: 700;">⚠️ 急躁粗心</MudText>
                                <MudText Typo="Typo.h6" Style="color: #f59e0b; font-weight: 800;">@_sessionCarelessCount 题</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem;">快速失误陷阱</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="pa-2 text-center rounded" style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444;">
                                <MudText Typo="Typo.caption" Style="color: #ef4444; font-weight: 700;">🧩 攻坚盲区</MudText>
                                <MudText Typo="Typo.h6" Style="color: #ef4444; font-weight: 800;">@_sessionStrugglingCount 题</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem;">耗时长未攻克</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                    @if (!string.IsNullOrWhiteSpace(_sessionPaceAdvice))
                    {
                        <div class="mt-2 pa-2 rounded" style="background: rgba(var(--mud-palette-primary-rgb), 0.08); font-size: 0.8rem; color: var(--mud-palette-text-primary);">
                            @_sessionPaceAdvice
                        </div>
                    }
                </div>
            }

            <!-- 进阶行动建议 -->
            <div class="pa-3 rounded-lg glass-card" style="background: var(--sub-card-bg);">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1" Color="Color.Info">
                    💡 AI 导师学情建议：
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @if (_sessionCorrectCount == _questions.Count && _questions.Count > 0)
                    {
                        <span>太强了！本轮题目全对通关，当前考点掌握度大幅跃升！建议前往荣誉中心装备新称号或挑战更高难度。</span>
                    }
                    else
                    {
                        <span>本次共产生 @(_questions.Count - _sessionCorrectCount) 道错题，已自动沉淀到「错题净化副本」，建议趁热打铁进行专项消灭！</span>
                    }
                </MudText>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        @if (GetSessionWrongCount() > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Bolt" OnClick="RetryCurrentSessionErrorsAsync" Style="font-weight: 700; box-shadow: 0 0 12px rgba(239, 68, 68, 0.4);">
                ⚡ 立即重练本轮错题 (@GetSessionWrongCount() 题)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="GoToErrorBookFromVictory">
                前往错题本净化
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RestartPracticeSession">
            再来一组新题
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Analytics" OnClick='() => NavigationManager.NavigateTo("/practice-records")'>
            查看学情战报
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Home" OnClick='() => NavigationManager.NavigateTo("/")'>
            返回主面板
        </MudButton>
        <MudButton OnClick="() => _victoryDialogVisible = false" Color="Color.Default">
            关闭
        </MudButton>
    </DialogActions>
</MudDialog>

