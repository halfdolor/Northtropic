    private async Task RecognizeHandwritingOcrAsync()
    {
        if (_isRecognizingOcr) return;
        _isRecognizingOcr = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // 1. 优先尝试前端超低延迟矢量手写识别（支持汉字、多词组与公式）
            string strokeResult = "";
            try
            {
                strokeResult = await JSRuntime.InvokeAsync<string>("recognizeHandwritingStrokes", "handwritingCanvas");
            }
            catch { }

            if (!string.IsNullOrWhiteSpace(strokeResult))
            {
                if (string.IsNullOrWhiteSpace(_textAnswer) || _textAnswer.StartsWith("["))
                {
                    _textAnswer = strokeResult;
                }
                else
                {
                    _textAnswer += " " + strokeResult;
                }
                Snackbar.Add($"✍️ 识别成功：【{strokeResult}】", Severity.Success);
                return;
            }

            // 2. 尝试服务端大模型多模态视觉 / 百度智能云 OCR
            var dataUrl = await JSRuntime.InvokeAsync<string>("getScratchpadOcrDataUrl", "handwritingCanvas");
            if (string.IsNullOrWhiteSpace(dataUrl))
            {
                dataUrl = await JSRuntime.InvokeAsync<string>("getScratchpadDataUrl", "handwritingCanvas");
            }

            if (string.IsNullOrWhiteSpace(dataUrl) || !dataUrl.Contains(","))
            {
                Snackbar.Add("提示：请先在手写板上书写您的作答内容！", Severity.Warning);
                return;
            }

            var base64 = dataUrl.Substring(dataUrl.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64);

            string recognizedText = await QuestionImportService.RecognizeHandwritingTextAsync(bytes, CurrentQuestion?.Subject);

            if (!string.IsNullOrWhiteSpace(recognizedText))
            {
                if (string.IsNullOrWhiteSpace(_textAnswer) || _textAnswer.StartsWith("["))
                {
                    _textAnswer = recognizedText;
                }
                else
                {
                    _textAnswer += " " + recognizedText;
                }
                Snackbar.Add($"✍️ 识别成功：【{recognizedText}】", Severity.Success);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_textAnswer))
                {
                    _textAnswer = "[手写作答已保存]";
                }
                Snackbar.Add("已记录并保存手写笔迹！", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            if (string.IsNullOrWhiteSpace(_textAnswer))
            {
                _textAnswer = "[手写作答已保存]";
            }
            Snackbar.Add($"手写已保存: {ex.Message}", Severity.Info);
        }
        finally
        {
            _isRecognizingOcr = false;
            await InvokeAsync(StateHasChanged);
        }
    }

