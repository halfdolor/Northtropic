    private bool _evaluatingAnswer = false;
    private bool _submittingPaper = false;

    private async Task SubmitCurrentAnswerAsync(bool isTimeout = false)
    {
        if (_submitted || _questions.Count == 0 || _evaluatingAnswer) return;

        if (!isTimeout && _subjectiveInputMode == "handwriting" && string.IsNullOrWhiteSpace(_textAnswer))
        {
            try
            {
                bool hasDrawing = await JSRuntime.InvokeAsync<bool>("hasScratchpadContent", "handwritingCanvas");
                if (hasDrawing)
                {
                    await RecognizeHandwritingOcrAsync();
                }
            }
            catch { }
        }

        string finalAnswer = isTimeout ? "(超时未作答)" : GetFinalUserAnswer();
        if (!isTimeout && string.IsNullOrWhiteSpace(finalAnswer))
        {
            Snackbar.Add("请先选择或填写你的答案！", Severity.Warning);
            return;
        }

        _evaluatingAnswer = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            int timeTaken = (int)(DateTime.Now - _startTime).TotalSeconds;
            _lastResult = await PracticeService.SubmitAnswerAsync(CurrentQuestion, finalAnswer, timeTaken, _currentCombo);

            if (!string.IsNullOrEmpty(_lastResult.Reward.InsufficientCoinsError))
            {
                _submitted = false;
                Snackbar.Add(_lastResult.Reward.InsufficientCoinsError, Severity.Warning, config =>
                {
                    config.Action = "去净化错题赚金币";
                    config.ActionColor = Color.Warning;
                    config.Onclick = snackbar =>
                    {
                        NavigationManager.NavigateTo("/error-book");
                        return Task.CompletedTask;
                    };
                });
                return;
            }

            _submitted = true;
            _instantEvalResults[_currentIndex] = _lastResult;
            _currentUser = await GamificationService.GetCurrentUserAsync();

            if (_lastResult.IsCorrect)
            {
                _sessionCorrectCount++;
                _sessionEarnedExp += _lastResult.Reward.EarnedExp;
                _sessionEarnedCoins += _lastResult.Reward.EarnedCoins;

                _currentCombo = _lastResult.Reward.CurrentCombo;
                if (_currentCombo > _sessionMaxCombo) _sessionMaxCombo = _currentCombo;

                if (_currentUser.SoundEffectsEnabled)
                {
                    await JSRuntime.InvokeVoidAsync("playRewardAudio", _currentCombo > 2 ? "combo" : "correct");
                }
                if (_currentUser.ConfettiEnabled)
                {
                    await JSRuntime.InvokeVoidAsync("triggerConfetti");
                }
                string paidNote = _lastResult.Reward.IsPaidQuestion ? $" (已扣除入场费 {_lastResult.Reward.PaidEntryFee} 金币)" : "";
                Snackbar.Add($"🎉 答对啦！获得 +{_lastResult.Reward.EarnedExp} EXP，+{_lastResult.Reward.EarnedCoins} 金币{paidNote}", Severity.Success);
            }
            else
            {
                _sessionEarnedCoins += _lastResult.Reward.EarnedCoins;

                if (_lastResult.Reward.ComboShieldUsed)
                {
                    _currentCombo = _lastResult.Reward.CurrentCombo;
                    if (_currentCombo > _sessionMaxCombo) _sessionMaxCombo = _currentCombo;
                    Snackbar.Add($"🛡️ 答错！已消耗 1 张【连击保护符】，连击 {_currentCombo} 保持不中断！", Severity.Warning);
                }
                else
                {
                    _currentCombo = 0;
                }

                if (_currentUser.SoundEffectsEnabled)
                {
                    await JSRuntime.InvokeVoidAsync("playRewardAudio", "wrong");
                }

                int penaltyCoins = Math.Abs(_lastResult.Reward.EarnedCoins);
                string paidNote = _lastResult.Reward.IsPaidQuestion ? $" (已扣除入场费 {_lastResult.Reward.PaidEntryFee} 金币)" : "";
                Snackbar.Add($"❌ 答错/超时！扣除 -{penaltyCoins} 金币{paidNote}，题目已放入错题净化副本", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"判题校验异常: {ex.Message}", Severity.Error);
        }
        finally
        {
            _evaluatingAnswer = false;
            await InvokeAsync(StateHasChanged);
        }
    }

