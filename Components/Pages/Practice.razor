    private void StopTimers()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private void HandleCurriculumChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_currentUser != null)
            {
                _subjects = GradeSubjectProvider.GetSubjectsByGrade(_currentUser.Grade);
                RefreshCategoriesForSubject(_selectedSubject);
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        CurriculumConfigService.OnCurriculumChanged -= HandleCurriculumChanged;
        StopTimers();
        if (_dotNetRef != null)
        {
            try
            {
                _ = JSRuntime.InvokeVoidAsync("unregisterKeyboardShortcuts");
            }
            catch { }
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
