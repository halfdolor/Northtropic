                    <MudChip T="int" Color="@(_rewardCoins == 100 ? Color.Primary : Color.Default)" Variant="@(_rewardCoins == 100 ? Variant.Filled : Variant.Outlined)" Style="cursor: pointer;" OnClick="() => _rewardCoins = 100">🪙 +100 金币 (大奖)</MudChip>
