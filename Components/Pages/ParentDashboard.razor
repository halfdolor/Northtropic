    private async Task UpdateCategoriesForSubjectAsync(string subject)
    {
        try
        {
            var categories = await CurriculumConfigService.GetCategoriesBySubjectAsync(subject);
            if (categories.Any())
            {
                _availableCategories = categories.Where(c => c != "全部").ToList();
            }
            else
            {
                var questions = await PracticeService.GetCategoriesBySubjectAsync(subject);
                _availableCategories = questions.Where(c => !string.IsNullOrWhiteSpace(c) && c != "全部").ToList();
            }
            if (!_availableCategories.Contains(_assignCategory))
            {
                _assignCategory = _availableCategories.FirstOrDefault() ?? "综合考点";
            }
        }
        catch
        {
            _availableCategories = new List<string> { "综合考点", "基础概念", "拔高冲刺" };
        }
    }

