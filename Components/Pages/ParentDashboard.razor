        else if (presetType == 2) // 基础夯实
        {
            _assignTitle = $"{_assignSubject} · 基础核心知识过关练";
            _assignCount = 10;
            _assignDifficulty = 2;
            _assignNote = $"稳扎稳打夯实基本功，细心审题，争取全对！";
        }
