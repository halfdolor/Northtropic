<!-- 打印/导出学情周报弹窗 -->
<MudDialog @bind-Visible="_showWeeklyReportDialog" Options="_weeklyReportDialogOptions">
    <TitleContent>
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 no-print">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Info" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">📊 学情成长周报与提分诊断 · 打印预览</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="TriggerReportPrintAsync" Class="font-weight-bold">
                立即调用打印机 / 导出 PDF
            </MudButton>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedStudent != null)
        {
            <div class="printable-sheet pa-6" style="background: #ffffff; color: #111827; border-radius: 8px; font-family: 'Outfit', 'Noto Sans SC', -apple-system, serif;">
                <!-- 报告抬头 -->
                <div style="text-align: center; border-bottom: 2px solid #3b82f6; padding-bottom: 12px; margin-bottom: 20px;">
                    <h2 style="margin: 0 0 6px 0; font-size: 1.6rem; font-weight: 800; color: #1e3a8a;">Northtropic 智能研学 · 阶段学情成长与提分诊断报告</h2>
                    <div style="display: flex; justify-content: space-around; font-size: 0.9rem; color: #4b5563; margin-top: 8px; flex-wrap: gap: 8px;">
                        <span>学员姓名：<strong>@_selectedStudent.Username</strong></span>
                        <span>就读年级：<strong>@_selectedStudent.Grade</strong></span>
                        <span>专属绑定码：<strong>@_selectedStudent.BindingCode</strong></span>
                        <span>报告生成时间：<strong>@DateTime.Today.ToString("yyyy年MM月dd日")</strong></span>
                    </div>
                </div>

                <!-- 核心数据矩阵 (4宫格) -->
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px;">
                    <div style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 6px; text-align: center; background: #f8fafc;">
                        <div style="font-size: 0.8rem; color: #64748b;">答题正确率</div>
                        <div style="font-size: 1.4rem; font-weight: 800; color: #2563eb; margin: 4px 0;">
                            @(_selectedStudent.TotalAnswered > 0 ? (int)((double)_selectedStudent.TotalCorrect / _selectedStudent.TotalAnswered * 100) : 0)%
                        </div>
                        <div style="font-size: 0.75rem; color: #64748b;">累计 @_selectedStudent.TotalCorrect / @_selectedStudent.TotalAnswered 题</div>
                    </div>
                    <div style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 6px; text-align: center; background: #f8fafc;">
                        <div style="font-size: 0.8rem; color: #64748b;">已净化消灭错题</div>
                        <div style="font-size: 1.4rem; font-weight: 800; color: #16a34a; margin: 4px 0;">
                            @_selectedStudent.ResolvedErrorsCount 题
                        </div>
                        <div style="font-size: 0.75rem; color: #64748b;">薄弱考点转化巩固</div>
                    </div>
                    <div style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 6px; text-align: center; background: #f8fafc;">
                        <div style="font-size: 0.8rem; color: #64748b;">连续打卡天数</div>
                        <div style="font-size: 1.4rem; font-weight: 800; color: #d97706; margin: 4px 0;">
                            @_selectedStudent.CurrentStreak 天
                        </div>
                        <div style="font-size: 0.75rem; color: #64748b;">最高连击 @_selectedStudent.MaxCombo 连胜</div>
                    </div>
                    <div style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 6px; text-align: center; background: #f8fafc;">
                        <div style="font-size: 0.8rem; color: #64748b;">成长等级与积分</div>
                        <div style="font-size: 1.4rem; font-weight: 800; color: #7c3aed; margin: 4px 0;">
                            Lv.@_selectedStudent.Level
                        </div>
                        <div style="font-size: 0.75rem; color: #64748b;">金币: @_selectedStudent.Coins | 经验: @_selectedStudent.Exp</div>
                    </div>
                </div>

                <!-- AI 智能学情诊断与提分路径 -->
                <div style="border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 6px; padding: 14px; margin-bottom: 20px;">
                    <div style="font-weight: 700; font-size: 0.95rem; color: #1d4ed8; margin-bottom: 4px;">
                        💡 AI 智能研学引擎学情诊断分析：
                        @if (_diagnosisReport != null)
                        {
                            <span style="font-size: 0.85rem; color: #d97706; margin-left: 8px;">(综合能力评级: @_diagnosisReport.StarRating.ToString("F1") 星)</span>
                        }
                    </div>
                    <div style="font-size: 0.9rem; line-height: 1.6; color: #1e293b; white-space: pre-wrap;">
                        @if (_diagnosisReport != null && !string.IsNullOrWhiteSpace(_diagnosisReport.AiGrowthAdvice))
                        {
                            <span>@_diagnosisReport.AiGrowthAdvice</span>
                        }
                        else if (_selectedStudent.TotalAnswered == 0)
                        {
                            <span>孩子当前尚未开启刷题练习，建议引导孩子使用【AI 智能刷题中心】完成首轮能力评测。</span>
                        }
                        else if ((double)_selectedStudent.TotalCorrect / _selectedStudent.TotalAnswered >= 0.8)
                        {
                            <span>孩子在 <strong>@_selectedStudent.Grade</strong> 课程知识掌握非常扎实（正确率 @((int)((double)_selectedStudent.TotalCorrect / _selectedStudent.TotalAnswered * 100))%），打卡连胜达到 @_selectedStudent.CurrentStreak 天！建议保持当前节奏，尝试挑战高星拔高题目。</span>
                        }
                        else
                        {
                            <span>孩子在近期答题中表现出部分知识点薄弱，累计积累了错题，目前已成功净化 @_selectedStudent.ResolvedErrorsCount 道错题。建议提醒孩子多使用【错题净化副本】功能进行 AI Tutor 的互动巩固。</span>
                        }
                    </div>
                </div>

                <!-- 各学科掌握度明细表格 -->
                <div style="margin-bottom: 20px;">
                    <div style="font-weight: 700; font-size: 0.95rem; color: #0f172a; margin-bottom: 8px;">
                        📊 学科知识点作答掌握度全景：
                    </div>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                        <thead>
                            <tr style="background: #f1f5f9; text-align: left;">
                                <th style="padding: 8px; border: 1px solid #cbd5e1;">学科名称</th>
                                <th style="padding: 8px; border: 1px solid #cbd5e1;">答对题数 / 总做题数</th>
                                <th style="padding: 8px; border: 1px solid #cbd5e1;">作答正确率</th>
                                <th style="padding: 8px; border: 1px solid #cbd5e1;">掌握度评级</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_subjectMasteries.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="padding: 12px; text-align: center; color: #94a3b8; border: 1px solid #cbd5e1;">暂无学科细分数据</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var sub in _subjectMasteries)
                                {
                                    int rate = (int)sub.AccuracyRate;
                                    string rating = rate >= 85 ? "优秀 (掌握扎实)" : (rate >= 60 ? "良好 (需强化拔高)" : "待加强 (需重点攻坚)");
                                    string rateColor = rate >= 85 ? "#16a34a" : (rate >= 60 ? "#d97706" : "#dc2626");
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #cbd5e1; font-weight: 600;">@sub.Subject</td>
                                        <td style="padding: 8px; border: 1px solid #cbd5e1;">@sub.CorrectCount / @sub.TotalCount 题</td>
                                        <td style="padding: 8px; border: 1px solid #cbd5e1; font-weight: 700; color: @rateColor;">@rate%</td>
                                        <td style="padding: 8px; border: 1px solid #cbd5e1; color: @rateColor; font-weight: 500;">@rating</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 家长寄语与签字 -->
                <div style="border-top: 1px dashed #cbd5e1; padding-top: 16px; margin-top: 24px; display: flex; justify-content: space-between; align-items: flex-end; font-size: 0.88rem; color: #475569;">
                    <div>
                        <div>💌 家长鼓励寄语：<strong>@(!string.IsNullOrWhiteSpace(_selectedStudent.ParentEncouragementNote) ? _selectedStudent.ParentEncouragementNote : "继续加油，保持自律与好奇心！")</strong></div>
                    </div>
                    <div style="text-align: right; min-width: 200px;">
                        <div>家长签名确认：____________________</div>
                        <div style="margin-top: 8px;">指导教师查阅：____________________</div>
                    </div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-end gap-2 w-100 no-print">
            <MudButton OnClick="() => _showWeeklyReportDialog = false">关闭</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="TriggerReportPrintAsync" Class="font-weight-bold">
                立即打印 / 导出 PDF
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

