@page "/parent-dashboard"
@using Northtropic.Models
@using Northtropic.Services
@using Microsoft.EntityFrameworkCore
@inject IUserSessionService UserSessionService
@inject IPracticeService PracticeService
@inject ICurriculumConfigService CurriculumConfigService
@inject IStudentEvolutionService StudentEvolutionService
@inject IErrorBookService ErrorBookService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>学情分析 - Northtropic</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-12">
    <!-- 头部 Header -->
    <div class="glass-card pa-6 mb-6 d-flex align-center justify-space-between flex-wrap gap-4">
        <div>
            <div class="d-flex align-center gap-3 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="font-weight-bold">@(_currentUser?.Role == UserRole.Teacher ? "班级学情与作业管控" : "学情分析与作业追踪")</MudText>
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="font-weight-bold">
                    @(_currentUser?.Role == UserRole.Teacher ? "👩‍🏫 名师教研专属" : "👨‍👩‍👧 监护人专属")
                </MudChip>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(_currentUser?.Role == UserRole.Teacher ? "宏观把控学生答题数据、薄弱知识点雷达、作业完成进度与靶向精准分层辅导。" : "管理您关领的子女学生账号，查看答题正确率、错题净化副本进度与智能学情诊断报告。")
            </MudText>
        </div>

        @if (_currentUser != null && _currentUser.CanManageBoundStudents)
        {
            <div class="d-flex align-center gap-3">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AddLink" OnClick="OpenBindDialog">
                    绑定已有学生账号
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateChildDialog">
                    新建子女学生账号
                </MudButton>
            </div>
        }
    </div>

    <!-- 权限拦截检验 -->
    @if (_currentUser == null)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!_currentUser.CanViewStudentAnalytics)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="pa-6 rounded-lg glass-card my-6">
            <div class="d-flex flex-column align-center text-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.GppBad" Size="Size.Large" Color="Color.Warning" />
                <MudText Typo="Typo.h5" Class="font-weight-bold">权限提示：本页面面向【家长用户】、【名师用户】或【超级管理员】开放</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary">
                    当前登录账号：<strong>@_currentUser.Username</strong> (角色: <strong>@_currentUser.RoleDisplayName</strong>)
                    <br />学生等学习终端账号无法访问学情大盘及作业布置功能，请使用家长、教师或管理员账号登录。
                </MudText>
            </div>
        </MudAlert>
    }
    else
    {
        <!-- 关联学生账号面板 -->
        <MudGrid Class="mb-6">
            @if (!_boundStudents.Any())
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-8 text-center glass-card">
                        <MudIcon Icon="@Icons.Material.Filled.ChildCare" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">您尚未绑定任何学生账号</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                            您可以输入子女的 6 位专属绑定码关联现有账号，或直接为子女开通新账号。
                        </MudText>
                        <div class="d-flex justify-center gap-3 flex-wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Link" OnClick="OpenBindDialog">
                                输入绑定码关联
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateChildDialog">
                                新建子女账号
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                        已绑定的子女列表 (@_boundStudents.Count 人)
                    </MudText>
                    
                    <MudGrid>
                        @foreach (var student in _boundStudents)
                        {
                            bool isSelected = _selectedStudent?.Id == student.Id;
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Class="@($"pa-4 glass-card cursor-pointer {(isSelected ? "border-primary" : "")}")"
                                          Style="@(isSelected ? "border: 2px solid var(--mud-palette-primary); background: var(--sub-card-bg);" : "")"
                                          @onclick="() => SelectStudent(student)">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center gap-3">
                                            <div class="d-flex align-center justify-center rounded-circle" style="width: 42px; height: 42px; font-size: 1.6rem; background: rgba(236,72,153,0.15);">
                                                @(!string.IsNullOrEmpty(student.Avatar) ? student.Avatar : "🎓")
                                            </div>
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@student.Username</MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">年级：@student.Grade</MudText>
                                            </div>
                                        </div>
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                            Lv.@student.Level
                                        </MudChip>
                                    </div>

                                    <MudDivider Class="my-2" />

                                    <div class="d-flex justify-space-between text-center mt-2">
                                        <div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">累计答题</MudText>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">@student.TotalAnswered 题</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">正确率</MudText>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Success">
                                                @(student.TotalAnswered > 0 ? (int)((double)student.TotalCorrect / student.TotalAnswered * 100) : 0)%
                                            </MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">连胜打卡</MudText>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Warning">
                                                @student.CurrentStreak 天
                                            </MudText>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-end gap-2 mt-3">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SelectStudent(student)">
                                            查看详细学情
                                        </MudButton>
                                        <MudTooltip Text="编辑子女资料 (修改姓名/头像/年级)">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditStudentDialog(student)" />
                                        </MudTooltip>
                                        <MudTooltip Text="调整就读年级 / 升学">
                                            <MudIconButton Icon="@Icons.Material.Filled.School" Color="Color.Secondary" Size="Size.Small" OnClick="() => OpenEditGradeDialog(student)" />
                                        </MudTooltip>
                                        <MudTooltip Text="解绑">
                                            <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Color="Color.Default" Size="Size.Small" OnClick="() => UnbindStudentAsync(student)" />
                                        </MudTooltip>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>
            }
        </MudGrid>

        <!-- 选中的学生学情分析详情面板 -->
        @if (_selectedStudent != null)
        {
            <MudPaper Class="pa-6 glass-card mb-6">
                <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-6">
                    <div class="d-flex align-center gap-3">
                        <div class="d-flex align-center justify-center rounded-circle" style="width: 60px; height: 60px; font-size: 2.2rem; background: rgba(59,130,246,0.15); border: 2px solid var(--mud-palette-primary);">
                            @(!string.IsNullOrEmpty(_selectedStudent.Avatar) ? _selectedStudent.Avatar : "🎓")
                        </div>
                        <div>
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">@_selectedStudent.Username</MudText>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.School">@_selectedStudent.Grade</MudChip>
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">专属绑定码: @_selectedStudent.BindingCode</MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                最后活跃：@_selectedStudent.LastStudyDate.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        </div>
                    </div>

                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd" OnClick="OpenCreateAssignmentDialog" Style="font-weight: 700; box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);">
                            📋 布置专属作业
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.EmojiEvents" OnClick="OpenQuickPraiseDialog" Style="font-weight: 700; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);">
                            🎁 颁奖与发金币
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Favorite" OnClick="OpenEncouragementDialog">
                            💌 关怀寄语
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Assessment" OnClick="OpenWeeklyReportDialog">
                            📊 导出/打印学情周报
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditStudentDialog(_selectedStudent)">
                            编辑档案
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.School" OnClick="() => OpenEditGradeDialog(_selectedStudent)">
                            升学年级
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LockReset" OnClick="() => OpenResetPasswordDialog(_selectedStudent)">
                            重置密码
                        </MudButton>
                    </div>
                </div>

                <!-- 家长寄语 Banner -->
                <div class="glass-card pa-4 mb-6 d-flex align-center justify-space-between flex-wrap gap-3" style="background: linear-gradient(135deg, rgba(236, 72, 153, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%); border-left: 4px solid #ec4899; border-radius: 10px;">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Secondary" Size="Size.Medium" />
                        <div>
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #ec4899;">
                                    给 @_selectedStudent.Username 的鼓励寄语
                                </MudText>
                                @if (_selectedStudent.ParentNoteUpdatedAt.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        (@_selectedStudent.ParentNoteUpdatedAt.Value.ToString("yyyy-MM-dd HH:mm"))
                                    </MudText>
                                }
                            </div>
                            <MudText Typo="Typo.body2" Class="mt-1">
                                @(!string.IsNullOrWhiteSpace(_selectedStudent.ParentEncouragementNote) ? $"“{_selectedStudent.ParentEncouragementNote}”" : "暂未设置寄语，点击右侧按钮为孩子写一句温暖的鼓励吧！")
                            </MudText>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.EditNote" OnClick="OpenEncouragementDialog">
                        @(!string.IsNullOrWhiteSpace(_selectedStudent.ParentEncouragementNote) ? "修改寄语" : "写下鼓励寄语")
                    </MudButton>
                </div>

                @if (_isLoadingDetails)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" Style="border-radius: 4px;" />
                }

                <!-- 核心数据看板 4 卡片 -->
                <MudGrid Class="mb-6">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 glass-card" Style="border-left: 4px solid var(--mud-palette-primary);">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">答题正确率</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Primary">
                                @(_selectedStudent.TotalAnswered > 0 ? (int)((double)_selectedStudent.TotalCorrect / _selectedStudent.TotalAnswered * 100) : 0)%
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">答对 @_selectedStudent.TotalCorrect / 总共 @_selectedStudent.TotalAnswered 题</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 glass-card" Style="border-left: 4px solid #10b981;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">已净化错题副本</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Style="color: #10b981;">
                                @_selectedStudent.ResolvedErrorsCount 题
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">积极举一反三巩固知识点</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 glass-card" Style="border-left: 4px solid #f59e0b;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">打卡连胜天数</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Style="color: #f59e0b;">
                                @_selectedStudent.CurrentStreak 天
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">最高连击纪录: @_selectedStudent.MaxCombo 连胜</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 glass-card" Style="border-left: 4px solid #8b5cf6;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">成长等级与金币</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Style="color: #8b5cf6;">
                                Lv.@_selectedStudent.Level
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">拥有金币: @_selectedStudent.Coins | 经验: @_selectedStudent.Exp</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- AI 智能认知演进与精准学情诊断 -->
                <MudPaper Class="pa-5 glass-card mb-6" Style="border-left: 5px solid #3b82f6; background: rgba(59, 130, 246, 0.04);">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Medium" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">AI 智能认知演化与精准学情诊断</MudText>
                            @if (_diagnosisReport != null)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Star">
                                    综合评估: @_diagnosisReport.StarRating.ToString("F1") 星级 (@_diagnosisReport.OverallMasteryRate.ToString("F1")% 掌握度)
                                </MudChip>
                            }
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print" OnClick="OpenWeeklyReportDialog">
                                导出学情周报
                            </MudButton>
                        </div>
                    </div>

                    @if (_diagnosisReport != null && !string.IsNullOrWhiteSpace(_diagnosisReport.AiGrowthAdvice))
                    {
                        <div class="pa-3 rounded-lg mb-3" style="background: var(--sub-card-bg); border-left: 3px solid #8b5cf6; line-height: 1.6; font-size: 0.92rem; white-space: pre-wrap;">
                            @_diagnosisReport.AiGrowthAdvice
                        </div>

                        <div class="d-flex flex-wrap gap-4 mt-3">
                            @if (_diagnosisReport.TopMasteredCategories.Count > 0)
                            {
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <span class="text-caption font-weight-bold" style="color: #10b981;">🏆 优势领跑考点:</span>
                                    @foreach (var c in _diagnosisReport.TopMasteredCategories)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">@c</MudChip>
                                    }
                                </div>
                            }

                            @if (_diagnosisReport.TopWeakCategories.Count > 0)
                            {
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <span class="text-caption font-weight-bold" style="color: #f59e0b;">🎯 待破壁薄弱项:</span>
                                    @foreach (var c in _diagnosisReport.TopWeakCategories)
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Style="cursor: pointer;" OnClick="async () => await QuickAssignTargetedPractice(c)">
                                            @c · 一键布置专项 ➔
                                        </MudChip>
                                    }
                                </div>
                            }
                        </div>

                        @if (_diagnosisReport.PrerequisiteWarnings.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                                <div class="d-flex flex-column gap-2">
                                    <div>
                                        <strong>⚠️ 溯源先修考点阻滞预警：</strong>
                                        @string.Join("；", _diagnosisReport.PrerequisiteWarnings.Select(w => $"攻坚【{w.TargetCategory}】受阻，系统溯源其基础先修考点【{w.PrerequisiteCategory}】掌握度偏低({w.PrerequisiteAccuracy:F0}%)，建议优先巩固基础"))
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        @foreach (var w in _diagnosisReport.PrerequisiteWarnings)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Bolt"
                                                       OnClick="async () => await QuickAssignTargetedPractice(w.PrerequisiteCategory, w.PrerequisiteSubject)">
                                                一键布置先修巩固【@w.PrerequisiteCategory】
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            </MudAlert>
                        }
                    }
                    else if (_selectedStudent.TotalAnswered == 0)
                    {
                        <div class="pa-5 rounded-lg text-center" style="background: rgba(59, 130, 246, 0.06); border: 1px dashed rgba(59, 130, 246, 0.3);">
                            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Primary">
                                🚀 欢迎新同学！孩子当前尚未开启刷题练习
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 mb-3" Style="max-width: 560px; margin: 0 auto;">
                                孩子完成首次能力摸底或日常练习后，系统将自动生成多维艾宾浩斯抗遗忘追踪、先修薄弱点溯源与专属学情周报。
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PostAdd" OnClick="OpenCreateAssignmentDialog" Style="font-weight: 700; border-radius: 8px;">
                                📝 为孩子布置首轮能力测试作业
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            正在生成该学员的智能学情诊断报告...
                        </MudText>
                    }
                </MudPaper>

                <!-- 学科知识点掌握度全景分布 -->
                <div class="mb-6">
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">学科做题分布与掌握度评估</MudText>
                    </div>
                    @if (_subjectMasteries.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">暂无学科作答细分统计数据。</MudText>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var sub in _subjectMasteries)
                            {
                                int rate = (int)sub.AccuracyRate;
                                Color barColor = rate >= 80 ? Color.Success : (rate >= 60 ? Color.Warning : Color.Error);
                                <MudItem xs="12" sm="6" md="4">
                                    <MudPaper Class="pa-4 glass-card" Style="background: var(--sub-card-bg);">
                                        <div class="d-flex justify-space-between align-center mb-2">
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@sub.Subject</MudText>
                                            <MudChip T="string" Color="@barColor" Size="Size.Small" Variant="Variant.Filled">
                                                准确率 @rate%
                                            </MudChip>
                                        </div>
                                        <MudProgressLinear Color="@barColor" Value="@rate" Class="my-2" Style="height: 6px; border-radius: 3px;" />
                                        <div class="d-flex justify-space-between mud-text-secondary" style="font-size: 0.8rem;">
                                            <span>答对 @sub.CorrectCount 题</span>
                                            <span>总做题 @sub.TotalCount 题</span>
                                        </div>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </div>

                <!-- 子女待净化错题档案 (实景审阅) -->
                <div class="mb-8">
                    <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Error" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                子女待净化错题档案 (@_unmasteredErrors.Count 题待攻坚)
                            </MudText>
                        </div>
                        @if (_errorReasonBreakdown.Count > 0)
                        {
                            <div class="d-flex align-center gap-1 flex-wrap">
                                <span class="text-caption mud-text-secondary">错因归因分布：</span>
                                @foreach (var kv in _errorReasonBreakdown)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                        @kv.Key: @kv.Value 题
                                    </MudChip>
                                }
                            </div>
                        }
                    </div>

                    @if (_unmasteredErrors.Count == 0)
                    {
                        <div class="glass-card pa-6 text-center" style="background: var(--sub-card-bg);">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-1" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">太棒了！当前无残留未净化的错题！</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">孩子的所有错题已全部攻克巩固，继续保持！</MudText>
                        </div>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var error in _unmasteredErrors.Take(6))
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudPaper Class="pa-4 glass-card d-flex flex-column justify-space-between" Style="background: var(--sub-card-bg); height: 100%; border-top: 3px solid #ef4444;">
                                        <div>
                                            <div class="d-flex justify-space-between align-center mb-2">
                                                <div class="d-flex align-center gap-1">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@(error.Question?.Subject ?? "学科")</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@(error.Question?.Category ?? "综合")</MudChip>
                                                </div>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                                                    @(string.IsNullOrWhiteSpace(error.ErrorReasonCategory) ? "待归因" : error.ErrorReasonCategory)
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2" Style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">
                                                @(error.Question?.Stem ?? "题目内容")
                                            </MudText>
                                            <div class="pa-2 rounded text-caption mb-3" style="background: rgba(0,0,0,0.2);">
                                                <div style="color: #f87171;">❌ 孩子错选/填答：@(string.IsNullOrWhiteSpace(error.UserWrongAnswer) ? "未作答" : error.UserWrongAnswer)</div>
                                                <div style="color: #34d399;">✅ 正确标准答案：@(error.Question?.CorrectAnswer ?? "-")</div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-space-between align-center pt-2" style="border-top: 1px solid rgba(255,255,255,0.1);">
                                            <span class="text-caption mud-text-secondary">@error.CreatedAt.ToString("MM-dd HH:mm") 录入</span>
                                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Bolt" OnClick="async () => await QuickAssignTargetedForError(error)">
                                                靶向变式 ➔
                                            </MudButton>
                                        </div>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </div>

                <!-- 近期练习与突破动态 -->
                <div>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">近期做题与突破动态明细</MudText>
                    </div>
                    @if (_recentRecords.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">暂无近期答题记录。</MudText>
                    }
                    else
                    {
                        <MudTable Items="@_recentRecords" Dense="true" Hover="true" Class="glass-card" Elevation="0">
                            <HeaderContent>
                                <MudTh>答题时间</MudTh>
                                <MudTh>学科 / 题型</MudTh>
                                <MudTh>题目题干摘录</MudTh>
                                <MudTh>作答结果</MudTh>
                                <MudTh>用时</MudTh>
                                <MudTh>获得奖励</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="答题时间">@context.AnsweredAt.ToString("MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="学科 / 题型">
                                    <div class="d-flex align-center gap-1">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@(context.Question?.Subject ?? "未知")</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@(context.Question?.TypeDisplayName ?? "-")</MudChip>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="题目题干摘录">
                                    <MudText Typo="Typo.caption" Style="max-width: 320px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @(context.Question?.Stem ?? "-")
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="作答结果">
                                    @if (context.IsCorrect)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">答对</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Close">答错</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="用时">@context.TimeTakenSeconds 秒</MudTd>
                                <MudTd DataLabel="获得奖励">
                                    <span style="color: #3b82f6;">+@context.EarnedExp EXP</span> /
                                    <span style="color: #f59e0b;">+@context.EarnedCoins 币</span>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </div>

                <!-- 家长专属布置作业与学情追踪看板 -->
                <div class="mt-8">
                    <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                专属作业与专项突破任务追踪 (@_studentAssignments.Count 份)
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAssignmentDialog">
                            布置新作业
                        </MudButton>
                    </div>

                    @if (!_studentAssignments.Any())
                    {
                        <div class="glass-card pa-8 text-center" style="background: var(--sub-card-bg);">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Color="Color.Default" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">暂无布置记录</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                                您可以根据上方学情诊断为子女定制 3-15 道特定学科或知识点的专项突破练习题单。
                            </MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAssignmentDialog">
                                立即布置第一份作业
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var assign in _studentAssignments)
                            {
                                <MudItem xs="12" md="6">
                                    <div class="glass-card pa-4" style="@(assign.IsCompleted ? "border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.05);" : (assign.Deadline.HasValue && assign.Deadline.Value < DateTime.Now ? "border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.05);" : "border-left: 4px solid #f59e0b; background: rgba(245, 158, 11, 0.05);"))">
                                        <div class="d-flex align-center justify-space-between mb-2 flex-wrap gap-1">
                                            <div class="d-flex align-center gap-2">
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@assign.Title</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@assign.Subject</MudChip>
                                                @if (!string.IsNullOrWhiteSpace(assign.Category) && assign.Category != "全部分类")
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@assign.Category</MudChip>
                                                }
                                            </div>
                                            @if (assign.IsCompleted)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                                    已完成 · @assign.Score 分 (@assign.AccuracyRate% 正确率)
                                                </MudChip>
                                            }
                                            else if (assign.Deadline.HasValue && assign.Deadline.Value < DateTime.Now)
                                            {
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.AlarmOff" Variant="Variant.Filled">
                                                    已逾期 (@assign.QuestionCount 题)
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.HourglassTop">
                                                    待完成 (@assign.QuestionCount 题)
                                                </MudChip>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(assign.ParentNote))
                                        {
                                            <div class="pa-2 rounded mb-2" style="background: var(--sub-card-bg); font-size: 0.85rem;">
                                                <span class="mud-text-secondary">💬 家长附言：</span>@assign.ParentNote
                                            </div>
                                        }

                                        <div class="d-flex align-center justify-space-between text-caption mud-text-secondary mt-2">
                                            <div>
                                                <span>布置于: @assign.CreatedAt.ToString("MM-dd HH:mm")</span>
                                                @if (assign.Deadline.HasValue)
                                                {
                                                    <span class="ml-2" style="color: #f59e0b;">截止: @assign.Deadline.Value.ToString("MM-dd HH:mm")</span>
                                                }
                                            </div>
                                            <div class="d-flex align-center gap-1">
                                                @if (!assign.IsCompleted)
                                                {
                                                    <MudTooltip Text="一键向孩子发送作业催促与暖心提醒">
                                                        <MudIconButton Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" Color="Color.Warning" OnClick="() => OpenHomeworkReminderDialog(assign.Id, assign.Title)" />
                                                    </MudTooltip>
                                                }
                                                @if (assign.IsCompleted && assign.CompletedAt.HasValue)
                                                {
                                                    <span style="color: #10b981;">完成于: @assign.CompletedAt.Value.ToString("MM-dd HH:mm")</span>
                                                }
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Default" OnClick="() => DeleteAssignmentAsync(assign.Id)" />
                                            </div>
                                        </div>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </div>
            </MudPaper>
        }
    }
</MudContainer>

<!-- 绑定已有学生账号弹窗 -->
<MudDialog @bind-Visible="_showBindDialog">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">绑定已有学生账号</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_inputBindingCode" Label="学生专属绑定码 或 注册手机号" Variant="Variant.Outlined"
                      Placeholder="例如：STUD01 或 13700000000" Class="mt-2 mb-4" />
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="pa-2">
            学生可登录其账号在个人大盘查看 6 位专属绑定码，或者直接输入学生的注册手机号关联。
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showBindDialog = false">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SubmitBindAsync">确认绑定</MudButton>
    </DialogActions>
</MudDialog>

<!-- 创建子女学生账号弹窗 -->
<MudDialog @bind-Visible="_showCreateChildDialog">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">为子女新建学生账号</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 mt-2">
            <MudTextField T="string" @bind-Value="_newChildName" Label="子女姓名 / 昵称" Variant="Variant.Outlined" Placeholder="如: 小明" />
            <MudSelect T="string" @bind-Value="_newChildGrade" Label="适用年级/学段" Variant="Variant.Outlined">
                @foreach (var grade in GradeSubjectProvider.AvailableGrades)
                {
                    <MudSelectItem Value="@grade">@grade</MudSelectItem>
                }
            </MudSelect>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateChildDialog = false">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitCreateChildAsync">一键开通并绑定</MudButton>
    </DialogActions>
</MudDialog>

<!-- 调整子女年级/升学弹窗 -->
<MudDialog @bind-Visible="_showEditGradeDialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">调整子女就读年级 / 升学</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_editingStudent != null)
        {
            <div class="d-flex flex-column gap-3 py-2">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    正在为子女 <strong>@_editingStudent.Username</strong> (当前年级: <strong>@_editingStudent.Grade</strong>) 调整所在年级。
                    <br />调整后，系统在刷题、AI 辅导及出题时将自动适配新年级的学科体系与考点深度。
                </MudAlert>
                <MudSelect T="string" @bind-Value="_targetNewGrade" Label="选择新年级 / 学段 *" Variant="Variant.Outlined">
                    @foreach (var grade in GradeSubjectProvider.AvailableGrades)
                    {
                        <MudSelectItem Value="@grade">@grade</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEditGradeDialog = false">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmEditGradeAsync">确认调整并保存</MudButton>
    </DialogActions>
</MudDialog>

<!-- 重置子女登录密码弹窗 -->
<MudDialog @bind-Visible="_showResetPasswordDialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Error" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">重置子女登录密码</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_targetResetStudent != null)
        {
            <div class="d-flex flex-column gap-3 py-2">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    正在为子女 <strong>@_targetResetStudent.Username</strong> 重置登录密码。
                    重置后，原密码将立即失效，孩子可以使用新设密码登录系统。
                </MudAlert>
                <MudTextField T="string" @bind-Value="_newResetPassword" Label="新密码 *" Variant="Variant.Outlined" HelperText="默认推荐重置为 123456" Immediate="true" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showResetPasswordDialog = false">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Check" OnClick="ConfirmResetPasswordAsync">确认重置密码</MudButton>
    </DialogActions>
</MudDialog>

<!-- 编辑家长关怀寄语弹窗 -->
<MudDialog @bind-Visible="_showEncouragementDialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">写给子女的关怀寄语与挑战鼓励</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedStudent != null)
        {
            <div class="d-flex flex-column gap-3 py-2">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    您撰写的鼓励寄语将直接显示在 <strong>@_selectedStudent.Username</strong> 登录后的首页大盘显著位置，为孩子加油打气！
                </MudAlert>
                <MudTextField T="string" @bind-Value="_inputEncouragementNote" Label="家长关怀寄语内容" Variant="Variant.Outlined"
                              Lines="3" MaxLength="300" Counter="300" Immediate="true"
                              Placeholder="例如：小明，今天物理浮力题要细心审题哦，晚上做好吃的犒劳你！" />
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">常用快捷寄语模板：</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Style="cursor: pointer;" OnClick='() => _inputEncouragementNote = "今天也要保持专注与细心，做完记得复习错题，加油！"'>专注细心</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Style="cursor: pointer;" OnClick='() => _inputEncouragementNote = "一步一个脚印，错题就是进步的阶梯，爸爸妈妈为你自豪！"'>鼓励陪伴</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Style="cursor: pointer;" OnClick='() => _inputEncouragementNote = "挑战今日刷题目标，达成后周末带你出去放松玩耍！"'>目标奖励</MudChip>
                </div>

                <!-- 实时孩子端渲染效果预览 (Live Student Dashboard Preview) -->
                <div class="mt-2">
                    <div class="d-flex align-center gap-1 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--mud-palette-secondary);">
                            子女端首页实时呈现效果预览：
                        </MudText>
                    </div>
                    <div class="glass-card pa-3 d-flex align-center justify-space-between flex-wrap gap-2" style="background: linear-gradient(135deg, rgba(236, 72, 153, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%); border-left: 4px solid #ec4899; border-radius: 10px; box-shadow: 0 2px 10px rgba(236, 72, 153, 0.1);">
                        <div class="d-flex align-center gap-2">
                            <div class="d-flex align-center justify-center rounded-circle" style="width: 36px; height: 36px; background: rgba(236, 72, 153, 0.2); color: #ec4899; flex-shrink: 0;">
                                <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" />
                            </div>
                            <div>
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.caption" Class="font-weight-bold" style="color: #ec4899;">
                                        💌 家长暖心寄语
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem;">
                                        (发布后即刻显示)
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="font-weight: 500; font-size: 0.85rem;">
                                    “@(!string.IsNullOrWhiteSpace(_inputEncouragementNote) ? _inputEncouragementNote : "今天也要保持专注与细心，加油！")”
                                </MudText>
                            </div>
                        </div>
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.SportsScore">
                            努力冲刺，不负期望
                        </MudChip>
                    </div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEncouragementDialog = false">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SubmitEncouragementNoteAsync">发布寄语</MudButton>
    </DialogActions>
</MudDialog>

<!-- 快捷表扬与爱心金币发放弹窗 -->
<MudDialog @bind-Visible="_showQuickPraiseDialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">🎁 颁发成长表扬勋章与爱心金币</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedStudent != null)
        {
            <div class="d-flex flex-column gap-3 py-2">
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                    及时正向激励能极大提升孩子的学习自驱力！奖励的金币与经验将直接充入 <strong>@_selectedStudent.Username</strong> 的账户。
                </MudAlert>

                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">选择表扬勋章 / 称号：</MudText>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var badge in _presetPraiseBadges)
                    {
                        bool isSelected = _selectedPraiseBadge == badge;
                        <MudChip T="string" Color="@(isSelected ? Color.Warning : Color.Default)" Variant="@(isSelected ? Variant.Filled : Variant.Outlined)" Style="cursor: pointer; font-weight: 700;" OnClick="() => SelectPraiseBadge(badge)">
                            @badge
                        </MudChip>
                    }
                </div>

                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mt-2">附加爱心奖励礼包：</MudText>
