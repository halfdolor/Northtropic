@code {
    private User? _currentUser;
    private List<User> _boundStudents = new();
    private User? _selectedStudent;

    private bool _showEncouragementDialog = false;
    private string _inputEncouragementNote = string.Empty;

    private bool _showQuickPraiseDialog = false;
    private readonly List<string> _presetPraiseBadges = new() { "🏆 错题克星先锋", "🌟 坚持打卡模范", "🔥 专注飞跃之星", "💡 破题巧思达人", "🏅 逆风翻盘勇士" };
    private string _selectedPraiseBadge = "🏆 错题克星先锋";
    private int _rewardCoins = 50;
    private string _praiseComment = string.Empty;

    private bool _showWeeklyReportDialog = false;
    private DialogOptions _weeklyReportDialogOptions = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };

    private bool _showBindDialog = false;
    private string _inputBindingCode = string.Empty;

    private bool _showCreateChildDialog = false;
    private string _newChildName = string.Empty;
    private string _newChildGrade = "初中二年级";

    private bool _showEditGradeDialog = false;
    private User? _editingStudent;
    private string _targetNewGrade = "初中二年级";

    private bool _showResetPasswordDialog = false;
    private User? _targetResetStudent;
    private string _newResetPassword = "123456";

    private bool _showCreateAssignmentDialog = false;
    private string _assignTitle = "专属专项突破作业";
    private string _assignSubject = "初中物理";
    private string _assignCategory = "全部分类";
    private int _assignCount = 5;
    private int _assignDifficulty = 3;
    private string _assignNote = string.Empty;
    private List<string> _availableSubjects = new() { "初中物理", "初中数学", "高中物理", "高中数学", "C# & .NET 进阶", "AI 工程实战", "通用知识" };
    private List<string> _availableCategories = new();

    private List<SubjectMasteryDto> _subjectMasteries = new();
    private List<PracticeRecord> _recentRecords = new();
    private List<HomeworkAssignment> _studentAssignments = new();
    private EvolutionDiagnosisReportDto? _diagnosisReport;
    private List<ErrorItem> _unmasteredErrors = new();
    private Dictionary<string, int> _errorReasonBreakdown = new();
    private bool _isLoadingDetails = false;

    public class SubjectMasteryDto
    {
        public string Subject { get; set; } = string.Empty;
        public int TotalCount { get; set; }
        public int CorrectCount { get; set; }
        public double AccuracyRate => TotalCount > 0 ? (double)CorrectCount / TotalCount * 100 : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        UserSessionService.OnUserChanged += OnUserChangedHandler;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _currentUser = await UserSessionService.GetActiveUserAsync();
        if (_currentUser != null && _currentUser.CanViewStudentAnalytics)
        {
            if (_currentUser.Role == UserRole.SuperAdmin || _currentUser.Role == UserRole.Teacher)
            {
                var allUsers = await UserSessionService.GetAllUsersAsync();
                _boundStudents = allUsers.Where(u => u.Role == UserRole.Student).ToList();
            }
            else
            {
                _boundStudents = await UserSessionService.GetBoundStudentsAsync(_currentUser.Id);
            }

            if (_boundStudents.Any())
            {
                if (_selectedStudent == null || !_boundStudents.Any(s => s.Id == _selectedStudent.Id))
                {
                    _selectedStudent = _boundStudents.First();
                }
                await LoadStudentDetailsAsync(_selectedStudent.Id);
            }
            else
            {
                _selectedStudent = null;
                _subjectMasteries.Clear();
                _recentRecords.Clear();
                _diagnosisReport = null;
                _unmasteredErrors.Clear();
                _errorReasonBreakdown.Clear();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadStudentDetailsAsync(Guid studentId)
    {
        try
        {
            _isLoadingDetails = true;
            var records = await PracticeService.GetUserPracticeRecordsAsync(studentId);

            _recentRecords = records.Take(8).ToList();

            _subjectMasteries = records
                .Where(r => r.Question != null && !string.IsNullOrWhiteSpace(r.Question.Subject))
                .GroupBy(r => r.Question!.Subject)
                .Select(g => new SubjectMasteryDto
                {
                    Subject = g.Key,
                    TotalCount = g.Count(),
                    CorrectCount = g.Count(r => r.IsCorrect)
                })
                .OrderByDescending(s => s.TotalCount)
                .ToList();

            _studentAssignments = await PracticeService.GetHomeworkAssignmentsByStudentAsync(studentId);

            // 智能学情演进与错题深潜诊断加载
            _diagnosisReport = await StudentEvolutionService.GenerateDiagnosisReportAsync(studentId);
            _unmasteredErrors = await ErrorBookService.GetUnmasteredErrorsAsync(studentId, _currentUser?.Id);
            _errorReasonBreakdown = _unmasteredErrors
                .GroupBy(e => string.IsNullOrWhiteSpace(e.ErrorReasonCategory) ? "未归类错因" : e.ErrorReasonCategory)
                .ToDictionary(g => g.Key, g => g.Count());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading student details: {ex.Message}");
        }
        finally
        {
            _isLoadingDetails = false;
        }
    }

    private async Task QuickAssignTargetedPractice(string category, string? subject = null)
    {
        if (string.IsNullOrWhiteSpace(subject) && category.Contains('-'))
        {
            var firstDash = category.IndexOf('-');
            subject = category.Substring(0, firstDash);
            category = category.Substring(firstDash + 1);
        }
        _assignSubject = !string.IsNullOrWhiteSpace(subject) ? subject : (_selectedStudent?.Grade?.Contains("初中") == true ? "初中物理" : "高中物理");
        _assignCategory = category;
        _assignTitle = $"{_assignSubject} · {category} 薄弱靶向攻坚作业";
        _assignCount = 5;
        _assignDifficulty = 3;
        _assignNote = $"系统检测到你在【{category}】考点尚有薄弱，特布置此专项练习，认真思考，突破短板！";
        await UpdateCategoriesForSubjectAsync(_assignSubject);
        _showCreateAssignmentDialog = true;
        StateHasChanged();
    }

    private async Task QuickAssignTargetedForError(ErrorItem error)
