                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">
                                    欢迎回来，<span Class="gradient-text">@(_currentUser?.Username ?? "学霸")</span>！
                                </MudText>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 800;">
                                    Lv.@(_currentUser?.Level ?? 1)
                                </MudChip>
                                @if (!string.IsNullOrEmpty(_currentUser?.BindingCode))
                                {
                                    <MudTooltip Text="点击复制专属绑定码，可交予家长一键关联协同">
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.ContentCopy" Style="cursor: pointer; font-family: monospace; font-weight: 700;" OnClick="CopyBindingCodeAsync">
                                            绑定码: @_currentUser.BindingCode
                                        </MudChip>
                                    </MudTooltip>
                                }
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
