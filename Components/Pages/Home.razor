@page "/"
@using Northtropic.Models
@using Northtropic.Services
@using Microsoft.EntityFrameworkCore
@inject IGamificationService GamificationService
@inject IErrorBookService ErrorBookService
@inject IStudentEvolutionService StudentEvolutionService
@inject IPracticeService PracticeService
@inject IUserSessionService UserSession
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IQuestionManagementService QuestionManagementService
@implements IDisposable

<PageTitle>主面板 - Northtropic</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 mb-10">
    @if (_isInitialLoading)
    {
        <!-- 骨架屏占位：消除页面加载抖动与累积布局偏移 (CLS) -->
        <div class="glass-card pa-6 mb-6">
            <div class="d-flex align-center gap-4">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="60px" Height="60px" />
                <div class="flex-grow-1">
                    <MudSkeleton Width="35%" Height="32px" Class="mb-2" />
                    <MudSkeleton Width="55%" Height="20px" />
                </div>
            </div>
        </div>

        <MudGrid Class="mb-6">
            @for (int i = 0; i < 4; i++)
            {
                <MudItem xs="12" sm="6" md="3">
                    <div class="glass-card pa-5">
                        <MudSkeleton Width="40%" Height="18px" Class="mb-2" />
                        <MudSkeleton Width="60%" Height="36px" Class="mb-2" />
                        <MudSkeleton Width="50%" Height="16px" />
                    </div>
                </MudItem>
            }
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="8">
                <div class="glass-card pa-6 mb-6">
                    <MudSkeleton Width="25%" Height="28px" Class="mb-4" />
                    <MudSkeleton Width="100%" Height="180px" />
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="glass-card pa-6 mb-6">
                    <MudSkeleton Width="45%" Height="28px" Class="mb-4" />
                    <MudSkeleton Width="100%" Height="180px" />
                </div>
            </MudItem>
        </MudGrid>
    }
    else if (_currentUser?.Role == UserRole.Parent)
    {
        <!-- 家长专属智能协同大盘 -->
        <div class="glass-card pa-6 mb-6">
            <MudGrid align-items="center">
                <MudItem xs="12" md="7">
                    <div class="d-flex align-center gap-3">
                        <div class="d-flex align-center justify-center rounded-circle" style="width: 56px; height: 56px; font-size: 2rem; background: linear-gradient(135deg, rgba(236,72,153,0.2), rgba(168,85,247,0.2)); border: 2px solid var(--mud-palette-secondary);">
                            👨‍👩‍👧
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">
                                    欢迎进入家长协同空间，<span class="gradient-text">@_currentUser?.Username</span>！
                                </MudText>
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 800;">
                                    👨‍👩‍👧 家长守护者
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                实时同步子女每日刷题进度、诊断错因短板、布置针对性作业并发送暖心鼓励。
                            </MudText>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex justify-md-end gap-2 flex-wrap align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AssignmentInd" OnClick='() => NavigationManager.NavigateTo("/parent-dashboard")'>
                        子女账号管理
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Dashboard" Class="px-6 py-3 font-weight-bold" Style="border-radius: 12px;" OnClick='() => NavigationManager.NavigateTo("/parent-dashboard")'>
                        进入完整学情大盘
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>

        @if (_selectedChild != null)
        {
            <!-- 子女学情概览卡片 -->
            <div class="glass-card pa-6 mb-6" style="border-left: 5px solid #ec4899;">
                <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
                    <div class="d-flex align-center gap-3">
                        <div class="d-flex align-center justify-center rounded-circle" style="width: 48px; height: 48px; font-size: 1.8rem; background: rgba(59,130,246,0.15); border: 2px solid #3b82f6;">
                            @(!string.IsNullOrEmpty(_selectedChild.Avatar) ? _selectedChild.Avatar : "🎒")
                        </div>
                        <div>
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.h6" Class="font-weight-bold">@_selectedChild.Username 的学情动态</MudText>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_selectedChild.Grade</MudChip>
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Lv.@_selectedChild.Level</MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                最近学习时间：@_selectedChild.LastStudyDate.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.EditNote" OnClick="OpenParentNoteDialog">
                            ✍️ 修改暖心寄语
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd" OnClick='() => NavigationManager.NavigateTo("/parent-dashboard")'>
                            📋 布置专属作业
                        </MudButton>
                    </div>
                </div>

                <!-- 4 大核心指标卡片 -->
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="3">
                        <div class="glass-card pa-4 text-center" style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Medium" />
                            <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Primary">@_selectedChild.TotalAnswered</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">累计作答题量</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="glass-card pa-4 text-center" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                            <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Success">@GetChildAccuracyRate()%</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">综合答题正确率</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="glass-card pa-4 text-center" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Medium" />
                            <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Error">@_childUnmasteredCount</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">待消灭错题副本</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="glass-card pa-4 text-center" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.Whatshot" Color="Color.Warning" Size="Size.Medium" />
                            <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Warning">@_selectedChild.CurrentStreak 天</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">连续坚持学习</MudText>
                        </div>
                    </MudItem>
                </MudGrid>
            </div>

            <!-- 当前寄语展示与作业待办状态 -->
            <MudGrid Spacing="3" Class="mb-6">
                <MudItem xs="12" md="6">
                    <div class="glass-card pa-5 h-100" style="background: linear-gradient(135deg, rgba(236,72,153,0.06), rgba(244,63,94,0.1)); border: 1px solid rgba(236,72,153,0.3); border-radius: 12px;">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Secondary" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">当前显示在孩子首页的暖心寄语</MudText>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick="OpenParentNoteDialog">编辑</MudButton>
                        </div>
                        <div class="pa-4 rounded-lg" style="background: rgba(15, 23, 42, 0.3); border-left: 4px solid #ec4899;">
                            <MudText Typo="Typo.body1" Style="font-style: italic; line-height: 1.6;">
                                "@(!string.IsNullOrEmpty(_selectedChild.ParentEncouragementNote) ? _selectedChild.ParentEncouragementNote : "孩子，每天进步一小步，就是卓越的一大步！爸爸妈妈永远支持你！")"
                            </MudText>
                            <div class="text-right mt-2">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    更新于：@(_selectedChild.ParentNoteUpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "今天")
                                </MudText>
                            </div>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="glass-card pa-5 h-100" style="border: 1px solid rgba(59,130,246,0.3); border-radius: 12px;">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">最近布置的专属作业 (@_childAssignments.Count)</MudText>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick='() => NavigationManager.NavigateTo("/parent-dashboard")'>布置新作业</MudButton>
                        </div>
                        @if (_childAssignments.Any())
                        {
                            <div class="d-flex flex-column gap-2" style="max-height: 140px; overflow-y: auto;">
                                @foreach (var a in _childAssignments.Take(3))
                                {
                                    <div class="d-flex align-center justify-space-between pa-2 rounded" style="background: rgba(255,255,255,0.04); font-size: 0.85rem;">
                                        <span>【@a.Subject】@a.Category (@a.QuestionCount 题)</span>
                                        @if (a.IsCompleted)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">已完成 (@a.CorrectCount/@a.QuestionCount)</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">进行中</MudChip>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 mud-text-secondary">
                                <MudText Typo="Typo.body2">暂无已布置的作业，快去为孩子布置今日第一份作业吧！</MudText>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick='() => NavigationManager.NavigateTo("/parent-dashboard")'>
                                    去布置作业
                                </MudButton>
                            </div>
                        }
                    </div>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <div class="glass-card pa-8 text-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">您尚未关联绑定的子女账号</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 mb-4">
                    请输入学生账号的 8 位专属绑定码（如 STU6380），即可在此实时守护学情。
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Link" OnClick='() => NavigationManager.NavigateTo("/parent-dashboard")'>
                    前往关联子女账号
                </MudButton>
            </div>
        }
    }
    else if (_currentUser?.Role == UserRole.Teacher)
    {
        <!-- 教师教研与智能题库工作台 -->
        <div class="glass-card pa-6 mb-6">
            <MudGrid align-items="center">
                <MudItem xs="12" md="7">
                    <div class="d-flex align-center gap-3">
                        <div class="d-flex align-center justify-center rounded-circle" style="width: 56px; height: 56px; font-size: 2rem; background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(234,88,12,0.2)); border: 2px solid var(--mud-palette-warning);">
                            👩‍🏫
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">
                                    欢迎使用名师备课与智能题库工作台，<span class="gradient-text">@_currentUser?.Username</span>！
                                </MudText>
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 800;">
                                    👩‍🏫 教研名师
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                支持全学科题库录入、OCR 拍照识题、批量导入、分层作业分发与 AI 智能组卷。
                            </MudText>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex justify-md-end gap-2 flex-wrap align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd" OnClick='() => NavigationManager.NavigateTo("/question-management")'>
                        手动录入新题
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large" StartIcon="@Icons.Material.Filled.LibraryBooks" Class="px-6 py-3 font-weight-bold" Style="border-radius: 12px;" OnClick='() => NavigationManager.NavigateTo("/question-management")'>
                        进入题库管理
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>

        <!-- 题库关键指标 -->
        <MudGrid Spacing="3" Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-4 text-center" style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Primary">@_totalQuestionsCount</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">系统题库总题量</MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-4 text-center" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Success" Size="Size.Medium" />
                    <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Success">@_publicQuestionsCount</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">公开共享题库</MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-4 text-center" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.PersonPin" Color="Color.Warning" Size="Size.Medium" />
                    <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Warning">@_myQuestionsCount</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">我录入的试题</MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-4 text-center" style="background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.25); border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Secondary" Size="Size.Medium" />
                    <MudText Typo="Typo.h4" Class="font-weight-bold my-1" Color="Color.Secondary">全学科</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">初高中 9 大主科覆盖</MudText>
                </div>
            </MudItem>
        </MudGrid>

        <!-- 教学核心工具矩阵 -->
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3 d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Warning" />
            名师备课与出题核心通道
        </MudText>
        <MudGrid Spacing="3" Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-5 d-flex flex-column justify-space-between h-100" style="cursor: pointer; border: 1px solid rgba(59,130,246,0.3); border-radius: 12px; transition: transform 0.2s;" @onclick='() => NavigationManager.NavigateTo("/question-management")'>
                    <div>
                        <div class="d-inline-flex pa-3 rounded-lg mb-3" style="background: rgba(59,130,246,0.15); color: #3b82f6;">
                            <MudIcon Icon="@Icons.Material.Filled.PostAdd" Size="Size.Medium" />
                        </div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">手动录入试题</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            规范录入题干、选项、正确答案、深度解析及 KaTeX 理科公式。
                        </MudText>
                    </div>
                    <div class="mt-4 text-right">
                        <MudText Typo="Typo.button" Color="Color.Primary" Class="font-weight-bold">去录题 →</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-5 d-flex flex-column justify-space-between h-100" style="cursor: pointer; border: 1px solid rgba(16,185,129,0.3); border-radius: 12px; transition: transform 0.2s;" @onclick='() => NavigationManager.NavigateTo("/question-management")'>
                    <div>
                        <div class="d-inline-flex pa-3 rounded-lg mb-3" style="background: rgba(16,185,129,0.15); color: #10b981;">
                            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Medium" />
                        </div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">批量文件导入</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            支持标准 JSON、CSV、TXT 试题模板文件一键批量解析入库。
                        </MudText>
                    </div>
                    <div class="mt-4 text-right">
                        <MudText Typo="Typo.button" Color="Color.Success" Class="font-weight-bold">批量导入 →</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-5 d-flex flex-column justify-space-between h-100" style="cursor: pointer; border: 1px solid rgba(245,158,11,0.3); border-radius: 12px; transition: transform 0.2s;" @onclick='() => NavigationManager.NavigateTo("/question-management")'>
                    <div>
                        <div class="d-inline-flex pa-3 rounded-lg mb-3" style="background: rgba(245,158,11,0.15); color: #f59e0b;">
                            <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Medium" />
                        </div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">OCR 拍照智能识题</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            通过 PaddleOCR 引擎智能提取试卷与手写试题，自动切分题目。
                        </MudText>
                    </div>
                    <div class="mt-4 text-right">
                        <MudText Typo="Typo.button" Color="Color.Warning" Class="font-weight-bold">拍照识题 →</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="glass-card pa-5 d-flex flex-column justify-space-between h-100" style="cursor: pointer; border: 1px solid rgba(139,92,246,0.3); border-radius: 12px; transition: transform 0.2s;" @onclick='() => NavigationManager.NavigateTo("/practice")'>
                    <div>
                        <div class="d-inline-flex pa-3 rounded-lg mb-3" style="background: rgba(139,92,246,0.15); color: #8b5cf6;">
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircleOutline" Size="Size.Medium" />
                        </div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">试题实测与模拟答题</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            以答题视角检验试题公式渲染、手写草稿纸与即时评测准确性。
                        </MudText>
                    </div>
                    <div class="mt-4 text-right">
                        <MudText Typo="Typo.button" Color="Color.Secondary" Class="font-weight-bold">进入练习 →</MudText>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
    else if (_currentUser?.Role == UserRole.SuperAdmin)
    {
        <!-- 超级管理员系统总控台 -->
        <div class="glass-card pa-6 mb-6">
            <MudGrid align-items="center">
                <MudItem xs="12" md="7">
                    <div class="d-flex align-center gap-3">
                        <div class="d-flex align-center justify-center rounded-circle" style="width: 56px; height: 56px; font-size: 2rem; background: linear-gradient(135deg, rgba(239,68,68,0.2), rgba(220,38,38,0.2)); border: 2px solid var(--mud-palette-error);">
                            🛡️
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-2 flex-wrap">
