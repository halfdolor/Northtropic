                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                (@_currentUser.ParentNoteUpdatedAt.Value.ToString("yyyy-MM-dd HH:mm"))
                            </MudText>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Class="mt-1" Style="font-weight: 500;">
