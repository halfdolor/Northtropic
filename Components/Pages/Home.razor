                            <div>
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@assign.Title</MudText>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">@assign.Subject</MudChip>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(assign.ParentNote))
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" Style="font-size: 0.85rem;">
                                        💬 附言：@assign.ParentNote
                                    </MudText>
                                }
                            </div>
                            <div class="d-flex align-center justify-space-between mt-3 flex-wrap gap-2">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    题量：<strong>@assign.QuestionCount 题</strong> · 期望难度：<strong>Lv.@assign.TargetDifficulty</strong>
                                </MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" Style="font-weight: 700;" OnClick="() => StartAssignmentPractice(assign)">
                                    🚀 立即开始作业
                                </MudButton>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>
    }

    <!-- 家长关怀寄语暖心 Banner (如果家长有留言) -->
