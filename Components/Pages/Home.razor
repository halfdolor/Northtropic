                        </MudButton>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="glass-card pa-5 d-flex flex-column justify-space-between h-100" style="border: 1px solid rgba(59,130,246,0.3); border-radius: 12px;">
                    <div>
                        <div class="d-inline-flex pa-3 rounded-lg mb-3" style="background: rgba(59,130,246,0.15); color: #3b82f6;">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Medium" />
                        </div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">系统与 AI 大模型配置</MudText>
