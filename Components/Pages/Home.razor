                    </MudChip>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.CardGiftcard" OnClick="ClaimDailyRewardAsync" Class="font-weight-bold" Style="box-shadow: 0 0 12px rgba(245, 158, 11, 0.4); animation: pulse 2s infinite;">
                        🎉 领取打卡达标大礼包 (+50 EXP, +30 金币)
                    </MudButton>
                }
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditTargetDialog">
                调整目标 (@(_currentUser?.DailyTargetQuestions ?? 20) 题/天)
            </MudButton>
        </div>
    </div>

    <!-- 数据概览卡片矩阵 (交互式快捷直达) -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <div class="glass-card pa-4 d-flex align-center gap-4 cursor-pointer" @onclick='() => NavigationManager.NavigateTo("/practice-records")' style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Quiz" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">累计刷题 ➔</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@(_currentUser?.TotalAnswered ?? 0) 道</MudText>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <div class="glass-card pa-4 d-flex align-center gap-4 cursor-pointer" @onclick='() => NavigationManager.NavigateTo("/practice-records")' style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <MudAvatar Color="Color.Success" Size="Size.Large" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">综合正确率 ➔</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Success">
                        @GetAccuracyRate()%
                    </MudText>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <div class="glass-card pa-4 d-flex align-center gap-4 cursor-pointer" @onclick='() => NavigationManager.NavigateTo("/error-book")' style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <MudAvatar Color="Color.Error" Size="Size.Large" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">待净化错题 ➔</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">
                        @_unmasteredCount 道
                    </MudText>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <div class="glass-card pa-4 d-flex align-center gap-4 cursor-pointer" @onclick='() => NavigationManager.NavigateTo("/achievements")' style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <MudAvatar Color="Color.Warning" Size="Size.Large" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">最高连击纪录 ➔</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">
                        @(_currentUser?.MaxCombo ?? 0) Combo
                    </MudText>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <!-- AI 学情演进与周度能力跨越对比 Card -->
    @if (_diagnosisReport != null)
    {
        <div class="glass-card pa-6 mb-6" style="border-left: 4px solid #8b5cf6; background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(30, 41, 59, 0.5) 100%);">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Secondary" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">AI 学情演进与能力破壁诊断</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">关注学生真正进步：周度对比 + 靶向破壁 + 遗忘衰减预警</MudText>
                    </div>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Warning">
                        综合星级：
                        @for (int i = 0; i < _diagnosisReport.StarRating; i++)
                        {
                            <span>⭐</span>
                        }
                    </MudText>
                </div>
            </div>

            <!-- 周度真实进步对比指标 -->
            <div class="pa-4 mb-4 rounded d-flex flex-wrap gap-4 align-center justify-space-between" style="background: rgba(139, 92, 246, 0.12); border: 1px solid rgba(139, 92, 246, 0.25);">
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">周度正确率变动</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Color="@(_diagnosisReport.WeeklyAccuracyDelta >= 0 ? Color.Success : Color.Error)">
                        @(_diagnosisReport.WeeklyAccuracyDelta >= 0 ? "+" : "")@_diagnosisReport.WeeklyAccuracyDelta %
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">解题速度提升</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Info">
                        提速 @_diagnosisReport.SpeedImprovementSeconds 秒 / 题
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">待复习艾宾浩斯节点</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Color="@(_diagnosisReport.PendingSpacedReviewCount > 0 ? Color.Warning : Color.Success)">
                        @_diagnosisReport.PendingSpacedReviewCount 个
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">攻坚弱项数量</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
                        @_diagnosisReport.TopWeakCategories.Count 个
                    </MudText>
                </div>
            </div>

            <div class="pa-4 rounded mb-4" style="background: var(--sub-card-bg); white-space: pre-line;">
                <MudText Typo="Typo.body1" Style="line-height: 1.6;">
                    @_diagnosisReport.AiGrowthAdvice
                </MudText>
            </div>

            @if (_diagnosisReport.PrerequisiteWarnings.Count > 0)
            {
                <div class="pa-4 mb-4 rounded" style="background: rgba(245, 158, 11, 0.12); border-left: 4px solid #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Warning">
                            🔗 AI 前置知识图谱溯源诊断 (前置概念薄弱警报)
                        </MudText>
                    </div>
                    @foreach (var warn in _diagnosisReport.PrerequisiteWarnings)
                    {
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                            <MudText Typo="Typo.body2" Style="line-height: 1.5;">
                                @warn.ActionAdvice
                            </MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="() => NavigateCategory(warn.PrerequisiteCategory)">
                                优先巩固前置考点：【@warn.PrerequisiteCategory】 ➔
                            </MudButton>
                        </div>
                    }
                </div>
            }

            <div class="d-flex align-center justify-space-between flex-wrap gap-4 pt-2">
                <div class="d-flex align-center gap-2 flex-wrap">
                    @if (_diagnosisReport.TopMasteredCategories.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Color="Color.Success">🔥 精通考点：</MudText>
                        @foreach (var c in _diagnosisReport.TopMasteredCategories)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">@c</MudChip>
                        }
                    }
                    @if (_diagnosisReport.TopWeakCategories.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Color="Color.Error">⚠️ 攻坚弱项：</MudText>
                        @foreach (var c in _diagnosisReport.TopWeakCategories)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">@c</MudChip>
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(_diagnosisReport.RecommendedSubject))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="NavigateRecommendedPractice" Class="font-weight-bold px-6">
                        开启 AI 靶向弱项精准拔高：【@_diagnosisReport.RecommendedCategory】 ➔
                    </MudButton>
                }
            </div>
        </div>
    }

    <!-- 艾宾浩斯遗忘曲线 - 记忆巩固唤醒副本 Card -->
    @if (_pendingSpacedNodes.Count > 0)
    {
        <div class="glass-card pa-6 mb-6" style="border-left: 4px solid #f59e0b; background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(30, 41, 59, 0.5) 100%);">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="Color.Warning" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">艾宾浩斯遗忘曲线 - 记忆唤醒副本</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">在记忆临界衰减点进行精准复习，巩固率提升 3.5 倍</MudText>
                    </div>
                </div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Style="font-weight: 800;">
                        待复习考点: @_pendingSpacedNodes.Count 个
                    </MudChip>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.SportsKabaddi" OnClick="StartBatchSpacedReview" Style="font-weight: 700;">
                        🚀 启动今日记忆唤醒冲刺 ➔
                    </MudButton>
                </div>
            </div>

            <MudGrid Class="mb-3">
                @foreach (var node in _pendingSpacedNodes.Take(4))
                {
                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-4 glass-card h-100" style="background: var(--sub-card-bg); border-top: 3px solid #f59e0b;">
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@node.Subject</MudChip>
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">@node.SpacedRepetitionStatus</MudChip>
                            </div>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold my-1">@node.Category</MudText>
                            <div class="d-flex justify-space-between mud-text-secondary mb-1" style="font-size: 0.8rem;">
                                <span>记忆保留率</span>
                                <span style="font-weight: 700; color: #f59e0b;">@node.MemoryRetentionRate %</span>
                            </div>
                            <MudProgressLinear Color="Color.Warning" Value="@node.MemoryRetentionRate" Style="height: 5px; border-radius: 3px;" Class="mb-3" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" FullWidth="true" OnClick="() => NavigateSpacedReview(node.Category, node.Subject)">
                                立即唤醒记忆 ➔
                            </MudButton>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>
    }

    <!-- 知识点全景演进星盘 (Interactive Knowledge Evolution Map) -->
    @if (_masteryOverview.Count > 0)
    {
        <div class="glass-card pa-6 mb-6">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">全景知识演进与能力星盘</MudText>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">点击任意考点卡片即可一键发起 AI 靶向训练</MudText>
            </div>

            <MudGrid>
                @foreach (var m in _masteryOverview.Take(8))
                {
                    <MudItem xs="12" sm="6" md="3">
                        <div class="pa-4 glass-card cursor-pointer" style="background: var(--sub-card-bg); transition: transform 0.2s;" @onclick="() => NavigateCategory(m.Category, m.Subject)">
                            <div class="d-flex align-center justify-space-between mb-2">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@m.Subject</MudChip>
                                <MudChip T="string" Color="@(m.MasteryScore >= 85 ? Color.Success : (m.MasteryScore >= 65 ? Color.Info : Color.Error))" Size="Size.Small">
                                    @m.MasteryLevel
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">@m.Category</MudText>
                            <div class="d-flex justify-space-between mb-1" style="font-size: 0.8rem;">
                                <span>掌握度得分</span>
                                <span class="font-weight-bold">@m.MasteryScore / 100</span>
                            </div>
                            <MudProgressLinear Color="@(m.MasteryScore >= 85 ? Color.Success : (m.MasteryScore >= 65 ? Color.Info : Color.Error))" Value="@m.MasteryScore" Style="height: 6px; border-radius: 3px;" Class="mb-2" />
                            <div class="d-flex justify-space-between mud-text-secondary" style="font-size: 0.75rem;">
                                <span>正确率: @m.AccuracyRate%</span>
                                <span>做题数: @m.TotalAnswered 题</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>
    }

    <!-- 快捷功能入口 -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <div class="glass-card pa-6 h-100">
                <div class="d-flex align-center justify-space-between mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.FlashOn" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            年级学科一键专练 (@(_currentUser?.Grade ?? "当前年级"))
                        </MudText>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                    根据你的学段自动匹配课程与中高考核心考点，享受连击经验加成与即时反馈。
                </MudText>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var sub in GetCurrentGradeSubjects())
                    {
                        <MudChip T="string" OnClick='() => NavigateSubject(sub)' Color="Color.Primary" Variant="Variant.Outlined" Style="font-weight: 600; cursor: pointer;">
                            📖 @sub
                        </MudChip>
                    }
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <div class="glass-card pa-6 h-100">
                <div class="d-flex align-center justify-space-between mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.BugReport" Color="Color.Error" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            待消灭错题副本
                        </MudText>
                    </div>
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                        @_unmasteredCount 道待净化
                    </MudChip>
                </div>
                <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
                    你在刷题中积累了 @_unmasteredCount 道未净化的错题。改错成功可获得 1.5 倍经验值与 AI 变式强化！
                </MudText>
                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick='() => NavigationManager.NavigateTo("/error-book")' Style="font-weight: 700;">
                        进入错题净化副本
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SportsKabaddi" OnClick='() => NavigationManager.NavigateTo("/practice?mode=sprint")'>
                        开启错题专项突击
                    </MudButton>
                </div>
            </div>
        </MudItem>
    </MudGrid>
    }

    <!-- 调整每日刷题目标 Dialog -->
    <MudDialog @bind-Visible="_targetDialogVisible" Options="_targetDialogOptions">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">设定每日刷题打卡目标</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                合理设定每日刷题量，保持专注节奏，循序渐进构建坚实知识网络！
            </MudText>
            <MudNumericField T="int" @bind-Value="_newDailyTarget" Label="每日目标题数 (建议 10~50 题)" Min="1" Max="200" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="() => _newDailyTarget = 10" Style="cursor: pointer;">10 题/天 (轻量热身)</MudChip>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="() => _newDailyTarget = 20" Style="cursor: pointer;">20 题/天 (标准进阶)</MudChip>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="() => _newDailyTarget = 30" Style="cursor: pointer;">30 题/天 (学霸冲刺)</MudChip>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="() => _newDailyTarget = 50" Style="cursor: pointer;">50 题/天 (极限突破)</MudChip>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _targetDialogVisible = false">取消</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDailyTargetAsync">保存目标</MudButton>
        </DialogActions>
    </MudDialog>

    <!-- 家长编辑寄语弹窗 -->
    <MudDialog @bind-Visible="_parentNoteDialogVisible">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">写给孩子 @(_selectedChild?.Username) 的暖心寄语</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <div class="d-flex flex-column gap-3 py-2">
                <MudTextField T="string" @bind-Value="_newParentNote" Label="寄语内容" Variant="Variant.Outlined"
                              Lines="3" MaxLength="300" Counter="300"
                              Placeholder="例如：小明，今天物理浮力题要细心审题哦，晚上做好吃的犒劳你！" />
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">快捷寄语灵感：</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Style="cursor: pointer;" OnClick='() => _newParentNote = "今天也要保持专注与细心，做完记得复习错题，加油！"'>🎯 专注细心</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Style="cursor: pointer;" OnClick='() => _newParentNote = "一步一个脚印，错题就是进步的阶梯，爸爸妈妈为你自豪！"'>🌱 鼓励陪伴</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Style="cursor: pointer;" OnClick='() => _newParentNote = "挑战今日刷题目标，达成后周末带你出去放松玩耍！"'>🎁 目标奖励</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Style="cursor: pointer;" OnClick='() => _newParentNote = "中考冲刺是一场稳步向前的马拉松，稳住心态，错题是提分的最佳燃料！"'>🔥 中考冲刺</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Style="cursor: pointer;" OnClick='() => _newParentNote = "尽力而为，累了就站起来喝杯热牛奶放松一下，身心健康永远第一位！"'>☕ 考前减压</MudChip>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _parentNoteDialogVisible = false">取消</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveParentNoteAsync">发布寄语</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {
    private User? _currentUser;
    private int _unmasteredCount = 0;
    private EvolutionDiagnosisReportDto? _diagnosisReport;
    private List<KnowledgePointMasteryDto> _pendingSpacedNodes = new List<KnowledgePointMasteryDto>();
    private List<KnowledgePointMasteryDto> _masteryOverview = new List<KnowledgePointMasteryDto>();
    private List<HomeworkAssignment> _pendingAssignments = new List<HomeworkAssignment>();

    // 家长协同工作台状态
    private List<User> _boundStudents = new();
    private User? _selectedChild = null;
    private int _childUnmasteredCount = 0;
    private List<HomeworkAssignment> _childAssignments = new();
    private string _newParentNote = string.Empty;
    private bool _parentNoteDialogVisible = false;

    // 教师教研与题库工作台状态
    private int _totalQuestionsCount = 0;
    private int _publicQuestionsCount = 0;
    private int _myQuestionsCount = 0;

    // 超级管理员运维大盘状态
    private int _totalUsersCount = 0;
    private int _pendingUsersCount = 0;
    private int _adminQuestionsCount = 0;
    private bool _isInitialLoading = true;

    private bool _targetDialogVisible = false;
    private int _newDailyTarget = 20;
    private readonly DialogOptions _targetDialogOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        UserSession.OnUserChanged += OnUserChangedHandler;
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            _currentUser = await GamificationService.GetCurrentUserAsync();
            var countTask = ErrorBookService.GetUnmasteredCountAsync(_currentUser?.Id);

            if (_currentUser != null)
            {
                if (_currentUser.Role == UserRole.Student)
                {
                    var diagTask = StudentEvolutionService.GenerateDiagnosisReportAsync(_currentUser.Id);
                    var spacedTask = StudentEvolutionService.GetPendingSpacedReviewNodesAsync(_currentUser.Id);
                    var masteryTask = StudentEvolutionService.GetMasteryOverviewAsync(_currentUser.Id);
                    var assignTask = PracticeService.GetHomeworkAssignmentsByStudentAsync(_currentUser.Id);

                    await Task.WhenAll(countTask, diagTask, spacedTask, masteryTask, assignTask);

                    _unmasteredCount = await countTask;
                    _diagnosisReport = await diagTask;
                    _pendingSpacedNodes = await spacedTask;
                    _masteryOverview = await masteryTask;
                    var assignments = await assignTask;
                    _pendingAssignments = assignments.Where(a => !a.IsCompleted).ToList();
                }
                else if (_currentUser.Role == UserRole.Parent)
                {
                    _unmasteredCount = await countTask;
                    _boundStudents = await UserSession.GetBoundStudentsAsync(_currentUser.Id);
                    if (_boundStudents.Any())
                    {
                        _selectedChild = _boundStudents.First();
                        var childCountTask = ErrorBookService.GetUnmasteredCountAsync(_selectedChild.Id);
                        var childAssignTask = PracticeService.GetHomeworkAssignmentsByStudentAsync(_selectedChild.Id);
                        await Task.WhenAll(childCountTask, childAssignTask);
                        _childUnmasteredCount = await childCountTask;
                        _childAssignments = await childAssignTask;
                    }
                }
                else if (_currentUser.Role == UserRole.Teacher)
                {
                    _unmasteredCount = await countTask;
                    var qStats = await QuestionManagementService.GetQuestionStatisticsAsync(_currentUser.Id);
                    _totalQuestionsCount = qStats.TotalQuestions;
                    _publicQuestionsCount = qStats.PublicQuestions;
                    _myQuestionsCount = qStats.MyQuestions;
                }
                else if (_currentUser.Role == UserRole.SuperAdmin)
                {
                    _unmasteredCount = await countTask;
                    var uStats = await UserSession.GetUserStatisticsAsync();
                    _totalUsersCount = uStats.TotalUsers;
                    _pendingUsersCount = uStats.PendingUsers;
                    var qStats = await QuestionManagementService.GetQuestionStatisticsAsync();
                    _adminQuestionsCount = qStats.TotalQuestions;
                }
            }
            else
            {
                _unmasteredCount = await countTask;
            }
        }
        finally
        {
            _isInitialLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartAssignmentPractice(HomeworkAssignment assign)
    {
        NavigationManager.NavigateTo($"/practice?assignmentId={assign.Id}&subject={Uri.EscapeDataString(assign.Subject)}&category={Uri.EscapeDataString(assign.Category)}&count={assign.QuestionCount}&difficulty={assign.TargetDifficulty}");
    }

    private void StartAdaptivePractice()
    {
        if (_pendingSpacedNodes.Any())
        {
            var first = _pendingSpacedNodes.First();
            NavigationManager.NavigateTo($"/practice?subject={Uri.EscapeDataString(first.Subject)}&category={Uri.EscapeDataString(first.Category)}&mode=spaced_review");
        }
        else if (_masteryOverview.Any(m => m.MasteryScore < 60))
        {
            var weak = _masteryOverview.OrderBy(m => m.MasteryScore).First();
            NavigationManager.NavigateTo($"/practice?subject={Uri.EscapeDataString(weak.Subject)}&category={Uri.EscapeDataString(weak.Category)}");
        }
        else
        {
            NavigationManager.NavigateTo("/practice?mode=sprint");
        }
    }

    private async void OnUserChangedHandler()
    {
        await LoadDashboardDataAsync();
    }

    public void Dispose()
    {
        UserSession.OnUserChanged -= OnUserChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("renderAllMath");
        }
        catch { }
    }

    private string GetAccuracyRate()
    {
        if (_currentUser == null || _currentUser.TotalAnswered == 0) return "100";
        double rate = (double)_currentUser.TotalCorrect / _currentUser.TotalAnswered * 100;
        return rate.ToString("F1");
    }

    private void NavigateCategory(string category, string? subject = null)
    {
        string url = $"/practice?category={Uri.EscapeDataString(category)}";
        if (!string.IsNullOrWhiteSpace(subject))
        {
            url += $"&subject={Uri.EscapeDataString(subject)}";
        }
        NavigationManager.NavigateTo(url);
    }

    private void NavigateSubject(string subject)
    {
        NavigationManager.NavigateTo($"/practice?subject={Uri.EscapeDataString(subject)}");
    }

    private void NavigateSpacedReview(string category, string? subject = null)
    {
        string url = $"/practice?category={Uri.EscapeDataString(category)}&mode=spaced_review";
        if (!string.IsNullOrWhiteSpace(subject))
        {
            url += $"&subject={Uri.EscapeDataString(subject)}";
        }
        NavigationManager.NavigateTo(url);
    }

    private void StartBatchSpacedReview()
    {
        if (_pendingSpacedNodes.Count > 0)
        {
            var first = _pendingSpacedNodes[0];
            NavigateSpacedReview(first.Category, first.Subject);
        }
        else
        {
            NavigationManager.NavigateTo("/practice?mode=sprint");
        }
    }

    private List<string> GetCurrentGradeSubjects()
    {
        string grade = _currentUser?.Grade ?? "初中二年级";
        return GradeSubjectProvider.GetSubjectsByGrade(grade);
    }

    private void OpenEditTargetDialog()
    {
        _newDailyTarget = _currentUser?.DailyTargetQuestions ?? 20;
        _targetDialogVisible = true;
    }

    private async Task SaveDailyTargetAsync()
    {
        if (_currentUser == null) return;
        bool success = await UserSession.UpdateDailyTargetAsync(_currentUser.Id, _newDailyTarget);
        if (success)
        {
            _currentUser.DailyTargetQuestions = _newDailyTarget;
            _targetDialogVisible = false;
            Snackbar.Add($"每日打卡目标已设定为 {_newDailyTarget} 题/天！", Severity.Success);
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsDailyTargetCompleted()
    {
        if (_currentUser == null) return false;
        return _currentUser.TodayAnsweredCount >= _currentUser.DailyTargetQuestions;
    }

    private double GetDailyTargetProgressPercent()
    {
        if (_currentUser == null || _currentUser.DailyTargetQuestions <= 0) return 0;
        return Math.Min(100.0, (double)_currentUser.TodayAnsweredCount / _currentUser.DailyTargetQuestions * 100.0);
    }

    private async Task CopyBindingCodeAsync()
    {
        if (string.IsNullOrEmpty(_currentUser?.BindingCode)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _currentUser.BindingCode);
            Snackbar.Add($"已复制学生专属绑定码：{_currentUser.BindingCode}", Severity.Success);
        }
        catch
        {
            Snackbar.Add($"学生专属绑定码为：{_currentUser.BindingCode}", Severity.Info);
        }
    }

    private void NavigateRecommendedPractice()
    {
        if (_diagnosisReport != null)
        {
            NavigateCategory(_diagnosisReport.RecommendedCategory, _diagnosisReport.RecommendedSubject);
        }
    }

    private int GetExpThreshold()
    {
        return (_currentUser?.Level ?? 1) * 100;
    }

    private double GetExpProgressPercent()
    {
        if (_currentUser == null) return 0;
        int threshold = GetExpThreshold();
        if (threshold <= 0) return 0;
        return Math.Min(100.0, (double)_currentUser.Exp / threshold * 100.0);
    }

    private bool IsDailyRewardClaimed()
    {
        if (_currentUser == null) return false;
        return _currentUser.LastDailyRewardClaimDate.HasValue && _currentUser.LastDailyRewardClaimDate.Value.Date == DateTime.Today;
    }

    private async Task ClaimDailyRewardAsync()
    {
        if (_currentUser == null) return;
        var (success, msg, exp, coins) = await GamificationService.ClaimDailyTargetRewardAsync(_currentUser.Id);
        if (success)
        {
            _currentUser = await GamificationService.GetCurrentUserAsync();
            Snackbar.Add(msg, Severity.Success);

            try
            {
                if (_currentUser.ConfettiEnabled)
                {
                    await JSRuntime.InvokeVoidAsync("triggerConfetti");
                }
                if (_currentUser.SoundEffectsEnabled)
                {
                    await JSRuntime.InvokeVoidAsync("playRewardAudio", "levelup");
                }
            }
            catch { }

            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Snackbar.Add(msg, Severity.Info);
        }
    }

    private void OpenParentNoteDialog()
    {
        if (_selectedChild != null)
        {
            _newParentNote = _selectedChild.ParentEncouragementNote ?? string.Empty;
            _parentNoteDialogVisible = true;
        }
    }

    private async Task SaveParentNoteAsync()
    {
        if (_selectedChild != null && !string.IsNullOrWhiteSpace(_newParentNote))
        {
            var (success, msg) = await UserSession.UpdateParentEncouragementNoteAsync(_selectedChild.Id, _newParentNote);
            if (success)
            {
                _selectedChild.ParentEncouragementNote = _newParentNote.Trim();
                _selectedChild.ParentNoteUpdatedAt = DateTime.Now;
                _parentNoteDialogVisible = false;
                Snackbar.Add("🎉 暖心寄语已发布，孩子将在下次刷新或登录时看到！", Severity.Success);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                Snackbar.Add(msg, Severity.Warning);
            }
        }
    }

    private string GetChildAccuracyRate()
    {
        if (_selectedChild == null || _selectedChild.TotalAnswered == 0) return "0";
        double rate = (double)_selectedChild.TotalCorrect / _selectedChild.TotalAnswered * 100;
        return rate.ToString("F1");
    }
