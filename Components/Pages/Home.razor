        <div class="d-flex align-center gap-3">
            <div class="d-flex align-center justify-center rounded-circle" style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Size="Size.Medium" />
            </div>
            <div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        今日刷题打卡目标
                    </MudText>
                    @if (IsDailyTargetCompleted())
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
                            今日已达成！🎉
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                            还差 @Math.Max(0, (_currentUser?.DailyTargetQuestions ?? 20) - (_currentUser?.TodayAnsweredCount ?? 0)) 题完成
                        </MudChip>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    今日已作答 <strong>@(_currentUser?.TodayAnsweredCount ?? 0)</strong> / <strong>@(_currentUser?.DailyTargetQuestions ?? 20)</strong> 题 · 坚持每日打卡保持连击火花 🔥
                </MudText>
            </div>
        </div>

        <div class="d-flex align-center gap-3 flex-wrap">
            <div style="min-width: 140px;">
                <MudProgressLinear Color="@(IsDailyTargetCompleted() ? Color.Success : Color.Primary)" Value="@GetDailyTargetProgressPercent()" Rounded="true" Style="height: 10px; border-radius: 5px;" />
            </div>
            @if (IsDailyTargetCompleted())
            {
                @if (IsDailyRewardClaimed())
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.EmojiEvents">
