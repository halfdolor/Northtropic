                        <div class="mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true" OnClick='() => NavigationManager.NavigateTo("/practice?mode=socratic")'>
                                体验启发引导 ➔
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="glass-card pa-4 h-100 d-flex flex-column justify-space-between" style="border: 1px dashed rgba(16, 185, 129, 0.4); border-radius: 12px; background: rgba(15, 23, 42, 0.4);">
                        <div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Step 3</MudChip>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">错题净化与靶向消灭</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                答错题目自动归集进错题本，借助艾宾浩斯复习曲线与变式重练，彻底攻克薄弱盲区。
                            </MudText>
                        </div>
                        <div class="mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" FullWidth="true" OnClick='() => NavigationManager.NavigateTo("/error-book")'>
                                前往错题本 ➔
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    }

    <!-- 今日刷题打卡目标进度条 Card -->
