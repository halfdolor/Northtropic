                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" FullWidth="true" OnClick='() => NavigationManager.NavigateTo("/practice")'>
                                立即热身 ➔
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="glass-card pa-4 h-100 d-flex flex-column justify-space-between" style="border: 1px dashed rgba(139, 92, 246, 0.4); border-radius: 12px; background: rgba(15, 23, 42, 0.4);">
                        <div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">Step 2</MudChip>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">苏格拉底 AI 启发</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
