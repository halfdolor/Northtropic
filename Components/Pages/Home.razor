                    <div class="d-flex align-center gap-3">
                        <div class="d-flex align-center justify-center rounded-circle" style="width: 56px; height: 56px; font-size: 2rem; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2)); border: 2px solid var(--mud-palette-primary);">
                            @(!string.IsNullOrEmpty(_currentUser?.Avatar) ? _currentUser.Avatar : "🎓")
