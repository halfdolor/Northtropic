                            </MudText>
                            <!-- 等级经验升级进度条 -->
                            <div class="d-flex align-center gap-2 mt-2" style="max-width: 380px;">
                                <div class="flex-grow-1">
                                    <MudProgressLinear Color="Color.Warning" Value="@GetExpProgressPercent()" Rounded="true" Style="height: 7px; border-radius: 4px;" />
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.75rem; white-space: nowrap;">
                                    @(_currentUser?.Exp ?? 0) / @GetExpThreshold() EXP
                                </MudText>
                            </div>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex justify-md-end gap-2 flex-wrap align-center">
                    @if (_currentUser?.CanAccessSystemConfig == true)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" OnClick='() => NavigationManager.NavigateTo("/settings")'>
                            系统配置
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick='() => NavigationManager.NavigateTo("/error-book")' Style="font-weight: 700;">
