        <div class="glass-card pa-6 mb-6" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 16px;">
            <div class="d-flex align-center gap-3 mb-4">
                <div class="d-flex align-center justify-center rounded-circle" style="width: 44px; height: 44px; background: rgba(59, 130, 246, 0.2); color: #3b82f6;">
                    <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Medium" />
                </div>
                <div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold gradient-text">新手学霸快速起航指南</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">只需 3 步，开启智能自适应学习提分之旅</MudText>
                </div>
            </div>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <div class="glass-card pa-4 h-100 d-flex flex-column justify-space-between" style="border: 1px dashed rgba(59, 130, 246, 0.4); border-radius: 12px; background: rgba(15, 23, 42, 0.4);">
                        <div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Step 1</MudChip>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">极速热身作答</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
