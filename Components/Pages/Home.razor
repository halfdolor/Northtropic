            </MudItem>
            <MudItem xs="12" md="4">
                <div class="glass-card pa-5 d-flex flex-column justify-space-between h-100" style="border: 1px solid rgba(16,185,129,0.3); border-radius: 12px;">
                    <div>
                        <div class="d-inline-flex pa-3 rounded-lg mb-3" style="background: rgba(16,185,129,0.15); color: #10b981;">
                            <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Size="Size.Medium" />
                        </div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">全网题库统一运维</MudText>
