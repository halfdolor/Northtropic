                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.PlayArrow" Class="px-6 py-3 font-weight-bold" Style="border-radius: 12px;" OnClick='() => NavigationManager.NavigateTo("/practice")'>
                        开始今日刷题
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>

    <!-- 家长/老师布置的专属作业待办 (如果存在未完成作业) -->
    @if (_pendingAssignments.Any())
    {
        <div class="glass-card pa-5 mb-6" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(99, 102, 241, 0.15) 100%); border-left: 5px solid #3b82f6; border-radius: 12px; box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15);">
            <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-center gap-2">
                    <div class="d-flex align-center justify-center rounded-circle" style="width: 36px; height: 36px; background: rgba(59, 130, 246, 0.2); color: #3b82f6;">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #3b82f6;">
                        📋 家长/名师布置的专属作业待办 (@_pendingAssignments.Count 份待完成)
                    </MudText>
                </div>
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.NotificationImportant">
