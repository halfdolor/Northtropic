    {
        <div class="glass-card pa-4 mb-6 d-flex align-center justify-space-between flex-wrap gap-3" style="background: linear-gradient(135deg, rgba(236, 72, 153, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%); border-left: 4px solid #ec4899; border-radius: 12px; box-shadow: 0 4px 16px rgba(236, 72, 153, 0.15);">
            <div class="d-flex align-center gap-3">
                <div class="d-flex align-center justify-center rounded-circle" style="width: 44px; height: 44px; background: rgba(236, 72, 153, 0.2); color: #ec4899; flex-shrink: 0;">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Medium" />
                </div>
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold" style="color: #ec4899;">
                            💌 家长暖心寄语
                        </MudText>
