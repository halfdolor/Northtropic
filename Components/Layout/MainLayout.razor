@inherits LayoutComponentBase
@using Northtropic.Models
@using Northtropic.Services
@inject IGamificationService GamificationService
@inject IUserSessionService UserSessionService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider IsDarkMode="@ThemeService.CurrentTheme.IsDarkMode" Theme="@ThemeService.GetMudTheme()" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    :root {
        @ThemeService.CurrentTheme.CssVariables
    }
</style>

<MudLayout Class="@($"theme-{ThemeService.CurrentTheme.Code}")">
    @if (!UserSessionService.IsAuthenticated || _currentUser == null)
    {
        <!-- 全屏强鉴权登录拦截门禁 (不鉴权不允许访问系统) -->
        <div class="d-flex align-center justify-center min-vh-100 pa-4" style="background: radial-gradient(circle at 50% 20%, rgba(59, 130, 246, 0.15), transparent 70%), var(--bg-color, #0f172a); min-height: 100vh;">
            <MudPaper Class="glass-card pa-8 rounded-xl shadow-2xl" Style="max-width: 540px; width: 100%; border: 1px solid var(--glass-card-border); backdrop-filter: blur(20px);">
                <!-- 品牌 Logo 与标题 -->
                <div class="text-center mb-6">
                    <div class="d-inline-flex align-center justify-center pa-3 rounded-circle mb-3" style="background: linear-gradient(135deg, #3b82f6, #8b5cf6);">
                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" Style="color: #ffffff;" />
                    </div>
                    <MudText Typo="Typo.h4" Class="font-weight-bold gradient-text">Northtropic</MudText>
                    <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mt-1">AI 智适应精准助学与错题净化提分系统</MudText>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="mt-2 font-weight-bold">
                        🔒 系统安全鉴权登录网关
                    </MudChip>
                </div>

                <!-- 登录双通道 Tabs -->
                <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Color="Color.Primary" SliderColor="Color.Secondary">
                    <!-- Tab 1: 密码登录 -->
                    <MudTabPanel Text="🔑 密码登录" Icon="@Icons.Material.Filled.Password">
                        <div class="d-flex flex-column gap-4">
                            <MudTextField T="string" @bind-Value="_loginAccount" Label="手机号 / 账号名" Variant="Variant.Outlined"
                                          Placeholder="请输入手机号码或用户名..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AccountCircle"
                                          OnKeyDown="HandlePasswordLoginKeyDown" />

                            <MudTextField T="string" @bind-Value="_loginPassword" Label="登录密码" Variant="Variant.Outlined"
                                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                          Placeholder="请输入登录密码 (默认初始密码 123456)..."
                                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                          OnAdornmentClick="() => _showPassword = !_showPassword"
                                          OnKeyDown="HandlePasswordLoginKeyDown" />

                            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="py-1">
                                💡 提示：所有新开通账号默认密码为 <code>123456</code>，登录后将要求修改密码。
                            </MudAlert>

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login"
                                       OnClick="SubmitPasswordLoginAsync" Disabled="@_isLoggingIn" Class="font-weight-bold py-3 mt-2" Style="border-radius: 10px;">
                                @if (_isLoggingIn)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>鉴权中...</span>
                                }
                                else
                                {
                                    <span>安全登录系统</span>
                                }
                            </MudButton>
                        </div>
                    </MudTabPanel>

                    <!-- Tab 2: 短信验证码登录 -->
                    <MudTabPanel Text="📱 短信登录" Icon="@Icons.Material.Filled.PhonelinkRing">
                        <div class="d-flex flex-column gap-4">
                            <div class="d-flex align-center gap-2">
                                <MudTextField T="string" @bind-Value="_smsPhone" Label="手机号码 (11位)" Variant="Variant.Outlined"
                                              Placeholder="请输入 11 位已注册手机号..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PhoneAndroid"
                                              Immediate="true" Class="flex-grow-1"
                                              OnKeyDown="HandleSmsLoginKeyDown" />

                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(_countdown > 0 || _isSendingCode)"
                                           OnClick="SendSmsCodeAsync" Style="height: 56px; min-width: 130px;">
                                    @if (_isSendingCode)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                        <span>发送中...</span>
                                    }
                                    else if (_countdown > 0)
                                    {
                                        <span>@(_countdown)s 倒计时</span>
                                    }
                                    else
                                    {
                                        <span>获取验证码</span>
                                    }
                                </MudButton>
                            </div>

                            <MudTextField T="string" @bind-Value="_smsCode" Label="6位短信验证码" Variant="Variant.Outlined"
                                          Placeholder="输入收到的短信验证码..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockClock"
                                          MaxLength="6" Immediate="true"
                                          OnKeyDown="HandleSmsLoginKeyDown" />

                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login"
                                       OnClick="SubmitSmsLoginAsync" Disabled="@_isLoggingIn" Class="font-weight-bold py-3 mt-2" Style="border-radius: 10px;">
                                @if (_isLoggingIn)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>验证登录中...</span>
                                }
                                else
                                {
                                    <span>短信验证码登录</span>
                                }
                            </MudButton>
                        </div>
                    </MudTabPanel>

                    <!-- Tab 3: 用户自主注册 -->
                    <MudTabPanel Text="📝 新用户注册" Icon="@Icons.Material.Filled.PersonAdd">
                        @if (!string.IsNullOrEmpty(_registrationSuccessMsg))
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="rounded-lg pa-4 my-2">
                                <div class="font-weight-bold mb-1">🎉 注册申请已成功提交！</div>
                                <div style="font-size: 0.9rem;">
                                    @_registrationSuccessMsg
                                </div>
                                <div class="mt-2 text-caption">
                                    提示：默认初始密码为 <code>123456</code>。请耐心等待超级管理员审批通过后再进行登录。
                                </div>
                            </MudAlert>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-3" OnClick="() => _registrationSuccessMsg = string.Empty">
                                重新提交或登记其他账号
                            </MudButton>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                <!-- 注册模式切换器 -->
                                <div class="d-flex align-center justify-space-between pb-1 border-b">
                                    <MudRadioGroup T="int" @bind-Value="_regMode" Class="d-flex gap-4">
                                        <MudRadio T="int" Value="0" Color="Color.Primary" Dense="true">📱 短信验证码注册</MudRadio>
                                        <MudRadio T="int" Value="1" Color="Color.Secondary" Dense="true">🔐 手工设置密码注册</MudRadio>
                                    </MudRadioGroup>
                                </div>

                                @if (_regSmsFailed && _regMode == 0)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="py-1">
                                        短信发送未成功？建议直接点击
                                        <MudLink Underline="Underline.Always" Color="Color.Secondary" Class="font-weight-bold cursor-pointer" OnClick="() => _regMode = 1">【切换为手工设置密码注册】</MudLink>
                                        提交申请！
                                    </MudAlert>
                                }

                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" @bind-Value="_regUsername" Label="真实姓名 / 用户名 *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Placeholder="请输入您的姓名..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="UserRole" @bind-Value="_regRole" Label="注册身份角色 *" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem Value="UserRole.Student">🎒 学生用户</MudSelectItem>
                                            <MudSelectItem Value="UserRole.Parent">👨‍👩‍👧 家长用户</MudSelectItem>
                                            <MudSelectItem Value="UserRole.Teacher">👩‍🏫 老师用户</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>

                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" @bind-Value="_regPhone" Label="手机号码 (11位) *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Placeholder="请输入 11 位手机号码..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PhoneAndroid" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" @bind-Value="_regEmail" Label="电子邮箱 *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Placeholder="如：example@domain.com" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                                    </MudItem>
                                </MudGrid>

                                <MudSelect T="string" @bind-Value="_regGrade" Label="适学/教学年级" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var grade in GradeSubjectProvider.AvailableGrades)
                                    {
                                        <MudSelectItem Value="@grade">@grade</MudSelectItem>
                                    }
                                </MudSelect>

                                @if (_regMode == 0)
                                {
                                    <!-- 模式 1: 短信验证码注册 (不自动回填，须用户手工查收短信后输入) -->
                                    <div class="d-flex align-center gap-2">
                                        <MudTextField T="string" @bind-Value="_regSmsCode" Label="短信验证码 *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Placeholder="请输入您手机接收到的 6 位验证码..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockClock"
                                                      MaxLength="6" Class="flex-grow-1" />

                                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(_regCountdown > 0 || _isRegSendingCode)"
                                                   OnClick="SendRegSmsCodeAsync" Style="height: 40px; min-width: 120px;" Size="Size.Small">
                                            @if (_isRegSendingCode)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                                <span>发送中...</span>
                                            }
                                            else if (_regCountdown > 0)
                                            {
                                                <span>@(_regCountdown)s</span>
                                            }
                                            else
                                            {
                                                <span>发送验证码</span>
                                            }
                                        </MudButton>
                                    </div>

                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.HowToReg"
                                               OnClick="SubmitRegistrationAsync" Disabled="@_isRegistering" Class="font-weight-bold py-3 mt-2" Style="border-radius: 10px;">
                                        @if (_isRegistering)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            <span>提交审核中...</span>
                                        }
                                        else
                                        {
                                            <span>验证短信并提交注册 (等待审批)</span>
                                        }
                                    </MudButton>
                                }
                                else
                                {
                                    <!-- 模式 2: 手工设置高复杂度密码注册 (常规复杂度要求) -->
                                    <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Class="py-1">
                                        🔒 密码复杂度要求：长度 $\ge 8$ 位，须同时包含英文字母与阿拉伯数字。
                                    </MudAlert>

                                    <MudTextField T="string" @bind-Value="_regManualPassword" Label="设置登录密码 *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  InputType="@(_showRegManualPassword ? InputType.Text : InputType.Password)"
                                                  Placeholder="至少 8 位，包含字母与数字..."
                                                  Adornment="Adornment.End" AdornmentIcon="@(_showRegManualPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                  OnAdornmentClick="() => _showRegManualPassword = !_showRegManualPassword" />

                                    <MudTextField T="string" @bind-Value="_regManualConfirmPassword" Label="确认登录密码 *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  InputType="@(_showRegManualPassword ? InputType.Text : InputType.Password)"
                                                  Placeholder="请再次输入上方密码以确认..." />

                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.LockPerson"
                                               OnClick="SubmitManualPasswordRegistrationAsync" Disabled="@_isRegistering" Class="font-weight-bold py-3 mt-2" Style="border-radius: 10px;">
                                        @if (_isRegistering)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            <span>提交审核中...</span>
                                        }
                                        else
                                        {
                                            <span>提交密码注册申请 (等待审批)</span>
                                        }
                                    </MudButton>
                                }
                            </div>
                        }
                    </MudTabPanel>
                </MudTabs>

                <!-- 🎭 体验账号一键登录通道 (无门槛体验 4 大角色) -->
                @if (!_isProductionMode)
                {
                    <div class="mt-4 pa-4 glass-card" style="background: rgba(59, 130, 246, 0.06); border: 1px dashed rgba(59, 130, 246, 0.4); border-radius: 12px;">
                        <div class="d-flex align-center justify-space-between mb-2 flex-wrap gap-1">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--mud-palette-secondary);">
                                    🎭 快捷体验通道 · 4 大角色一键进入
                                </MudText>
                            </div>
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Text">免密极速体验</MudChip>
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.School" Class="justify-start text-left py-2"
                                           OnClick='() => QuickDemoLoginAsync("Student")' Disabled="@_isLoggingIn">
                                    <div>
                                        <div class="font-weight-bold">🎓 学员 · 李小明</div>
                                        <div class="mud-text-secondary" style="font-size: 0.72rem;">初二/刷题/错题副本</div>
                                    </div>
                                </MudButton>
                            </MudItem>
                            <MudItem xs="6">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.FamilyRestroom" Class="justify-start text-left py-2"
                                           OnClick='() => QuickDemoLoginAsync("Parent")' Disabled="@_isLoggingIn">
                                    <div>
                                        <div class="font-weight-bold">👨‍👩‍👧 家长 · 李大强</div>
                                        <div class="mud-text-secondary" style="font-size: 0.72rem;">学情雷达/定制做题</div>
                                    </div>
                                </MudButton>
                            </MudItem>
                            <MudItem xs="6">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.PersonSearch" Class="justify-start text-left py-2"
                                           OnClick='() => QuickDemoLoginAsync("Teacher")' Disabled="@_isLoggingIn">
                                    <div>
                                        <div class="font-weight-bold">👩‍🏫 名师 · 张老师</div>
                                        <div class="mud-text-secondary" style="font-size: 0.72rem;">题库录入/OCR拍照</div>
                                    </div>
                                </MudButton>
                            </MudItem>
                            <MudItem xs="6">
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.AdminPanelSettings" Class="justify-start text-left py-2"
                                           OnClick='() => QuickDemoLoginAsync("Admin")' Disabled="@_isLoggingIn">
                                    <div>
                                        <div class="font-weight-bold">🛡️ 超级管理员</div>
                                        <div class="mud-text-secondary" style="font-size: 0.72rem;">系统总控/用户审核</div>
                                    </div>
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </div>
                }

                <!-- 底部安全与超时说明 -->
                <div class="mt-5 text-center">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        ⏱️ 安全机制：系统 30 分钟无响应自动退出 | 🛡️ 新建账号默认密码 123456
                    </MudText>
                </div>
            </MudPaper>
        </div>
    }
    else
    {
        <!-- 已鉴权：顶栏励志成长状态栏与登录区域 -->
        <MudAppBar Elevation="1" Style="@ThemeService.CurrentTheme.AppbarStyle">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            
            <MudText Typo="Typo.h6" Class="gradient-text font-weight-bold ml-2">
                Northtropic
            </MudText>

            <MudSpacer />

            <!-- 励志进阶学霸状态 (统一 5 色纯净风格 - 桌面端) -->
            <div class="d-none d-md-flex align-center gap-3">
                <!-- 打卡 Streak -->
                <div class="d-flex align-center gap-1 px-3 py-1 glass-card" style="border-radius: 20px;">
                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                        @_currentUser.CurrentStreak 天连胜
                    </MudText>
                </div>

                <!-- 金币 Coins -->
                <div class="d-flex align-center gap-1 px-3 py-1 glass-card" style="border-radius: 20px;">
                    <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                        @_currentUser.Coins 金币
                    </MudText>
                </div>

                <!-- 等级 & 经验条 -->
                <div class="d-flex align-center gap-2 px-3 py-1 glass-card" style="border-radius: 20px; min-width: 140px;">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 800;">
                        Lv.@_currentUser.Level
                    </MudChip>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-space-between mb-1" style="font-size: 0.75rem;">
                            <span>EXP</span>
                            <span>@_currentUser.Exp / @(_currentUser.Level * 100)</span>
                        </div>
                        <MudProgressLinear Color="Color.Primary" Value="@((double)_currentUser.Exp / (_currentUser.Level * 100) * 100)" Style="height: 5px; border-radius: 3px;" />
                    </div>
                </div>

                <!-- 3 大风格主题选择器 -->
                <MudSelect T="string" Value="@ThemeService.CurrentTheme.Code" ValueChanged="OnThemeChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px; border-radius: 20px; font-weight: 700;">
                    @foreach (var t in ThemeService.AvailableThemes)
                    {
                        <MudSelectItem Value="@t.Code">@t.Name</MudSelectItem>
                    }
                </MudSelect>

                <!-- 全局 LLM Token 账单按钮 (仅超级管理员可见) -->
                @if (_currentUser?.CanAccessSystemConfig == true)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="() => _tokenDrawerOpen = true" Style="border-radius: 20px; font-weight: 700;">
                        LLM 账单
                    </MudButton>
                }

                <!-- 快捷音效静音切换 (桌面端) -->
                <MudTooltip Text="@(_currentUser?.SoundEffectsEnabled == false ? "🔇 答题音效已静音 (点击开启)" : "🔊 答题音效已开启 (点击静音)")">
                    <MudIconButton Icon="@(_currentUser?.SoundEffectsEnabled == false ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                   Color="@(_currentUser?.SoundEffectsEnabled == false ? Color.Default : Color.Primary)"
                                   OnClick="ToggleSoundEffectsAsync"
                                   Size="Size.Medium" />
                </MudTooltip>

                <!-- 🎭 快速切换体验身份快捷菜单 (桌面端) -->
                @if (!_isProductionMode)
                {
                    <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SwapHoriz" EndIcon="@Icons.Material.Filled.ArrowDropDown" Style="border-radius: 20px; font-weight: 700;">
                                🎭 切身份
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="px-4 py-2 font-weight-bold" style="font-size: 0.78rem; border-bottom: 1px solid var(--glass-card-border); color: #94a3b8;">
                                🎭 无需重新输入账号 · 一键热切换
                            </div>
                            <MudMenuItem Icon="@Icons.Material.Filled.School" IconColor="Color.Primary" OnClick='() => SwitchToPersonaAsync("Student")'>
                                🎓 切换至：学员 · 李小明 (初二 · 刷题/错题/成长)
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.FamilyRestroom" IconColor="Color.Secondary" OnClick='() => SwitchToPersonaAsync("Parent")'>
                                👨‍👩‍👧 切换至：家长 · 李大强 (学情雷达/定制做题)
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.PersonSearch" IconColor="Color.Warning" OnClick='() => SwitchToPersonaAsync("Teacher")'>
                                👩‍🏫 切换至：名师 · 张老师 (题库录入/OCR拍照)
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Error" OnClick='() => SwitchToPersonaAsync("Admin")'>
                                🛡️ 切换至：超级管理员 (系统总控/用户审批)
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                }

                <!-- 用户菜单 (角色展示、修改个人资料、修改密码、切换用户、退出登录) -->
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowDropDown" Style="border-radius: 20px; font-weight: 700; padding: 6px 14px;">
                            <span style="font-size: 1.25rem; line-height: 1;" class="mr-2">@(!string.IsNullOrEmpty(_currentUser?.Avatar) ? _currentUser.Avatar : "🎓")</span>
                            <span class="mr-1">@_currentUser?.RoleDisplayName</span>
                            <span>@_currentUser?.Username</span>
