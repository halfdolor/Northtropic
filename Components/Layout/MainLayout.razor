                            <MudMenuItem Icon="@Icons.Material.Filled.School" IconColor="Color.Primary" OnClick='() => SwitchToPersonaAsync("Student")'>
                                🎓 学员 · 李小明
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.FamilyRestroom" IconColor="Color.Secondary" OnClick='() => SwitchToPersonaAsync("Parent")'>
