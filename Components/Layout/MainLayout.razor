                        </div>
                        @if (_currentUser?.CanAccessSystemConfig == true)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.ReceiptLong" OnClick="() => _tokenDrawerOpen = true">LLM 账单</MudMenuItem>
