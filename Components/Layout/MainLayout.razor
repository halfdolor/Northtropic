                        <MudMenuItem Icon="@Icons.Material.Filled.Palette">
                            <div class="d-flex align-center justify-space-between gap-2" style="width: 100%;">
                                <span>切换主题</span>
                                <MudSelect T="string" Value="@ThemeService.CurrentTheme.Code" ValueChanged="OnThemeChanged" Margin="Margin.Dense" Style="min-width: 120px;">
                                    @foreach (var t in ThemeService.AvailableThemes)
                                    {
                                        <MudSelectItem Value="@t.Code">@t.Name</MudSelectItem>
