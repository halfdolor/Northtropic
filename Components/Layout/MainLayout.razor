            </div>

            <!-- 移动端精简顶栏状态与快捷菜单 -->
            <div class="d-flex d-md-none align-center gap-2">
                <div class="d-flex align-center gap-1 px-2 py-1 glass-card" style="border-radius: 16px; font-size: 0.8rem;">
