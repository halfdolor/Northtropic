                               Size="Size.Small" />

                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudIconButton Color="Color.Primary" Size="Size.Medium">
                            <span style="font-size: 1.4rem;">@(!string.IsNullOrEmpty(_currentUser?.Avatar) ? _currentUser.Avatar : "🎓")</span>
                        </MudIconButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="d-flex align-center gap-3 px-3 py-2" style="border-bottom: 1px solid var(--glass-card-border); background: var(--sub-card-bg); min-width: 220px;">
                            <div class="d-inline-flex align-center justify-center rounded-circle flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.6rem; background: rgba(59,130,246,0.15); border: 2px solid var(--mud-palette-primary);">
                                @(!string.IsNullOrEmpty(_currentUser?.Avatar) ? _currentUser.Avatar : "🎓")
                            </div>
                            <div style="min-width: 0; flex-grow: 1;">
                                <div class="font-weight-bold" style="font-size: 1.1rem; line-height: 1.25; color: var(--glass-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @_currentUser?.Username
                                </div>
                                <div class="d-flex align-center gap-1 mt-1" style="font-size: 0.75rem; color: #94a3b8;">
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Style="height: 18px; font-size: 0.7rem; padding: 0 6px;">
                                        Lv.@_currentUser?.Level @_currentUser?.RoleDisplayName
                                    </MudChip>
