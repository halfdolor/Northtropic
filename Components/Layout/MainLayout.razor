                    </ActivatorContent>
                    <ChildContent>
                        <div class="d-flex align-center gap-3 px-4 py-3" style="border-bottom: 1px solid var(--glass-card-border); background: var(--sub-card-bg); min-width: 240px;">
                            <div class="d-inline-flex align-center justify-center rounded-circle flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.85rem; background: rgba(59,130,246,0.15); border: 2px solid var(--mud-palette-primary);">
                                @(!string.IsNullOrEmpty(_currentUser?.Avatar) ? _currentUser.Avatar : "🎓")
                            </div>
                            <div style="min-width: 0; flex-grow: 1;">
                                <div class="font-weight-bold" style="font-size: 1.15rem; line-height: 1.25; color: var(--glass-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @_currentUser?.Username
                                </div>
                                <div class="d-flex align-center gap-1 mt-1 text-muted" style="font-size: 0.78rem;">
                                    <span>@_currentUser?.RoleDisplayName</span>
