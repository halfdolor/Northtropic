                        <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts" OnClick="OpenEditProfileDialog">编辑个人资料</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Key" OnClick="OpenChangePasswordDialog">修改登录密码</MudMenuItem>
                        @if (!_isProductionMode)
                        {
                            <MudDivider />
                            <div class="px-4 py-1 font-weight-bold" style="font-size: 0.75rem; color: #94a3b8;">
                                🎭 快速切换身份
                            </div>
                            <MudMenuItem Icon="@Icons.Material.Filled.School" IconColor="Color.Primary" OnClick='() => SwitchToPersonaAsync("Student")'>
                                🎓 学员 · 李小明
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.FamilyRestroom" IconColor="Color.Secondary" OnClick='() => SwitchToPersonaAsync("Parent")'>
                                👨‍👩‍👧 家长 · 李大强
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.PersonSearch" IconColor="Color.Warning" OnClick='() => SwitchToPersonaAsync("Teacher")'>
                                👩‍🏫 名师 · 张老师
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Error" OnClick='() => SwitchToPersonaAsync("Admin")'>
                                🛡️ 超级管理员
                            </MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="LogoutAsync">安全退出登录</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </MudAppBar>

        <Northtropic.Components.Dialogs.LlmTokenDrawer @bind-IsOpen="_tokenDrawerOpen" />

        <!-- 侧边导航栏 (结合 4 类角色 RBAC 动态过滤) -->
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Style="@ThemeService.CurrentTheme.DrawerStyle">
            <div class="d-flex flex-column justify-space-between h-100">
                <MudNavMenu Class="mt-4">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
                        主面板
                    </MudNavLink>
                    <MudNavLink Href="/practice" Icon="@Icons.Material.Filled.SportsEsports" IconColor="Color.Primary">
                        刷题中心
                    </MudNavLink>
                    <MudNavLink Href="/error-book" Icon="@Icons.Material.Filled.AutoFixHigh" IconColor="Color.Primary">
                        净化副本
                    </MudNavLink>
                    <MudNavLink Href="/practice-records" Icon="@Icons.Material.Filled.Analytics" IconColor="Color.Primary">
                        闯关分析
                    </MudNavLink>

                    <!-- 老师 & 超级管理员专属：题库管理 -->
                    @if (_currentUser?.CanManageQuestionBank == true)
                    {
                        <MudNavLink Href="/question-management" Icon="@Icons.Material.Filled.LibraryBooks" IconColor="Color.Warning">
                            题库管理
                        </MudNavLink>
                    }

                    <!-- 家长、名师 & 超级管理员：学情大盘与作业 -->
                    @if (_currentUser?.CanViewStudentAnalytics == true)
                    {
                        <MudNavLink Href="/parent-dashboard" Icon="@Icons.Material.Filled.FamilyRestroom" IconColor="Color.Secondary">
                            @(_currentUser?.Role == UserRole.Teacher ? "学情与作业" : "学情分析")
                        </MudNavLink>
                    }

                    <MudNavLink Href="/achievements" Icon="@Icons.Material.Filled.EmojiEvents" IconColor="Color.Primary">
                        荣誉商城
                    </MudNavLink>

                    <!-- 超级管理员专属：帐号管理 -->
                    @if (_currentUser?.CanManageUsers == true)
                    {
                        <MudNavLink Href="/user-management" Icon="@Icons.Material.Filled.PeopleAlt" IconColor="Color.Error">
                            帐号管理
                        </MudNavLink>
                    }

                    <!-- 超级管理员专属：系统配置 -->
                    @if (_currentUser?.CanAccessSystemConfig == true)
                    {
                        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Error">
                            系统配置
                        </MudNavLink>
                    }
                </MudNavMenu>

                <!-- 侧边栏底部用户信息卡片 -->
                <div class="pa-4 ma-2 glass-card cursor-pointer" style="border-radius: 12px; background: rgba(255,255,255,0.03);" @onclick="OpenEditProfileDialog">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <div class="d-flex align-center gap-2">
                            <div class="d-flex align-center justify-center rounded-circle" style="width: 34px; height: 34px; font-size: 1.3rem; background: rgba(59,130,246,0.15);">
                                @(!string.IsNullOrEmpty(_currentUser?.Avatar) ? _currentUser.Avatar : "🎓")
                            </div>
                            <div>
                                <div class="font-weight-bold" style="font-size: 0.85rem; max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(_currentUser?.Username ?? "未登录")
                                </div>
                                <div style="font-size: 0.7rem; color: #94a3b8;">
                                    @(_currentUser?.RoleDisplayName ?? "学员")
                                </div>
                            </div>
                        </div>
                        <MudTooltip Text="编辑个人资料">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small" OnClick="OpenEditProfileDialog" />
                        </MudTooltip>
                    </div>
                </div>
            </div>
        </MudDrawer>

        <!-- 主内容区 -->
        <MudMainContent Class="pa-6" Style="@($"background: {ThemeService.CurrentTheme.BackgroundColor}; min-height: 100vh; transition: background 0.4s ease;")">
            @Body
        </MudMainContent>
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private User? _currentUser;
    private bool _isProductionMode = false;
    private bool _tokenDrawerOpen = false;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    // 门禁登录表单变量
    private string _loginAccount = string.Empty;
    private string _loginPassword = string.Empty;
    private bool _showPassword = false;
    private bool _isLoggingIn = false;

    private string _smsPhone = string.Empty;
    private string _smsCode = string.Empty;
    private bool _isSendingCode = false;
    private int _countdown = 0;
    private bool _isNewUserRegister = false;
    private UserRole _selectedRole = UserRole.Parent;
    private string _registerUsername = string.Empty;
    private string _registerGrade = "初中二年级";

    // 自主注册表单变量
    private int _regMode = 0; // 0: 短信验证码注册, 1: 手工设置密码注册
    private bool _regSmsFailed = false;
    private string _regUsername = string.Empty;
    private UserRole _regRole = UserRole.Student;
    private string _regPhone = string.Empty;
    private string _regEmail = string.Empty;
    private string _regGrade = "初中二年级";
    private string _regSmsCode = string.Empty;
    private string _regManualPassword = string.Empty;
    private string _regManualConfirmPassword = string.Empty;
    private bool _showRegManualPassword = false;
    private int _regCountdown = 0;
    private bool _isRegSendingCode = false;
    private bool _isRegistering = false;
    private string _registrationSuccessMsg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        UserSessionService.OnUserChanged += OnUserChangedHandler;
        ThemeService.OnThemeChanged += OnThemeChangedHandler;
        await LoadUserDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("initInactivityTracker", _dotNetRef, _currentUser?.SessionTimeoutMinutes ?? 30);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnInactivityWarningOccurred(int secondsLeft)
    {
        if (UserSessionService.IsAuthenticated)
        {
            Snackbar.Add(
                $"⏱️ 会话闲置预警：系统将在约 {Math.Max(1, secondsLeft / 60)} 分钟后自动登出。点击【继续学习】可立即一键续期！",
                Severity.Warning,
                config =>
                {
                    config.Action = "继续学习";
                    config.ActionColor = Color.Primary;
                    config.Onclick = async snackbar =>
                    {
                        await ExtendSessionAsync();
                    };
                });
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task ExtendSessionAsync()
    {
        UserSessionService.RecordUserActivity();
        try
        {
            await JS.InvokeVoidAsync("extendUserSession");
        }
        catch { }
        Snackbar.Add("✅ 会话已成功一键续期，祝您练习愉快！", Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnInactivityTimeoutOccurred()
    {
        if (UserSessionService.IsAuthenticated)
        {
            await UserSessionService.LogoutAsync();
            _currentUser = null;
            Snackbar.Add("⏱️ 系统检测到您已超过 30 分钟无操作，已自动安全退出登录！", Severity.Warning);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePasswordLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoggingIn)
        {
            await SubmitPasswordLoginAsync();
        }
    }

    private async Task HandleSmsLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoggingIn)
        {
            await SubmitSmsLoginAsync();
        }
    }

    private async Task SubmitPasswordLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_loginAccount) || string.IsNullOrWhiteSpace(_loginPassword))
        {
            Snackbar.Add("账号与密码不能为空！", Severity.Warning);
            return;
        }

        _isLoggingIn = true;
        await InvokeAsync(StateHasChanged);

        var (success, user, message) = await UserSessionService.LoginWithPasswordAsync(_loginAccount, _loginPassword);

        _isLoggingIn = false;
        if (success && user != null)
        {
            _currentUser = user;
            Snackbar.Add(message, Severity.Success);
            await LoadUserDataAsync();

            if (user.MustChangePassword)
            {
                await PromptMandatoryPasswordChangeAsync(user.Id);
            }
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task QuickDemoLoginAsync(string roleOrPhone)
    {
        _isLoggingIn = true;
        await InvokeAsync(StateHasChanged);

        var (success, user, message) = await UserSessionService.QuickLoginDemoUserAsync(roleOrPhone);
        _isLoggingIn = false;

        if (success && user != null)
        {
            _currentUser = user;
            Snackbar.Add(message, Severity.Success);
            await LoadUserDataAsync();
            NavigationManager.NavigateTo("/", forceLoad: false);
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SwitchToPersonaAsync(string roleOrPhone)
    {
        var (success, user, message) = await UserSessionService.QuickLoginDemoUserAsync(roleOrPhone);
        if (success && user != null)
        {
            _currentUser = user;
            Snackbar.Add(message, Severity.Success);
            await LoadUserDataAsync();
            NavigationManager.NavigateTo("/", forceLoad: false);
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
        }
    }

    private void OnSmsPhoneKeyUp()
    {
        if (System.Text.RegularExpressions.Regex.IsMatch(_smsPhone.Trim(), @"^1[3-9]\d{9}$"))
        {
            CheckPhoneRegisteredState();
        }
    }

    private async void CheckPhoneRegisteredState()
    {
        var users = await UserSessionService.GetAllUsersAsync();
        var exists = users.Any(u => u.PhoneNumber == _smsPhone.Trim());
        _isNewUserRegister = !exists;
        StateHasChanged();
    }

    private async Task SendSmsCodeAsync()
    {
        if (!System.Text.RegularExpressions.Regex.IsMatch(_smsPhone.Trim(), @"^1[3-9]\d{9}$"))
        {
            Snackbar.Add("请输入正确的 11 位手机号码！", Severity.Warning);
            return;
        }

        _isSendingCode = true;
        var res = await UserSessionService.SendSmsCodeAsync(_smsPhone);
        _isSendingCode = false;

        if (res.Success)
        {
            Snackbar.Add(res.Message, Severity.Success);
            _smsCode = string.Empty; // 不自动回填，必须等待用户查收短信后自行输入
            StartCountdown();
            CheckPhoneRegisteredState();
        }
        else
        {
            Snackbar.Add(res.Message, Severity.Warning);
        }
    }

    private async void StartCountdown()
    {
        _countdown = 60;
        while (_countdown > 0)
        {
            await Task.Delay(1000);
            _countdown--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SubmitSmsLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_smsPhone) || string.IsNullOrWhiteSpace(_smsCode))
        {
            Snackbar.Add("手机号与验证码不能为空！", Severity.Warning);
            return;
        }

        _isLoggingIn = true;
        await InvokeAsync(StateHasChanged);

        var (success, user, message) = await UserSessionService.LoginOrRegisterWithSmsAsync(_smsPhone, _smsCode, _selectedRole, _registerUsername, _registerGrade);

        _isLoggingIn = false;
        if (success && user != null)
        {
            _currentUser = user;
            Snackbar.Add(message, Severity.Success);
            await LoadUserDataAsync();

            if (user.MustChangePassword)
            {
                await PromptMandatoryPasswordChangeAsync(user.Id);
            }
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendRegSmsCodeAsync()
    {
        if (!System.Text.RegularExpressions.Regex.IsMatch(_regPhone.Trim(), @"^1[3-9]\d{9}$"))
        {
            Snackbar.Add("请输入正确的 11 位中国大陆手机号码！", Severity.Warning);
            return;
        }

        _isRegSendingCode = true;
        var res = await UserSessionService.SendSmsCodeAsync(_regPhone);
        _isRegSendingCode = false;

        if (res.Success)
        {
            _regSmsFailed = false;
            Snackbar.Add(res.Message, Severity.Success);
            _regSmsCode = string.Empty; // 不自动回填，必须等待用户查收短信后自行输入
            _regCountdown = 60;
            StartRegCountdown();
        }
        else
        {
            _regSmsFailed = true;
            Snackbar.Add(res.Message, Severity.Warning);
        }
    }

    private async void StartRegCountdown()
    {
        while (_regCountdown > 0)
        {
            await Task.Delay(1000);
            _regCountdown--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SubmitRegistrationAsync()
    {
        if (string.IsNullOrWhiteSpace(_regUsername))
        {
            Snackbar.Add("请输入真实姓名！", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_regPhone) || !System.Text.RegularExpressions.Regex.IsMatch(_regPhone.Trim(), @"^1[3-9]\d{9}$"))
        {
            Snackbar.Add("请输入正确的 11 位手机号码！", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_regEmail) || !_regEmail.Contains("@"))
        {
            Snackbar.Add("请输入有效的电子邮箱地址！", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_regSmsCode))
        {
            Snackbar.Add("请输入短信验证码！", Severity.Warning);
            return;
        }

        _isRegistering = true;
        await InvokeAsync(StateHasChanged);

        var (success, user, message) = await UserSessionService.RegisterWithSmsAsync(
            _regUsername,
            _regRole,
            _regPhone,
            _regEmail,
            _regSmsCode,
            _regGrade
        );

        _isRegistering = false;
        if (success)
        {
            _registrationSuccessMsg = message;
            Snackbar.Add("🎉 注册成功！已提交管理员审批。", Severity.Success);
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitManualPasswordRegistrationAsync()
    {
        if (string.IsNullOrWhiteSpace(_regUsername))
        {
            Snackbar.Add("请输入真实姓名！", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_regPhone) || !System.Text.RegularExpressions.Regex.IsMatch(_regPhone.Trim(), @"^1[3-9]\d{9}$"))
        {
            Snackbar.Add("请输入正确的 11 位手机号码！", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_regEmail) || !_regEmail.Contains("@"))
        {
            Snackbar.Add("请输入有效的电子邮箱地址！", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_regManualPassword))
        {
            Snackbar.Add("请设置登录密码！", Severity.Warning);
            return;
        }
        if (_regManualPassword.Length < 8)
        {
            Snackbar.Add("密码长度不能少于 8 位！", Severity.Warning);
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_regManualPassword, @"[a-zA-Z]") || !System.Text.RegularExpressions.Regex.IsMatch(_regManualPassword, @"[0-9]"))
        {
            Snackbar.Add("密码必须同时包含英文字母与阿拉伯数字！", Severity.Warning);
            return;
        }
        if (_regManualPassword != _regManualConfirmPassword)
        {
            Snackbar.Add("两次输入的密码不一致！", Severity.Warning);
            return;
        }

        _isRegistering = true;
        await InvokeAsync(StateHasChanged);

        var (success, user, message) = await UserSessionService.RegisterWithPasswordAsync(
            _regUsername,
            _regRole,
            _regPhone,
            _regEmail,
            _regManualPassword,
            _regManualConfirmPassword,
            _regGrade
        );

        _isRegistering = false;
        if (success)
        {
            _registrationSuccessMsg = message;
            Snackbar.Add("🎉 密码注册申请提交成功！已提交管理员审批。", Severity.Success);
        }
        else
        {
            Snackbar.Add(message, Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task PromptMandatoryPasswordChangeAsync(Guid userId)
    {
        var parameters = new DialogParameters<Northtropic.Components.Dialogs.ChangePasswordDialog>
        {
            { x => x.UserId, userId },
            { x => x.IsMandatory, true }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false,
            CloseButton = false
        };

        var dialog = await DialogService.ShowAsync<Northtropic.Components.Dialogs.ChangePasswordDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadUserDataAsync();
        }
    }

    private async Task OpenEditProfileDialog()
    {
        if (_currentUser == null) return;
        var parameters = new DialogParameters<Northtropic.Components.Dialogs.EditProfileDialog>
        {
            { x => x.CurrentUser, _currentUser }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<Northtropic.Components.Dialogs.EditProfileDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadUserDataAsync();
        }
    }

    private async Task OpenChangePasswordDialog()
    {
        if (_currentUser == null) return;
        var parameters = new DialogParameters<Northtropic.Components.Dialogs.ChangePasswordDialog>
        {
            { x => x.UserId, _currentUser.Id },
            { x => x.IsMandatory, false }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<Northtropic.Components.Dialogs.ChangePasswordDialog>("", parameters, options);
    }

    private void OnThemeChanged(string code)
    {
        ThemeService.SetTheme(code);
    }

    private async void OnThemeChangedHandler()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserDataAsync()
    {
        _isProductionMode = await UserSessionService.IsProductionModeAsync();
        if (UserSessionService.IsAuthenticated)
        {
            _currentUser = await UserSessionService.GetActiveUserAsync();
            if (_currentUser != null)
            {
                if (_currentUser.AccountStatus == UserAccountStatus.Disabled)
                {
                    await UserSessionService.LogoutAsync();
                    _currentUser = null;
                    Snackbar.Add("当前体验账号在正式模式下已禁用，已自动退出。", Severity.Warning);
                }
                else
                {
                    await GamificationService.UpdateStreakAsync();
                }
            }
        }
        else
        {
            _currentUser = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void OnUserChangedHandler()
    {
        await LoadUserDataAsync();
    }

    private async Task LogoutAsync()
    {
        await UserSessionService.LogoutAsync();
        _currentUser = null;
        Snackbar.Add("您已成功安全退出登录！", Severity.Info);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSoundEffectsAsync()
    {
        if (_currentUser == null) return;
        bool newStatus = !_currentUser.SoundEffectsEnabled;
        _currentUser.SoundEffectsEnabled = newStatus;
        await UserSessionService.UpdateSoundEffectsEnabledAsync(_currentUser.Id, newStatus);
        if (newStatus)
        {
            Snackbar.Add("🔊 答题音效反馈已开启！", Severity.Success);
        }
        else
        {
            Snackbar.Add("🔇 已切换至图书馆静音专注模式！", Severity.Info);
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserSessionService.OnUserChanged -= OnUserChangedHandler;
        ThemeService.OnThemeChanged -= OnThemeChangedHandler;
        _dotNetRef?.Dispose();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
