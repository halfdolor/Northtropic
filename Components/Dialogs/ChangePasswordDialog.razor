@using Northtropic.Services
@using Northtropic.Models
@inject IUserSessionService UserSessionService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-3 pa-4" style="background: linear-gradient(135deg, rgba(239,68,68,0.1), rgba(245,158,11,0.1)); border-bottom: 1px solid var(--glass-card-border);">
            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Error" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    @(IsMandatory ? "首次登录安全提醒 - 请修改初始密码" : "修改登录密码")
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(IsMandatory ? "系统新建账号默认密码为 123456。为保障数据安全，必须修改新密码后方可继续使用。" : "请定期修改密码以确保您的账号安全。")
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-6">
            @if (IsMandatory)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="rounded-lg">
                    <strong>⚠️ 强安全卡控：</strong> 您当前使用的是系统初始默认密码 <code>123456</code>。请立即设置 6 位以上的新密码，修改完成后将自动解锁所有学习功能。
                </MudAlert>
            }

            <MudTextField T="string" @bind-Value="_oldPassword" Label="当前原密码" Variant="Variant.Outlined"
                          InputType="InputType.Password" Placeholder="如为初始账号请输入 123456"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockOpen"
                          OnKeyDown="HandleKeyDown" />

            <MudTextField T="string" @bind-Value="_newPassword" Label="设置新密码 (至少6位，不可为123456)" Variant="Variant.Outlined"
                          InputType="InputType.Password" Placeholder="请输入 6 位以上新密码..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          OnKeyDown="HandleKeyDown" />

            <MudTextField T="string" @bind-Value="_confirmPassword" Label="确认新密码" Variant="Variant.Outlined"
                          InputType="InputType.Password" Placeholder="请再次输入新密码..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CheckCircleOutline"
                          OnKeyDown="HandleKeyDown" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="py-1">
                    @_errorMessage
                </MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (IsMandatory)
        {
            <MudButton Color="Color.Default" OnClick="LogoutAndCancelAsync" StartIcon="@Icons.Material.Filled.Logout">
                退出登录
            </MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">取消</MudButton>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SubmitChangePasswordAsync" Disabled="@_isSubmitting" Class="px-6 font-weight-bold" Style="border-radius: 8px;">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>保存中...</span>
            }
            else
            {
                <span>确认修改密码</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public bool IsMandatory { get; set; } = true;

    private string _oldPassword = "123456";
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isSubmitting = false;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isSubmitting)
        {
            await SubmitChangePasswordAsync();
        }
    }

    private async Task SubmitChangePasswordAsync()
    {
        _errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMessage = "新密码不能为空！";
            return;
        }

        if (_newPassword.Length < 6)
        {
            _errorMessage = "新密码长度不能少于 6 位字符！";
            return;
        }

        if (_newPassword == "123456")
        {
            _errorMessage = "新密码不能与初始默认密码 123456 相同！";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "两次输入的新密码不一致，请重新核对！";
            return;
        }

        _isSubmitting = true;
        await InvokeAsync(StateHasChanged);

        var (success, message) = await UserSessionService.ChangePasswordAsync(UserId, _oldPassword, _newPassword);

        _isSubmitting = false;
        if (success)
        {
            Snackbar.Add("🎉 " + message, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = message;
            Snackbar.Add(message, Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LogoutAndCancelAsync()
    {
        await UserSessionService.LogoutAsync();
        MudDialog.Cancel();
    }

    private void Cancel() => MudDialog.Cancel();
}
