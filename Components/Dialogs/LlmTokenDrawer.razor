@using Northtropic.Models
@using Northtropic.Services
@inject IPracticeService PracticeService
@inject IGamificationService GamificationService

<!-- 全局可开启的 AI 出题历史与 Token 消耗账单 抽屉 Drawer -->
<MudDrawer @bind-Open="IsOpen" Anchor="Anchor.Right" Elevation="5" Variant="DrawerVariant.Temporary" Width="480px" Style="background: #1e1e2d; color: #fff;">
    <MudDrawerHeader Class="d-flex align-center justify-space-between border-b border-solid pa-4" Style="border-color: rgba(255,255,255,0.1) !important;">
        <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info" /> 📜 LLM Token 消费账单 & 历史
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="Close" />
    </MudDrawerHeader>
    
    <div class="pa-4">
        @if (_loading)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Info" />
            </div>
        }
        else
        {
            <!-- Total Token Summary Card -->
            <div class="glass-card pa-4 mb-4" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(168, 85, 247, 0.2)); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 12px;">
                <MudText Typo="Typo.caption" Style="color: #94a3b8;" Class="d-block mb-1">当前学员 LLM 消耗总额</MudText>
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: #60a5fa;">
                        @_llmHistoryLogs.Sum(l => l.TotalTokens) <span style="font-size: 14px; color: #cbd5e1;">Tokens</span>
                    </MudText>
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">已生成 @_llmHistoryLogs.Count 道题</MudChip>
                </div>
                <div class="d-flex gap-4" style="font-size: 12px; color: #cbd5e1;">
                    <span>📥 Prompt: <strong>@_llmHistoryLogs.Sum(l => l.PromptTokens)</strong></span>
                    <span>📤 Output: <strong>@_llmHistoryLogs.Sum(l => l.CompletionTokens)</strong></span>
                </div>
            </div>

            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color: #94a3b8;">出题流水日志与题目记录：</MudText>

            @if (_llmHistoryLogs.Count == 0)
            {
                <div class="text-center py-8" style="color: #64748b;">
                    <MudIcon Icon="@Icons.Material.Filled.HistoryToggleOff" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.body2">暂无 AI 出题记录，快去刷题中心开启 AI 组卷吧！</MudText>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" style="max-height: calc(100vh - 240px); overflow-y: auto;">
                    @foreach (var log in _llmHistoryLogs)
                    {
                        <div class="glass-card pa-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px;">
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@log.Subject - @log.Category</MudChip>
                                <span style="font-size: 11px; color: #64748b;">@log.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <MudText Typo="Typo.body2" Class="my-1 text-truncate" Style="max-width: 380px; color: #e2e8f0;">
                                @(log.Question?.Stem ?? "AI 出题记录")
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-2" style="font-size: 11px; color: #94a3b8;">
                                <span>🤖 @log.ModelName</span>
                                <span style="color: #38bdf8; font-weight: 600;">⚡ @log.TotalTokens Tokens (In:@log.PromptTokens Out:@log.CompletionTokens)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</MudDrawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool _loading = false;
    private bool _prevOpen = false;
    private List<LlmGenerationLog> _llmHistoryLogs = new List<LlmGenerationLog>();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_prevOpen)
        {
            _prevOpen = true;
            await FetchDataAsync();
        }
        else if (!IsOpen && _prevOpen)
        {
            _prevOpen = false;
        }
    }

    private async Task FetchDataAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var user = await GamificationService.GetCurrentUserAsync();
            if (user != null)
            {
                _llmHistoryLogs = await PracticeService.GetLlmGenerationLogsAsync(user.Id);
            }
        }
        catch
        {
            _llmHistoryLogs = new List<LlmGenerationLog>();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        _prevOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
